@import "art.wxss";

/* ==================================================================
 * 璀璨宝石 · 皇家典藏版 2.5D 实体牌桌 (Renaissance Royal Edition)
 * ------------------------------------------------------------------
 * 视觉规则
 *   光源：左上暖烛主光；所有实体向右下投立体接触阴影，左上留金属与丝绒高光。
 *   视角：接近俯视，远端市场行缩小 5%，字仍保持正立；明显侧转只用于左侧牌库。
 *   材质：威尼斯帝国酒红丝绒 / 乌木镶金画框 / 雕花黄铜包角 / 珐琅镶钻筹码。
 *   层级：桌布 → 投影 → 纸叠与筹码侧壁 → 顶面 → 数字图标 → 选中轮廓 → 弹层。
 * 所有尺寸为 1080×560 逻辑舞台坐标，由 stage 等比缩放。
 * ================================================================== */

page, .viewport { width: 100%; height: 100vh; overflow: hidden; }
.viewport {
  position: relative;
  background: radial-gradient(ellipse 90% 85% at 50% 50%, #240d18 0%, #11050b 100%);
}

.stage {
  position: absolute;
  left: 50%; top: 50%;
  width: 1080px; height: 560px;
  margin-left: -540px; margin-top: -280px;
  transform-origin: center center;
  overflow: hidden;
  border-radius: 12px;
  box-shadow:
    0 24px 72px rgba(0, 0, 0, .88),
    0 0 0 1px rgba(243, 212, 139, .36),
    inset 0 0 0 1px rgba(255, 232, 178, .32);
}

/* ---------- 1. 场景：威尼斯皇家酒红丝绒桌布 + 佛罗伦萨织金星盘 ---------- */
.felt {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background:
    radial-gradient(ellipse 68% 60% at 48% 40%, rgba(186, 72, 102, .34) 0%, rgba(118, 36, 62, .16) 54%, transparent 100%),
    radial-gradient(ellipse 95% 90% at 50% 48%, #5e1f35 0%, #441527 46%, #2a0c19 80%, #17060e 100%);
}
/* 丝绒经纬与暗花织纹：细腻提供宫廷织物触感 */
.felt-grain {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background:
    repeating-linear-gradient(45deg, rgba(255, 234, 198, .016) 0px, rgba(255, 234, 198, .016) 1px, transparent 1px, transparent 6px),
    repeating-linear-gradient(-45deg, rgba(16, 4, 12, .055) 0px, rgba(16, 4, 12, .055) 1px, transparent 1px, transparent 6px),
    repeating-linear-gradient(0deg, rgba(255, 240, 210, .009) 0px, rgba(255, 240, 210, .009) 1px, transparent 1px, transparent 3px);
}
/* 柔和烛光顶灯：聚光于中央市场与宝石区 */
.felt-light {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background:
    radial-gradient(ellipse 56% 52% at 44% 34%, rgba(255, 222, 168, .13) 0%, transparent 72%),
    radial-gradient(ellipse 40% 36% at 78% 28%, rgba(255, 214, 148, .06) 0%, transparent 70%);
}
/* 四周暗角与内嵌金线画框，把视线收进牌桌中央 */
.felt-vignette {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background: radial-gradient(ellipse 92% 96% at 50% 48%, transparent 48%, rgba(16, 5, 12, .72) 100%);
  box-shadow:
    inset 0 0 90px rgba(10, 3, 8, .58),
    inset 0 0 0 14px rgba(24, 9, 16, .25);
}
.felt-vignette::after {
  content: '';
  position: absolute; left: 14px; top: 14px; right: 14px; bottom: 14px;
  border: 1px solid rgba(243, 212, 139, .18);
  border-radius: 6px;
  box-shadow: inset 0 0 0 2px rgba(20, 7, 14, .45), inset 0 0 0 3px rgba(243, 212, 139, .07);
  pointer-events: none;
}
.table-emblem {
  position: absolute;
  left: 50%; top: 46%;
  width: 480px; height: 480px;
  margin-left: -240px; margin-top: -240px;
  background-size: 100% 100%; background-repeat: no-repeat;
  opacity: .08;
  transform: perspective(460px) rotateX(48deg) scale(1.18);
  filter: drop-shadow(0 2px 8px rgba(0, 0, 0, .5));
}
/* 实体红木镶金边梁：三层高光倒角 + 内嵌金线 */
.wood-edge { position: absolute; z-index: 2; pointer-events: none; }
.wood-top, .wood-bottom { left: 0; right: 0; height: 11px; }
.wood-top {
  top: 0;
  background: linear-gradient(180deg, #9c6a3e 0%, #633928 42%, #361b18 82%, #b88946 100%);
  box-shadow: inset 0 1px 0 rgba(255, 236, 190, .52), 0 4px 12px rgba(0, 0, 0, .68);
}
.wood-bottom {
  bottom: 0;
  background: linear-gradient(0deg, #9c6a3e 0%, #633928 42%, #361b18 82%, #b88946 100%);
  box-shadow: inset 0 -1px 0 rgba(255, 236, 190, .36), 0 -4px 12px rgba(0, 0, 0, .62);
}
.wood-left, .wood-right { top: 0; bottom: 0; width: 11px; }
.wood-left {
  left: 0;
  background: linear-gradient(90deg, #8c5c36 0%, #522e22 52%, #2b1514 84%, #b88946 100%);
  box-shadow: 4px 0 12px rgba(0, 0, 0, .62);
}
.wood-right {
  right: 0;
  background: linear-gradient(270deg, #8c5c36 0%, #522e22 52%, #2b1514 84%, #b88946 100%);
  box-shadow: -4px 0 12px rgba(0, 0, 0, .62);
}
/* 四角雕花黄铜包角（由 art.wxss 提供红宝石黄铜矢量纹章） */
.corner {
  position: absolute; width: 34px; height: 34px; z-index: 3; opacity: .92;
  background-size: 100% 100%; background-repeat: no-repeat;
  filter: drop-shadow(0 2px 5px rgba(0, 0, 0, .65));
  pointer-events: none;
}
.corner-tl { left: 8px; top: 8px; }
.corner-tr { right: 8px; top: 8px; transform: scaleX(-1); }
.corner-bl { left: 8px; bottom: 8px; transform: scaleY(-1); }
.corner-br { right: 8px; bottom: 8px; transform: scale(-1, -1); }

/* ---------- 2. 通用材质原语 ---------- */
.gem-icon { background-size: 100% 100%; background-repeat: no-repeat; background-position: center; }
.coin-face { background-size: 100% 100%; background-repeat: no-repeat; background-position: center; }

/* ---------- 3. 顶部：对手铭牌条 / 皇家回合横幅 / 右上金库与入口 ---------- */
.top-bar {
  position: absolute; left: 0; top: 0; width: 1080px; height: 72px;
  z-index: 8; pointer-events: none;
}
.top-bar > view { pointer-events: auto; }
.rival-badge {
  position: absolute; left: 18px; top: 8px;
  width: 208px; height: 58px;
  display: flex; align-items: center; gap: 7px;
  padding: 4px 8px;
  background-size: 100% 100%; background-repeat: no-repeat;
  box-shadow: 0 6px 14px rgba(0, 0, 0, .6);
}
.rival-avatar {
  width: 42px; height: 46px; flex-shrink: 0;
  border: 2px solid #c5954a; border-radius: 3px;
  background-size: cover; background-position: center 22%;
  filter: brightness(1.08) saturate(1.04);
  box-shadow: inset 0 0 0 1px rgba(255, 240, 200, .35), 0 2px 6px rgba(0, 0, 0, .6);
}
.rival-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
.rival-head { display: flex; align-items: baseline; justify-content: space-between; }
.rival-name { font-size: 13px; font-weight: 700; color: #fff1d5; letter-spacing: 1px; }
.rival-score { font-size: 10px; color: #e8c489; }
.mini-tokens { display: flex; gap: 3px; }
.mini-token {
  position: relative; width: 17px; height: 17px; border-radius: 50%;
  border: 1px solid rgba(243, 212, 139, .6);
  display: flex; align-items: center; justify-content: center;
  background-color: #24141f;
  box-shadow: inset 0 1px 2px rgba(255, 255, 255, .18);
}
.mini-token text {
  position: relative; z-index: 1;
  font-family: Georgia, serif; font-size: 10px; font-weight: 700; color: #fff1d5;
  text-shadow: 0 1px 2px #000;
}
.mini-token.is-zero { opacity: .35; }
.rival-extra { display: flex; flex-direction: column; gap: 2px; font-size: 9px; color: #d8b596; }

/* 皇家回合铭牌：中央悬浮鎏金横幅 */
.turn-banner {
  position: absolute; left: 366px; top: 8px; width: 348px;
  padding: 5px 18px 8px;
  border-radius: 22px;
  border: 1px solid rgba(243, 212, 139, .38);
  background:
    radial-gradient(ellipse 80% 90% at 50% 15%, rgba(128, 62, 86, .48), rgba(26, 10, 19, .78) 85%);
  box-shadow:
    inset 0 1px 0 rgba(255, 242, 204, .28),
    inset 0 -2px 6px rgba(0, 0, 0, .55),
    0 6px 18px rgba(0, 0, 0, .58);
  display: flex; flex-direction: column; align-items: center; gap: 2px;
}
.turn-main {
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", Georgia, serif;
  font-size: 23px; font-weight: 700; letter-spacing: 5px; line-height: 1.15;
  color: #ffebb8;
  text-shadow: 0 2px 8px rgba(0, 0, 0, .92), 0 0 16px rgba(243, 198, 108, .32);
  animation: turnBreath 3.2s ease-in-out infinite;
}
.turn-sub {
  font-size: 10px; color: #edd0a8; letter-spacing: .6px;
  text-shadow: 0 1px 3px rgba(0, 0, 0, .85);
}
.turn-sub.is-net { color: #ffc470; font-weight: 700; letter-spacing: 1px; }
.turn-banner::after {
  content: ''; position: absolute; left: 16px; right: 16px; bottom: -8px; height: 11px;
  background-size: 100% 100%; background-repeat: no-repeat; opacity: .9;
}

.top-right {
  position: absolute; right: 18px; top: 10px;
  display: flex; align-items: center; gap: 8px;
  padding: 4px 10px 4px 8px;
  border-radius: 26px;
  border: 1px solid rgba(232, 188, 106, .36);
  background: linear-gradient(160deg, rgba(64, 32, 46, .78), rgba(22, 10, 18, .86));
  box-shadow: inset 0 1px 0 rgba(255, 240, 200, .2), 0 6px 16px rgba(0, 0, 0, .55);
}
.gold-box {
  display: flex; align-items: center; gap: 6px;
  padding-right: 7px;
  border-right: 1px solid rgba(243, 212, 139, .24);
}
.gold-coin {
  position: relative; width: 34px; height: 34px; border-radius: 50%;
  box-shadow: 0 2px 0 #8f6f33, 0 4px 0 #5a3d1f, 0 6px 10px rgba(0, 0, 0, .65);
}
.pile-gem { position: absolute; left: 50%; top: 50%; width: 22px; height: 22px; margin-left: -11px; margin-top: -11px; }
.gold-label {
  font-family: "Songti SC", Georgia, serif;
  font-size: 11px; font-weight: 700; color: #ffe6ae; letter-spacing: .5px;
  text-shadow: 0 1px 3px rgba(0, 0, 0, .85);
}
.round-btn {
  width: 31px; height: 31px; border-radius: 50%;
  border: 1px solid #d9ab5c;
  background: radial-gradient(circle at 34% 26%, #734558 0%, #3d202e 58%, #1e0f18 100%);
  box-shadow:
    inset 0 1px 0 rgba(255, 244, 212, .42),
    inset 0 -2px 4px rgba(0, 0, 0, .68),
    0 3px 8px rgba(0, 0, 0, .62);
  display: flex; align-items: center; justify-content: center;
  font-family: Georgia, serif; font-size: 16px; font-weight: 700; color: #ffebb8;
  text-shadow: 0 1px 3px rgba(0, 0, 0, .85);
}
.round-btn:active { transform: translateY(1px); }

/* ---------- 4. 左侧牌库：沿 2.5D 牌桌左缘斜铺的厚牌叠（参考图1） ---------- */
.left-rail { position: absolute; left: 138px; top: 82px; width: 102px; height: 348px; z-index: 4; }
.rail-shadow {
  position: absolute; left: -6px; top: -4px; width: 112px; height: 356px;
  border-radius: 50%;
  background: radial-gradient(ellipse 60% 56% at 50% 50%, rgba(10, 3, 8, .55), transparent 78%);
  transform: rotate(10deg);
  pointer-events: none;
}
.deck-slot { position: absolute; left: 0; width: 88px; height: 112px; }
/* 沿 2.5D 透视左缘（/）自上而下向左下方阶梯展开，与参考图1一致 */
.deck-lv-2 { top: 4px; left: 32px; }
.deck-lv-1 { top: 114px; left: 16px; }
.deck-lv-0 { top: 226px; left: 0px; }
.deck-stack {
  position: absolute; left: 14px; top: 4px;
  width: 58px; height: 102px;
  border-radius: 4px;
  transform: perspective(340px) rotateX(24deg) skewX(-11.5deg) rotateZ(2.5deg) scale(0.76, 0.88);
  transform-origin: 50% 55%;
  transition: transform 180ms cubic-bezier(.2, .8, .3, 1), box-shadow 180ms;
  box-shadow:
    -8px 12px 18px rgba(6, 2, 6, .88),
    0 3px 0 #ebd5ad,
    0 5px 0 #9c7848,
    inset 0 0 0 1.5px rgba(255, 238, 188, .85);
}
.deck-slot.deck-hover .deck-stack {
  transform: perspective(340px) rotateX(20deg) skewX(-9deg) rotateZ(2deg) scale(0.80, 0.91) translateY(-4px);
}
.deck-face {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  border-radius: 3px;
  background-size: 100% 100%; background-repeat: no-repeat;
}
/* 左侧可见的厚重象牙白纸叠侧壁（参考图1左侧牌库立面） */
.deck-edges {
  position: absolute; left: -12px; top: 2px; width: 12px; height: 99px;
  z-index: 3;
  transform: skewY(12deg);
  background: linear-gradient(90deg, #fffdf8 0%, #f7ebd2 55%, #cfb286 100%);
  border-left: 1px solid #a68456;
  box-shadow: -4px 6px 10px rgba(6, 2, 6, .8);
}
.deck-stack::after {
  content: ''; position: absolute; left: -10px; right: 1px; bottom: -6px; height: 6px;
  background: linear-gradient(180deg, #fbf0d9, #b89564);
  transform: skewX(32deg);
  box-shadow: 0 5px 10px rgba(6, 2, 6, .8);
}
.deck-sheen {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  border-radius: 3px;
  background: linear-gradient(118deg, rgba(255, 255, 255, .34) 0%, rgba(255, 255, 255, .08) 28%, transparent 52%, rgba(0, 0, 0, .4) 100%);
}
.deck-crest {
  position: absolute; left: 50%; top: 43%;
  width: 34px; height: 34px; margin-left: -17px; margin-top: -17px;
  border-radius: 50%;
  border: 1.5px solid #ffe6a8;
  background: radial-gradient(circle at 34% 26%, rgba(44, 22, 34, .82), rgba(12, 5, 12, .94) 82%);
  box-shadow:
    0 0 0 2px rgba(24, 10, 18, .65),
    inset 0 1px 0 rgba(255, 245, 215, .45),
    0 3px 8px rgba(0, 0, 0, .78);
  display: flex; align-items: center; justify-content: center;
  z-index: 4;
}
.deck-label {
  font-family: Georgia, "Songti SC", serif; font-size: 16px; font-weight: 700;
  line-height: 1; color: #ffecb8; text-shadow: 0 1px 4px #000;
}
.deck-count {
  position: absolute; right: 8px; bottom: 8px;
  min-width: 22px; height: 18px; padding: 0 4px; border-radius: 9px;
  border: 1px solid #ecc478;
  background: linear-gradient(180deg, #3b1e2c, #180b13);
  box-shadow: inset 0 1px 0 rgba(255, 240, 200, .3), 0 3px 6px rgba(0, 0, 0, .72);
  display: flex; align-items: center; justify-content: center;
  font-family: Georgia, serif; font-size: 10px; font-weight: 700; color: #ffecb8;
  z-index: 5;
}
.deck-stack.is-empty { opacity: .42; }
.rail-hint {
  position: absolute; left: -10px; top: 344px; width: 108px;
  font-size: 9px; color: #d8b896; text-align: center; letter-spacing: .5px;
  text-shadow: 0 1px 3px rgba(0, 0, 0, .9);
}

/* ---------- 5. 中央市场：2.5D 单灭点扇形斜铺牌阵（参考图1：上窄下宽、四列汇聚于上方灭点） ---------- */
.board {
  position: absolute; left: 252px; top: 78px;
  width: 532px; height: 348px;
  display: flex; flex-direction: column; justify-content: space-between;
  z-index: 5;
}
.board::before { display: none; }
.card-row { position: relative; height: 112px; display: flex; justify-content: space-between; }
.row-label { display: none; }
.card-slot {
  position: relative; width: 92px; height: 112px;
  transition: transform 180ms cubic-bezier(.2, .8, .3, 1);
  animation: cardDeal 340ms cubic-bezier(.2, .8, .3, 1) both;
}
.card-slot.is-selected { transform: translateY(-8px) scale(1.05); z-index: 7; }
.card-slot.slot-hover { transform: translateY(2px) scale(.99); }

/* 典藏发展卡：参考图1的全幅油画 + 顶部半透明羊皮高光带 + 左下纵列成本圆章 + 底部立体纸厚 */
.card {
  position: relative; width: 92px; height: 112px;
  border-radius: 7px;
  border-top: 1px solid rgba(255, 252, 236, .96);
  border-left: 1px solid rgba(248, 232, 192, .88);
  border-right: 1px solid #9e7b4f;
  border-bottom: 1px solid #5e4224;
  background: #2b1822;
  overflow: hidden;
  transform-origin: 50% 50%;
  box-shadow:
    0 2px 0 #ebd4a8,
    0 4px 0 #a8824e,
    0 6px 0 #593e1e,
    0 12px 18px rgba(6, 2, 6, .88),
    5px 16px 22px rgba(0, 0, 0, .65),
    inset 0 0 0 1px rgba(255, 248, 225, .48);
  transition: box-shadow 180ms ease, border-color 180ms ease, transform 180ms ease;
}
/* 可购买：参考图1的青蓝/暖金高光外轮廓 + 立体纸厚 */
.card.is-affordable {
  border-color: #ffe49e;
  box-shadow:
    0 0 0 1.5px rgba(255, 222, 138, .92),
    0 0 14px rgba(255, 204, 96, .42),
    0 1.5px 0 #ebd4a8,
    0 3px 0 #b8925a,
    0 4.5px 0 #6e502a,
    0 11px 18px rgba(8, 2, 7, .86);
}
/* 选中：璀璨青蓝宝石光环 + 抬升悬浮感 */
.card-slot.is-selected .card {
  border-color: #6fe3ff;
  box-shadow:
    0 0 0 2px #6fe3ff,
    0 0 20px rgba(111, 227, 255, .65),
    0 4px 0 #b8925a,
    0 7px 0 #6e502a,
    8px 18px 26px rgba(8, 2, 7, .86);
}
/* 全幅油画铺满整张卡面（参考图1） */
.card-art {
  position: absolute; left: 0; right: 0; top: 0; bottom: 0; height: 100%;
  overflow: hidden;
}
.card-photo {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background-size: cover; background-position: 48% center; background-repeat: no-repeat;
  background-color: #4a3340;
  filter: brightness(1.08) saturate(1.12) contrast(1.04);
}
/* 顶部半透明亮带承托声望与红利宝石，底部柔暗承托卡名（参考图1） */
.art-glaze {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background:
    linear-gradient(180deg, rgba(255, 248, 232, .68) 0%, rgba(246, 232, 204, .28) 23%, transparent 34%),
    linear-gradient(122deg, rgba(255, 248, 225, .14) 0%, transparent 44%),
    linear-gradient(0deg, rgba(14, 6, 12, .84) 0%, rgba(14, 6, 12, .22) 22%, transparent 44%);
  box-shadow: inset 0 0 0 1px rgba(243, 212, 139, .26);
}
.card-name {
  position: absolute; right: 4px; bottom: 3px; z-index: 3;
  padding: 1px 4px; border-radius: 4px;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", Georgia, serif;
  font-size: 9px; font-weight: 700; letter-spacing: .5px;
  color: #fff3d6;
  background: rgba(16, 6, 12, .52);
  text-shadow: 0 1px 2px #000;
}
/* 左上声望：参考图1的醒目白金立体衬线数字 */
.card-points {
  position: absolute; left: 6px; top: 1px; z-index: 4;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 27px; font-style: italic; font-weight: 700; line-height: 1;
  color: #fff8e4;
  text-shadow:
    0 1px 0 #7a5216,
    0 0 4px #12080e, 0 0 7px rgba(18, 8, 14, .9),
    1.5px 1.5px 2px #12080e, -1px -1px 2px #12080e,
    1px -1px 2px #12080e, -1px 1px 2px #12080e;
}
/* 右上永久红利：切面宝石徽章 */
.card-gem {
  position: absolute; right: 5px; top: 4px; z-index: 4;
  width: 23px; height: 23px; border-radius: 50%;
  border: 1.5px solid #f7dc9c;
  background-color: #1f101a;
  box-shadow:
    0 0 0 1px rgba(24, 10, 16, .85),
    inset 0 1px 2px rgba(255, 255, 255, .38),
    0 2px 6px rgba(0, 0, 0, .8);
  overflow: hidden;
}
/* 左下角纵列成本圆章（参考图1：气泡沿卡片左下侧纵向排列，直接叠在全幅插画上） */
.card-foot {
  position: absolute; left: 4px; bottom: 4px; top: auto; right: auto;
  width: 44px; height: auto; max-height: 76px; z-index: 4;
  display: flex; flex-direction: column-reverse; flex-wrap: wrap;
  align-content: flex-start; gap: 2px; padding: 0;
  background: transparent;
  border-top: none;
  box-shadow: none;
}
.cost-bubble {
  position: relative; width: 21px; height: 21px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background-color: #1f1119;
  border: 1.5px solid rgba(255, 244, 210, .95);
  box-shadow:
    0 0 0 1px rgba(14, 5, 10, .92),
    0 2px 0 rgba(14, 5, 10, .88),
    inset 0 1px 2px rgba(255, 255, 255, .55),
    0 3px 6px rgba(0, 0, 0, .78);
  overflow: hidden;
}
/* 五色成本圆章专属边框高光，强化白/蓝/绿/红/黑的边缘辨识度 */
.cost-bubble.gem-white { border-color: #556b82; box-shadow: 0 0 0 1px #ffffff, 0 2px 4px rgba(0, 0, 0, .8); }
.cost-bubble.gem-blue  { border-color: #a8e6ff; }
.cost-bubble.gem-green { border-color: #a8ffc4; }
.cost-bubble.gem-red   { border-color: #ffc2be; }
.cost-bubble.gem-black { border-color: #e6c48e; }
.cost-bubble text {
  position: relative; z-index: 2;
  font-family: Georgia, serif; font-size: 13px; font-weight: 700; line-height: 1;
  text-shadow:
    0 1px 2px #000,
    0 0 4px #000,
    1px 1px 0 #12080e, -1px -1px 0 #12080e,
    1px -1px 0 #12080e, -1px 1px 0 #12080e;
}
/* 白钻成本圆章为纯白底盘，配深海蓝黑字 + 白光描边，一眼与蓝/黑区分 */
.cost-bubble.gem-white text,
.noble-req.gem-white text,
.disc-chip.gem-white text {
  color: #142030 !important;
  text-shadow:
    0 1px 0 #ffffff,
    0 0 3px #ffffff,
    1px 1px 0 rgba(255, 255, 255, .9),
    -1px -1px 0 rgba(255, 255, 255, .9);
}
.cost-bubble.is-covered { opacity: .48; filter: saturate(.75); }
.card-empty {
  width: 92px; height: 112px; border-radius: 7px;
  border: 1px dashed rgba(243, 212, 139, .28);
  background: rgba(18, 7, 14, .32);
  box-shadow: inset 0 3px 12px rgba(0, 0, 0, .48);
}

/* ---------- 6. 右侧栏：2.5D 立体堆叠筹码柱 & 斜铺贵族画廊（参考图1） ---------- */
.right-rail { position: absolute; left: 802px; top: 82px; width: 262px; height: 350px; z-index: 5; }
.rail-title {
  display: block; height: 15px; line-height: 15px; white-space: nowrap;
  font-size: 9px; font-weight: 600; letter-spacing: .6px; color: rgba(243, 212, 139, .82);
  text-shadow: 0 1px 3px rgba(0, 0, 0, .9);
}
.pile-area { position: absolute; left: 0; top: 0; width: 102px; height: 350px; }
.pile-area::before { display: none; }
.pile-list { position: absolute; left: 0; top: 18px; width: 102px; height: 328px; }
.pile-item {
  position: absolute; width: 82px; height: 52px;
  display: flex; align-items: center;
  transition: transform 220ms cubic-bezier(.2, .8, .3, 1);
}
/* 沿右侧 2.5D 透视斜线（\）自上而下向右下方延伸，远小近大（参考图1） */
.pile-slot-5 { left: -4px; top: 0px;   transform: scale(.91); }
.pile-slot-3 { left: 3px;  top: 54px;  transform: scale(.94); }
.pile-slot-1 { left: 10px; top: 108px; transform: scale(.97); }
.pile-slot-0 { left: 17px; top: 162px; transform: scale(1.00); }
.pile-slot-2 { left: 24px; top: 216px; transform: scale(1.03); }
.pile-slot-4 { left: 31px; top: 270px; transform: scale(1.06); }
/* 3D 筹码堆叠容器：顶层在 y=0，底层向下层叠出清晰的筹码柱侧面，参考图1 */
.pile-stack {
  position: relative; left: 14px; top: -4px;
  width: 48px; height: 48px;
  transition: transform 220ms cubic-bezier(.2, .8, .3, 1);
  filter: drop-shadow(3px 9px 9px rgba(6, 2, 6, .82));
}
.pile-disc {
  position: absolute; left: 0; top: 0;
  width: 46px; height: 46px; border-radius: 50%;
  box-shadow:
    0 2.2px 0 #ebd08e,
    0 3.6px 0 #4a2c10,
    inset 0 -2px 3px rgba(0, 0, 0, .35);
}
.pile-coin {
  position: absolute; left: 0; top: 0;
  width: 46px; height: 46px; border-radius: 50%;
  box-shadow:
    0 2.2px 0 #f4d896,
    0 3.8px 0 #593614,
    inset 0 1px 0 rgba(255, 252, 232, .72);
  transition: transform 220ms cubic-bezier(.2, .8, .3, 1), box-shadow 220ms;
}
/* 筹码柱侧壁按宝石本色染色（参考图1：白/蓝/绿/红/黑/金六色筹码柱侧边一目了然） */
.pile-disc.coin-white, .pile-coin.coin-white { box-shadow: 0 2.4px 0 #e6eff8, 0 3.8px 0 #5c7085; }
.pile-disc.coin-blue,  .pile-coin.coin-blue  { box-shadow: 0 2.4px 0 #268cff, 0 3.8px 0 #073578; }
.pile-disc.coin-green, .pile-coin.coin-green { box-shadow: 0 2.4px 0 #1cd45e, 0 3.8px 0 #064d20; }
.pile-disc.coin-red,   .pile-coin.coin-red   { box-shadow: 0 2.4px 0 #f52c34, 0 3.8px 0 #69070c; }
.pile-disc.coin-black, .pile-coin.coin-black { box-shadow: 0 2.4px 0 #57443d, 0 3.8px 0 #140d0b; }
.pile-disc.coin-gold,  .pile-coin.coin-gold  { box-shadow: 0 2.4px 0 #ffd24c, 0 3.8px 0 #6e4406; }
.pile-gem { width: 24px; height: 24px; margin-left: -12px; margin-top: -12px; }
/* 筹码库存数字：参考图1直接落在筹码柱左下方的绒布上，醒目白金斜体衬线字 */
.pile-count {
  position: absolute; left: -2px; bottom: -2px; z-index: 6;
  min-width: 18px; height: 18px; padding: 0 2px;
  display: flex; align-items: center; justify-content: center;
  font-family: Georgia, "Times New Roman", serif;
  font-style: italic; font-size: 16px; font-weight: 700; color: #fff6db;
  text-shadow:
    0 2px 4px #000,
    0 0 6px #000,
    1px 1px 0 #12080e, -1px -1px 0 #12080e;
}
.pile-name { display: none; }
.pile-tip { display: none; }
.pile-item.is-selected .pile-stack { transform: translateY(-6px) scale(1.06); }
.pile-item.is-selected .pile-coin {
  box-shadow:
    0 0 0 2px #7ce2f7,
    0 0 18px rgba(124, 226, 247, .65),
    0 3px 0 #b8843e,
    0 6px 0 #6e481c,
    7px 16px 22px rgba(6, 2, 6, .85);
}
.pile-item.pile-hover .pile-stack { transform: translateY(2px); }
.pile-item.is-disabled { opacity: .38; }
.pile-item.is-gold.is-disabled { opacity: .9; }

/* ---------- 7. 贵族肖像画廊：2.5D 斜铺 + 左侧纵列红利需求（参考图1） ---------- */
.noble-area { position: absolute; left: 122px; top: 0; width: 112px; height: 350px; }
.noble-area::before { display: none; }
.noble-row { position: absolute; left: 4px; top: 18px; display: flex; flex-direction: column; gap: 6px; }
.noble {
  position: relative; width: 92px; height: 100px;
  border-radius: 6px;
  border: 1.5px solid #e2b668;
  background: linear-gradient(165deg, #472435 0%, #24111c 68%, #160911 100%);
  transform-origin: 50% 50%;
  box-shadow:
    0 2.5px 0 #c99c52,
    0 5px 0 #5e3d16,
    6px 12px 18px rgba(6, 2, 6, .85),
    inset 0 0 0 1px rgba(255, 240, 200, .28);
  overflow: hidden;
  animation: nobleIn 420ms ease-out both;
}
.noble-face {
  position: absolute; left: 0; right: 0; top: 0; bottom: 0; height: 100%;
  overflow: hidden;
}
.noble-photo {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background-size: cover; background-position: 62% 22%; background-repeat: no-repeat;
  background-color: #3a2530;
  filter: brightness(1.08) saturate(1.1);
}
.noble-face::after {
  content: ''; position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background:
    linear-gradient(90deg, rgba(246, 232, 204, .75) 0%, rgba(236, 216, 180, .52) 26%, transparent 34%),
    linear-gradient(0deg, rgba(12, 5, 12, .72) 0%, transparent 36%);
}
.noble-points {
  position: absolute; right: 5px; bottom: 4px; z-index: 3;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 22px; font-style: italic; font-weight: 700; line-height: 1;
  color: #fff6db;
  text-shadow: 0 1px 0 #6e4514, 0 0 5px #000, 1px 1px 2px #000, -1px -1px 2px #000;
}
.noble-title { display: none; }
/* 左侧纵列红利需求卡标（参考图1贵族卡左侧竖排方章） */
.noble-reqs {
  position: absolute; left: 3px; bottom: 5px; z-index: 3;
  display: flex; flex-direction: column; gap: 2px;
}
.noble-req {
  position: relative; width: 17px; height: 19px; border-radius: 3px;
  background-color: #1e1018;
  border: 1px solid rgba(255, 236, 188, .88);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 1px 3px rgba(0, 0, 0, .75);
}
.noble-req text {
  position: relative; z-index: 2;
  font-family: Georgia, serif; font-size: 10px; font-weight: 700; color: #fff4d6;
  text-shadow: 0 1px 2px #000, 0 0 4px #000, 1px 1px 0 #12080e, -1px -1px 0 #12080e;
}
.noble-none { font-size: 11px; color: #d8b596; }

/* 3/4 人局 4~5 张贵族：紧凑双列 2.5D 画廊 */
.noble-area.is-compact { left: 114px; width: 148px; }
.noble-area.is-compact .noble-row {
  top: 18px; display: grid; grid-template-columns: repeat(2, 68px); gap: 6px;
  grid-auto-flow: row;
}
.noble-area.is-compact .noble { width: 68px; height: 90px; }
.noble-area.is-compact .noble-face { height: 100%; }
.noble-area.is-compact .noble-points {
  right: 4px; bottom: 3px; font-size: 18px;
}
.noble-area.is-compact .noble-reqs { left: 3px; bottom: 4px; gap: 2px; }
.noble-area.is-compact .noble-req { width: 14px; height: 15px; }
.noble-area.is-compact .noble-req text { font-size: 8px; }

/* ---------- 8. 底部玩家皇家工作台 ---------- */
.tray { position: absolute; left: 84px; top: 430px; width: 950px; height: 130px; z-index: 9; }
.tray-rim {
  position: absolute; left: 0; top: 0; width: 950px; height: 130px;
  background-size: 100% 100%; background-repeat: no-repeat;
  filter: drop-shadow(0 -4px 14px rgba(0, 0, 0, .55));
}
.tray-rim::after {
  content: ''; position: absolute; left: 8px; top: 56px; right: 8px; bottom: 4px;
  border-radius: 0 0 8px 8px;
  background:
    repeating-linear-gradient(90deg, rgba(255, 235, 200, .02) 0px, rgba(255, 235, 200, .02) 1px, transparent 1px, transparent 6px),
    repeating-linear-gradient(0deg, rgba(0, 0, 0, .1) 0px, rgba(0, 0, 0, .1) 1px, transparent 1px, transparent 4px),
    linear-gradient(105deg, transparent 18%, rgba(255, 224, 172, .06) 48%, transparent 76%);
  pointer-events: none;
}
.tray-left { position: absolute; left: 22px; top: -8px; width: 214px; height: 124px; display: flex; align-items: flex-end; gap: 12px; z-index: 3; }
/* 皇家肖像金框 */
.portrait-frame {
  position: relative; width: 78px; height: 92px; flex-shrink: 0;
  border: 3px solid #d9ab5c; border-radius: 6px;
  background: linear-gradient(150deg, #f3d48b, #8a5622);
  box-shadow:
    0 0 0 1px rgba(24, 10, 16, .85),
    inset 0 1px 0 rgba(255, 248, 220, .88),
    inset 0 -2px 0 rgba(86, 48, 16, .85),
    0 3px 0 #523012, 0 10px 22px rgba(0, 0, 0, .82);
}
.portrait {
  position: absolute; left: 2px; top: 2px; right: 2px; bottom: 2px;
  border-radius: 3px;
  border: 1px solid rgba(20, 10, 16, .72);
  background-size: cover; background-position: center 20%; background-repeat: no-repeat;
  filter: brightness(1.08) saturate(1.06);
  box-shadow: inset 0 0 12px rgba(0, 0, 0, .55);
}
.portrait-gem {
  position: absolute; right: -9px; bottom: -6px;
  width: 24px; height: 24px; transform: rotate(45deg);
  border: 2px solid #fff2c6;
  background: linear-gradient(135deg, #c2ff9e, #28a446 55%, #0a4a1e);
  box-shadow: 0 3px 9px rgba(0, 0, 0, .8), inset 0 0 6px rgba(255, 255, 255, .55);
}
.portrait-gem::after {
  content: ''; position: absolute; left: 22%; top: 18%; width: 56%; height: 44%;
  border-radius: 50%; background: rgba(255, 255, 255, .45);
}
.player-badges { display: flex; flex-direction: column; gap: 5px; margin-bottom: 5px; }
.score-disc, .vault-total {
  border-radius: 50%;
  border: 2px solid #eab862;
  background: radial-gradient(circle at 35% 25%, #6e354b 0%, #341626 62%, #140810 100%);
  box-shadow:
    0 0 0 1px rgba(20, 8, 14, .85),
    inset 0 1px 0 rgba(255, 240, 200, .42),
    0 4px 10px rgba(0, 0, 0, .75);
  display: flex; align-items: baseline; justify-content: center;
}
.score-disc { width: 48px; height: 48px; padding-top: 10px; }
.score-num {
  font-family: Georgia, serif; font-size: 22px; font-weight: 700; color: #ffebb8; line-height: 1;
  text-shadow: 0 2px 4px rgba(0, 0, 0, .9);
}
.score-den { font-size: 9px; color: #dfb888; font-weight: 600; }
.tray-reserved {
  width: 48px; padding: 3px 0; border-radius: 7px;
  border: 1px solid rgba(240, 200, 126, .68);
  background: linear-gradient(180deg, rgba(66, 33, 48, .9), rgba(22, 10, 18, .92));
  box-shadow: inset 0 1px 0 rgba(255, 240, 200, .25), 0 3px 7px rgba(0, 0, 0, .65);
  display: flex; flex-direction: column; align-items: center;
}
.tray-reserved-num { font-family: Georgia, serif; font-size: 16px; font-weight: 700; color: #ffebb8; line-height: 1.1; }
.tray-reserved-label { font-size: 8px; color: #e2be96; letter-spacing: .4px; }

.tray-vault { position: absolute; left: 294px; top: 15px; width: 432px; height: 102px; z-index: 3; }
.vault-total { position: absolute; left: -52px; top: 36px; width: 44px; height: 44px; padding-top: 9px; }
.vault-total-num { font-family: Georgia, serif; font-size: 19px; font-weight: 700; color: #ffebb8; line-height: 1; }
.vault-total-den { font-size: 9px; color: #dfb888; }
.vault-groups { display: flex; flex-direction: column; gap: 8px; }
.vault-group { display: flex; align-items: center; gap: 8px; }
.vault-label {
  width: 52px; flex-shrink: 0; font-size: 9px; font-weight: 600;
  color: #ecc89a; letter-spacing: .6px; text-align: right;
  text-shadow: 0 1px 2px #000;
}
.vault-row { display: flex; gap: 6px; align-items: center; min-height: 26px; }
/* 永久红利：微型宝石铭牌 */
.disc-chip {
  position: relative; width: 22px; height: 26px; border-radius: 4px;
  background-color: #1e1018;
  border: 1px solid rgba(255, 230, 172, .78);
  display: flex; align-items: center; justify-content: center;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .32), 0 2px 5px rgba(0, 0, 0, .68);
}
.disc-chip text {
  position: relative; z-index: 2;
  font-family: Georgia, serif; font-size: 12px; font-weight: 700; color: #fff4d6;
  text-shadow: 0 1px 2px #000, 0 0 4px #000, 1px 1px 0 #12080e, -1px -1px 0 #12080e;
}
.disc-empty {
  font-size: 10px; color: #bfa09a; letter-spacing: .4px;
  padding: 3px 10px; border-radius: 12px;
  border: 1px dashed rgba(243, 212, 139, .24);
  background: rgba(18, 8, 14, .45);
}
/* 持有筹码：镶金天鹅绒宝石槽 + 槽内 3D 堆叠筹码（参考图1） */
.vault-token {
  position: relative; width: 48px; height: 37px; border-radius: 8px;
  border: 1px solid rgba(243, 212, 139, .48);
  background: linear-gradient(180deg, rgba(82, 46, 64, .96) 0%, rgba(28, 13, 23, .98) 65%, rgba(14, 6, 12, .99) 100%);
  box-shadow:
    inset 0 1px 0 rgba(255, 242, 205, .28),
    inset 0 -6px 10px rgba(0, 0, 0, .75),
    0 3px 7px rgba(0, 0, 0, .68);
  overflow: hidden;
  transition: transform 120ms ease, border-color 120ms ease;
}
.vault-token::after {
  content: ''; position: absolute; left: 10%; top: 5%; width: 66%; height: 32%;
  border-radius: 50%; background: linear-gradient(180deg, rgba(255, 255, 255, .16), transparent);
}
.vault-stack {
  position: absolute; left: 3px; top: 8px; width: 22px; height: 22px;
}
.vault-disc {
  position: absolute; left: 0; top: 0; width: 22px; height: 22px; border-radius: 50%;
  box-shadow: 0 1.5px 0 #8a6030, 0 3px 4px rgba(0, 0, 0, .7);
}
.vault-token-icon {
  position: absolute; left: 4px; top: 4px; width: 14px; height: 14px; z-index: 2; opacity: .98;
}
.vault-token-num {
  position: absolute; right: 5px; top: 7px; z-index: 3;
  font-family: Georgia, serif; font-style: italic; font-size: 20px; font-weight: 700; line-height: 1;
  color: #fff4d6; text-shadow: 0 2px 4px #000, 0 0 8px rgba(255, 235, 190, .24);
}
.vault-token.is-zero { opacity: .42; }
.vault-token.can-discard { border: 2px solid #ff9a6a; animation: vaultPulse 1.2s infinite; }
.vault-token.vault-hover { transform: translateY(2px); }

.tray-right { position: absolute; right: 14px; top: 54px; width: 222px; height: 70px; display: flex; flex-direction: column; gap: 6px; z-index: 3; }
.hint {
  height: 16px; line-height: 16px; font-size: 10px; color: #f0d2a8;
  text-align: right;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  text-shadow: 0 1px 3px #000;
}
.hint-warn { color: #ffba82; font-weight: 700; }
.btn-row { display: flex; gap: 6px; justify-content: flex-end; }
.btn {
  padding: 6px 11px; border-radius: 7px; font-size: 11px; font-weight: 600; letter-spacing: .5px;
  border: 1px solid #d6a656;
  background: linear-gradient(180deg, #683b4e 0%, #381c29 62%, #210f18 100%);
  color: #ffecd0;
  box-shadow:
    inset 0 1px 0 rgba(255, 244, 214, .34),
    inset 0 -2px 0 rgba(0, 0, 0, .58),
    0 4px 9px rgba(0, 0, 0, .62);
  transition: transform 100ms ease, box-shadow 100ms ease;
}
.btn:active { transform: translateY(2px); box-shadow: inset 0 1px 0 rgba(255, 240, 205, .2); }
.btn-primary {
  border-color: #fff0be;
  background: linear-gradient(180deg, #ffeaad 0%, #eab658 42%, #be8124 85%, #8c5910 100%);
  color: #2b1504;
  font-weight: 700;
  text-shadow: 0 1px 0 rgba(255, 250, 230, .45);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, .78),
    inset 0 -2px 0 rgba(92, 52, 8, .55),
    0 4px 12px rgba(0, 0, 0, .62),
    0 0 14px rgba(234, 182, 88, .22);
}
.btn-off { opacity: .48; filter: saturate(.75); }

/* ---------- 9. 弹层：文艺复兴鎏金宝匣 ---------- */
.overlay {
  position: absolute; left: 0; top: 0; width: 1080px; height: 560px;
  background: radial-gradient(ellipse 80% 80% at 50% 50%, rgba(18, 6, 14, .74), rgba(6, 2, 6, .88));
  display: flex; align-items: center; justify-content: center;
  z-index: 20;
  animation: fadeIn 160ms ease-out both;
}
.overlay-top { z-index: 30; }
.dialog {
  position: relative;
  border: 1.5px solid #deb062;
  border-radius: 14px;
  background:
    radial-gradient(ellipse 75% 50% at 50% 0%, rgba(255, 218, 152, .12), transparent 70%),
    repeating-linear-gradient(45deg, rgba(255, 230, 200, .014) 0px, rgba(255, 230, 200, .014) 1px, transparent 1px, transparent 6px),
    linear-gradient(162deg, #54283c 0%, #2d1422 58%, #180a13 100%);
  box-shadow:
    0 0 0 1px rgba(18, 6, 13, .9),
    inset 0 0 0 3px rgba(16, 6, 12, .55),
    inset 0 0 0 4px rgba(243, 212, 139, .24),
    inset 0 1px 0 rgba(255, 245, 215, .38),
    0 26px 76px rgba(0, 0, 0, .88);
  padding: 20px 24px;
  animation: dialogIn 180ms cubic-bezier(.2, .8, .3, 1) both;
}
.dialog-head {
  display: flex; flex-direction: column; gap: 5px;
  margin-bottom: 14px; padding-bottom: 11px;
  border-bottom: 1px solid rgba(243, 212, 139, .38);
  box-shadow: 0 1px 0 rgba(0, 0, 0, .45);
}
.dialog-title {
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", Georgia, serif;
  font-size: 24px; font-weight: 700; color: #ffebb8; letter-spacing: 2px;
  text-shadow: 0 2px 8px rgba(0, 0, 0, .85);
}
.dialog-sub { font-size: 12px; color: #e2be9a; }
.dialog-btns { display: flex; gap: 10px; justify-content: flex-end; margin-top: 16px; }

.detail-dialog { width: 700px; }
.detail-body { display: flex; gap: 22px; align-items: flex-start; }
.card-big {
  width: 150px; height: 204px; flex-shrink: 0; transform: scale(1.02);
  border-color: #7ce2f7;
  box-shadow: 0 0 0 2px #7ce2f7, 0 0 18px rgba(124, 226, 247, .42),
    0 4px 0 #6f543a, 9px 18px 26px rgba(12, 5, 12, .78);
}
.card-big .card-art { height: 100%; }
.card-big .card-foot { left: 7px; bottom: 8px; width: 66px; max-height: 132px; gap: 4px; }
.card-big .card-name { font-size: 13px; right: 6px; bottom: 6px; padding: 2px 7px; }
.card-big .card-points { font-size: 40px; left: 8px; top: 2px; }
.card-big .card-gem { width: 32px; height: 32px; right: 8px; top: 6px; }
.card-big .cost-bubble { width: 28px; height: 28px; }
.card-big .cost-bubble text { font-size: 16px; }
.detail-info { flex: 1; display: flex; flex-direction: column; gap: 9px; }
