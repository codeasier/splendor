.guild-brand-subtitle { font-family: "Songti SC", "STSong", serif; font-size: 13px; letter-spacing: 2px; color: #d8d5c5; }
.guild-online {
  height: 28px; margin-left: 20px; padding: 0 10px; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center; gap: 5px;
