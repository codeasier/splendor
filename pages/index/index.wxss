.guild-mode-check text { margin-top: -1px; font-size: 20px; font-weight: 700; line-height: 1; color: #1b3f2c; }
.guild-mode-copy {
  flex: 1; min-height: 0; padding: 12px 12px 13px;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.guild-mode-name {
  font-family: "Songti SC", "STSong", serif; font-size: 24px; font-weight: 700;
  line-height: 1.1; letter-spacing: 1px; color: #faf2df;
}
.guild-mode-ornament { display: flex; align-items: center; justify-content: center; gap: 6px; width: 100%; margin: 7px 0 6px; }
.guild-mode-ornament text { font-size: 9px; line-height: 1; color: #d5b16d; }
.guild-mode-line { width: 44px; height: 1px; background: linear-gradient(90deg, transparent, rgba(211, 177, 111, .72)); }
.guild-mode-ornament .guild-mode-line:last-child { background: linear-gradient(90deg, rgba(211, 177, 111, .72), transparent); }
.guild-mode-tagline { font-size: 10px; line-height: 1.2; color: #c8c4b1; }

.guild-panel {
  position: absolute; right: max(16px, env(safe-area-inset-right)); width: 364px; height: 388px; padding: 18px 20px;
  box-sizing: border-box; display: flex; flex-direction: column;
  border: 1px solid rgba(171, 195, 180, .34); border-radius: 18px;
  background: linear-gradient(160deg, rgba(12, 37, 26, .98), rgba(7, 23, 17, .99));
  box-shadow: 0 16px 38px rgba(2, 10, 7, .28), inset 0 1px 0 rgba(239, 245, 233, .06);
  animation: guildEnter 380ms 70ms ease-out both;
}
.guild-panel-head { display: flex; align-items: center; gap: 12px; }
.guild-detail-crest {
  width: 54px; height: 54px; flex-shrink: 0; display: flex; align-items: center; justify-content: center;
  border: 1px solid rgba(207, 176, 111, .66); border-radius: 50%;
  background: radial-gradient(circle at 50% 38%, rgba(64, 99, 78, .9), rgba(8, 26, 18, .96) 72%);
  box-shadow: inset 0 0 0 3px rgba(5, 19, 13, .7), 0 3px 9px rgba(2, 12, 7, .28);
}
.guild-detail-crest-inner { width: 42px; height: 36px; filter: drop-shadow(0 2px 3px rgba(2, 9, 6, .55)); }
.guild-panel-heading { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.guild-panel-overline { font-size: 8px; letter-spacing: 2.4px; color: #b2ad97; }
.guild-panel-title {
  font-family: "Songti SC", "STSong", serif; font-size: 28px; font-weight: 700;
  line-height: 1.05; letter-spacing: 1px; color: #f8f1de;
}
.guild-detail-rule { display: flex; align-items: center; gap: 8px; margin: 10px 0 8px; }
.guild-detail-rule text { font-size: 9px; line-height: 1; color: #d0ad6c; }
.guild-detail-line { flex: 1; height: 1px; background: linear-gradient(90deg, transparent, rgba(180, 196, 178, .3), transparent); }
.guild-panel-subtitle { min-height: 26px; font-size: 9.5px; line-height: 1.35; color: #aeb9ab; }
.guild-config-row { display: flex; align-items: center; gap: 12px; margin-top: 11px; }
.guild-config-label { flex-shrink: 0; font-size: 11px; letter-spacing: .5px; color: #d5d1bd; }
/* 声音开关：与既有配置行同高，两枚并排。开/关只靠描边与亮度区分，
   不用颜色（这套界面整体是低饱和古金，突然冒出一个绿色按钮会很跳）。 */
.sound-switches { flex: 1; min-width: 0; display: flex; gap: 8px; }
.sound-switch {
  flex: 1; height: 44px; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center; gap: 6px;
  border-radius: 9px; background: rgba(5, 20, 13, .42);
  transition: border-color 120ms ease, opacity 120ms ease;
}
.sound-switch.is-on { border: 1px solid rgba(243, 212, 139, .62); }
.sound-switch.is-off { border: 1px solid rgba(190, 203, 191, .18); opacity: .52; }
.sound-switch-hover { opacity: .78; }
.sound-switch-icon { font-size: 14px; line-height: 1; }
.sound-switch-label { font-size: 11px; letter-spacing: .5px; color: #e0c69e; }
.sound-switch.is-off .sound-switch-label { color: #8a8578; }
.guild-count-pick {
  flex: 1; min-width: 0; height: 44px; padding: 3px; box-sizing: border-box;
  display: flex; align-items: stretch; gap: 3px;
  border: 1px solid rgba(190, 203, 191, .28); border-radius: 9px; background: rgba(5, 20, 13, .42);
}
.guild-count-option {
  flex: 1; min-width: 0; border-radius: 6px; display: flex; align-items: center; justify-content: center;
  font-size: 11px; color: #c8cdc0;
}
.guild-count-option.is-active {
  color: #14301f; font-weight: 700;
  background: linear-gradient(180deg, #d9f1df, #b7dec7);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .56);
}
.guild-quick {
  height: 82px; margin-top: 18px; padding: 12px 14px 12px 20px; box-sizing: border-box;
  display: flex; align-items: center; justify-content: space-between; flex-shrink: 0;
  border: 1px solid rgba(237, 246, 238, .56); border-radius: 11px;
  background: linear-gradient(135deg, #d8efdc, #b9dac4);
  box-shadow: 0 7px 18px rgba(3, 13, 10, .22), inset 0 1px 0 rgba(255, 255, 255, .62);
  transition: transform 120ms ease, box-shadow 120ms ease;
}
.guild-quick-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; min-width: 0; }
.guild-quick-title {
  font-family: "Songti SC", "STSong", serif; font-size: 24px; font-weight: 700;
  line-height: 1; letter-spacing: .5px; color: #0d2b1b;
}
.guild-quick-sub { font-size: 8.5px; line-height: 1; letter-spacing: .2px; color: #3b5f48; white-space: nowrap; }
.guild-quick-arrow {
  width: 40px; height: 40px; flex-shrink: 0; border-radius: 50%; display: flex; align-items: center; justify-content: center;
  background: #193b28; color: #e7f0e7; box-shadow: 0 3px 8px rgba(20, 49, 36, .2);
}
.guild-quick-arrow text { margin-top: -2px; font-size: 23px; font-weight: 400; line-height: 1; }
.guild-quick-pressed { transform: scale(.985); box-shadow: 0 3px 9px rgba(3, 13, 10, .2); }
.guild-room-actions { display: flex; gap: 10px; margin-top: 10px; }
.guild-action {
  flex: 1; min-width: 0; height: 58px; padding: 0 10px; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center; gap: 8px;
  border: 1px solid rgba(198, 209, 197, .29); border-radius: 10px;
  background: rgba(20, 45, 31, .54);
  transition: transform 120ms ease, background-color 120ms ease;
}
.guild-action .guild-icon { width: 23px; height: 23px; opacity: .9; }
.guild-action text { font-size: 12px; font-weight: 550; line-height: 1.2; color: #e4e5d8; white-space: nowrap; }
.guild-action-pressed { transform: translateY(1px); background: rgba(119, 196, 163, .12); }
.guild-icon { width: 28px; height: 28px; flex-shrink: 0; background-size: 100% 100%; background-repeat: no-repeat; }

.guild-nav {
  position: absolute; left: max(16px, env(safe-area-inset-left)); right: max(16px, env(safe-area-inset-right));
  bottom: calc(12px + env(safe-area-inset-bottom)); height: 74px; padding: 5px 8px; box-sizing: border-box;
  display: flex; align-items: center; border: 1px solid rgba(168, 190, 175, .28); border-radius: 16px;
  background: linear-gradient(180deg, rgba(10, 30, 21, .97), rgba(6, 20, 14, .98));
  box-shadow: 0 -8px 28px rgba(4, 12, 10, .18), inset 0 1px 0 rgba(238, 245, 235, .04);
}
.guild-nav-item {
  position: relative; flex: 1; min-width: 0; height: 64px; border-radius: 11px;
  display: flex; align-items: center; justify-content: center; gap: 9px;
  transition: background-color 120ms ease, transform 120ms ease;
}
.guild-nav-item + .guild-nav-item::before {
  content: ''; position: absolute; left: -4px; top: 14px; bottom: 14px; width: 1px;
  background: rgba(188, 201, 187, .15);
}
.guild-nav-item .guild-icon { width: 23px; height: 23px; opacity: .9; }
.guild-nav-item text { font-family: "Songti SC", "STSong", serif; font-size: 13px; font-weight: 600; color: #e2ddc7; white-space: nowrap; }
.guild-nav-hover { background: rgba(119, 196, 163, .1); transform: translateY(1px); }
.guild-nav .guild-icon-text { color: #d6b676; text-shadow: none; }
.guild-nav .guild-nav-badge {
  right: calc(50% - 38px); top: 5px; min-width: 15px; height: 15px; padding: 0 4px;
  color: #10251b; background: #9fd3b8; border: 1px solid #c5e3d1; box-shadow: none;
  font-size: 9px;
}
.guild-notice {
  position: absolute; left: 50%; bottom: 94px; max-width: 540px; padding: 9px 16px; box-sizing: border-box;
  transform: translateX(-50%); border: 1px solid rgba(177, 213, 193, .24); border-radius: 18px;
  background: rgba(17, 38, 31, .96); color: #e1ebe3; font-size: 11px; line-height: 16px; text-align: center;
  box-shadow: 0 7px 20px rgba(3, 12, 9, .24); pointer-events: none; z-index: 4;
}
@keyframes guildEnter {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}
@media (prefers-reduced-motion: reduce) {
  .guild-modes, .guild-panel, .guild-online-dot { animation: none; }
  .guild-profile, .guild-mode-chip, .guild-quick, .guild-action, .guild-nav-item { transition: none; }
}

/* 战绩弹层 */
.records-dialog { width: 720px; }
.records-body { display: flex; flex-direction: column; gap: 10px; }
.records-summary { display: flex; gap: 8px; }
.records-cell {
  flex: 1; display: flex; flex-direction: column; align-items: center; gap: 1px;
  padding: 8px 4px; border-radius: 8px;
  border: 1px solid rgba(214, 166, 86, .34);
  background: rgba(20, 9, 16, .6);
}
.records-cell-value {
  font-family: Georgia, serif; font-size: 18px; font-weight: 700; line-height: 1.2;
  font-variant-numeric: tabular-nums;
  color: #ffebb8; text-shadow: 0 1px 4px rgba(0, 0, 0, .75);
}
.records-cell-label { font-size: 9px; color: #cfa98f; letter-spacing: 1px; }
.records-list { display: flex; flex-direction: column; gap: 5px; }
.records-row {
  display: flex; align-items: center; gap: 9px; padding: 6px 10px; border-radius: 6px;
  border: 1px solid rgba(214, 166, 86, .2);
  background: rgba(18, 8, 14, .55);
}
.records-result {
  width: 24px; height: 24px; flex-shrink: 0; border-radius: 5px;
  display: flex; align-items: center; justify-content: center;
  font-size: 11px; font-weight: 700; color: #2b1504;
  background: linear-gradient(180deg, #ffdf8e, #b47b1f);
}
.records-result.is-lose { background: linear-gradient(180deg, #8e7a6c, #4a3a30); color: #f6e6d2; }
.records-result.is-tie { background: linear-gradient(180deg, #cfd6df, #7c8794); color: #1d2126; }
.records-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.records-title { font-size: 12px; color: #f7e7d0; }
.records-sub { font-size: 9.5px; color: #b9977f; }

/* 资料弹层：账号信息 */
.profile-identity {
  display: flex; flex-direction: column; gap: 4px;
  padding: 8px 12px; border-radius: 8px;
  border: 1px dashed rgba(243, 212, 139, .34);
  background: rgba(16, 7, 12, .5);
}
.profile-id-line { display: flex; align-items: center; gap: 8px; }
.profile-id-label { font-size: 9px; color: #cfa98f; letter-spacing: 1.5px; }
.profile-id-value { font-family: Georgia, serif; font-size: 12px; letter-spacing: 1px; color: #ffe9be; }
.profile-id-tag {
  font-size: 9px; color: #261204; padding: 1px 7px; border-radius: 9px;
  background: linear-gradient(180deg, #ffeaad, #d49b3c);
}
.profile-id-since { margin-left: auto; font-size: 9px; color: #b9977f; }
.profile-id-detail { font-size: 9.5px; line-height: 1.55; color: #c9a894; }
.profile-login { display: flex; align-items: center; gap: 10px; }
.wechat-login-btn { flex-shrink: 0; margin: 0; padding: 4px 14px; line-height: 1.5; font-size: 11px; color: #fff8e9; background: #24764e; }
.wechat-login-btn[disabled] { opacity: .55; color: #d8c8b9; }
.profile-login-hint { font-size: 9px; line-height: 1.5; color: #c9a894; }
.profile-rank { font-size: 11px; font-weight: 700; color: #ffd88e; }
.profile-stats { margin-left: auto; font-size: 9.5px; color: #c9a894; }

/* 人数按钮供建房 / 人机设置弹层与房间界面共用。 */
.count-chip {
  flex: 1; min-width: 58px; padding: 7px 10px; border-radius: 6px; text-align: center;
  font-size: 12px; font-weight: 600; color: #edd4b4; white-space: nowrap;
  border: 1px solid rgba(214, 166, 86, .52);
  background: linear-gradient(180deg, #4f2b3c, #23111c);
  box-shadow: inset 0 1px 0 rgba(255, 240, 200, .2), 0 2px 5px rgba(0, 0, 0, .48);
}
.room-counts .count-chip { min-width: 50px; padding: 7px 7px; }
.count-chip.is-active {
  color: #261204; font-weight: 700; border-color: #fff0be;
  background: linear-gradient(180deg, #ffeaad 0%, #e4ae4e 55%, #b87b1e 100%);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .75), 0 0 10px rgba(243, 198, 108, .35), 0 3px 6px rgba(0, 0, 0, .55);
}
.guild-overlay { background: rgba(13, 7, 10, .72); }
.guild-dialog { width: 490px; padding: 24px 28px; border-color: #cda760; }
.guild-dialog-head { display: flex; align-items: center; justify-content: space-between; gap: 14px; }
.guild-dialog-close { position: relative; width: 32px; height: 32px; line-height: 30px; text-align: center; font-size: 27px; color: #dfc292; }
.guild-dialog-close::after { content: ''; position: absolute; left: -6px; right: -6px; top: -6px; bottom: -6px; }
.guild-config { display: flex; flex-direction: column; gap: 18px; padding: 26px 0 22px; }
.guild-config-row { display: flex; align-items: center; gap: 16px; }
.guild-config-label { flex: 0 0 64px; font-size: 13px; color: #e0c69e; }
.guild-config-options { flex: 1; min-width: 0; display: flex; gap: 8px; }
.guild-config .count-chip { min-width: 0; padding: 10px 0; }
/* 快速开始的人数选择：三张大卡，直接点即开局。
   与「对局设置」里的 count-chip 区分开——那是配置项，这是动作入口。 */
.guild-seat-pick { flex: 1; min-width: 0; display: flex; gap: 10px; }
.seat-pick {
  flex: 1 1 0; min-width: 0;
  padding: 12px 6px 10px;
  display: flex; flex-direction: column; align-items: center; gap: 2px;
  border-radius: 8px;
  border: 1px solid rgba(214, 166, 86, .55);
  background: linear-gradient(180deg, #4f2b3c, #23111c);
  box-shadow: inset 0 1px 0 rgba(255, 240, 200, .2), 0 3px 7px rgba(0, 0, 0, .5);
  transition: transform 110ms ease, box-shadow 110ms ease;
}
.seat-pick.is-active {
  border-color: #fff0be;
  background: linear-gradient(180deg, #5c3446, #2a1520);
  box-shadow: inset 0 1px 0 rgba(255, 240, 200, .3), 0 0 10px rgba(243, 198, 108, .28), 0 3px 8px rgba(0, 0, 0, .55);
}
.seat-pick:active { transform: translateY(2px); }
.seat-pick-num {
  font-family: Georgia, serif; font-size: 30px; font-weight: 700; line-height: 1;
  color: #ffe9b8; text-shadow: 0 2px 6px rgba(0, 0, 0, .9);
}
.seat-pick-label { font-size: 11px; color: #e8c8a2; line-height: 1; }
.seat-pick-desc { margin-top: 2px; font-size: 10px; color: #c9a888; line-height: 1; }
.timer-chip {
  flex: 1; min-width: 0; padding: 10px 0; border-radius: 6px; text-align: center;
  font-size: 11px; white-space: nowrap; color: #ddc7a4;
  border: 1px solid rgba(226, 190, 126, .35); background: rgba(9, 9, 13, .3);
}
.timer-chip.is-active { color: #2a1807; border-color: #f4d48d; background: linear-gradient(180deg, #ffe4a1, #c89238); }
.guild-config-note { font-size: 12px; line-height: 1.6; color: #c5a97e; }
.guild-config .guild-join-input { flex: 1; min-width: 0; width: 0; height: 43px; box-sizing: border-box; font-size: 16px; letter-spacing: 4px; }
.home-notice { font-size: 12px; line-height: 1.7; color: #ffcc99; }

/* 房间界面：皇家议事厅席位大堂（收紧纵距，确保 4 人局折行或提示出现时主按钮不溢出 560px 舞台） */
.room-screen {
  display: flex; flex-direction: column; gap: 8px;
  padding: 14px 36px 14px;
  padding-left: max(36px, env(safe-area-inset-left));
  padding-right: max(36px, env(safe-area-inset-right));
  padding-bottom: calc(14px + env(safe-area-inset-bottom));
  background:
    radial-gradient(ellipse 70% 55% at 50% 22%, rgba(255, 218, 152, .1), transparent 70%),
    linear-gradient(170deg, rgba(26, 10, 19, .54), rgba(12, 4, 10, .82));
}
.room-top {
  display: flex; align-items: center; gap: 22px;
  padding: 10px 18px; border-radius: 12px;
  border: 1px solid rgba(226, 180, 102, .48);
  background: linear-gradient(160deg, rgba(62, 28, 43, .86), rgba(24, 10, 18, .92));
  box-shadow: inset 0 1px 0 rgba(255, 242, 205, .26), 0 8px 22px rgba(0, 0, 0, .58);
}
.room-code-block {
  display: flex; flex-direction: column; gap: 2px; flex: 0 0 auto;
  padding: 4px 16px 4px 8px;
  border-right: 1px solid rgba(243, 212, 139, .26);
}
.room-code-label { font-size: 9px; font-weight: 600; letter-spacing: 3px; color: #f0ce8e; }
.room-code-big {
  font-family: Georgia, serif; font-size: 32px; font-weight: 700; letter-spacing: 6px; line-height: 1.1;
  color: #ffedc2;
  text-shadow: 0 2px 0 #6e4514, 0 4px 14px rgba(0, 0, 0, .85);
}
.room-backend { font-size: 9px; font-weight: 600; color: #a4f0bc; letter-spacing: 1px; }
.room-status-block { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
.room-status-main { font-size: 19px; font-weight: 700; letter-spacing: 1px; color: #ffebb8; text-shadow: 0 2px 6px rgba(0, 0, 0, .8); }
.room-status-sub { font-size: 11px; line-height: 1.55; color: #dcc0ae; }
.room-leave { flex: 0 0 auto; font-size: 12px; padding: 8px 16px; }

.room-seat-row { display: flex; gap: 14px; flex: 0 0 auto; height: 214px; }
.room-seat {
  position: relative;
  flex: 1; min-width: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 7px;
  padding: 16px 12px 14px; border-radius: 12px;
  border: 1.5px solid rgba(226, 180, 102, .52);
  background:
    radial-gradient(ellipse 80% 55% at 50% 12%, rgba(255, 220, 158, .12), transparent 68%),
    linear-gradient(162deg, #582b3e 0%, #2d1421 62%, #190b13 100%);
  box-shadow:
    inset 0 0 0 1px rgba(14, 5, 11, .7),
    inset 0 0 0 3px rgba(243, 212, 139, .14),
    inset 0 1px 0 rgba(255, 242, 205, .28),
    0 12px 28px rgba(0, 0, 0, .62);
}
.room-seat.is-self {
  background:
    radial-gradient(ellipse 80% 55% at 50% 12%, rgba(255, 224, 164, .18), transparent 68%),
    linear-gradient(162deg, #68344a 0%, #341827 62%, #1d0c16 100%);
}
.room-seat.is-ready {
  border-color: rgba(132, 232, 170, .78);
  box-shadow:
    inset 0 0 0 1px rgba(14, 5, 11, .65),
    inset 0 0 0 3px rgba(132, 232, 170, .18),
    inset 0 1px 0 rgba(255, 242, 205, .3),
    0 0 20px rgba(90, 204, 140, .24),
    0 12px 28px rgba(0, 0, 0, .62);
}
.room-seat.is-empty {
  border-style: dashed;
  border-color: rgba(226, 180, 102, .45);
  background: linear-gradient(162deg, rgba(56, 26, 40, .72), rgba(22, 10, 17, .82));
  opacity: .88;
}
.room-seat.is-tappable { cursor: pointer; }
.room-seat.is-tappable:active { transform: translateY(1px); }
.room-avatar {
  width: 66px; height: 66px; flex-shrink: 0; border-radius: 50%; overflow: hidden;
  display: flex; align-items: center; justify-content: center;
  border: 2.5px solid #e6b868;
  box-shadow:
    0 0 0 2px rgba(20, 8, 15, .8),
    0 0 0 3px rgba(243, 212, 139, .35),
    inset 0 0 0 1px rgba(255, 245, 215, .4),
    0 6px 16px rgba(0, 0, 0, .7);
}
.room-avatar-img { width: 100%; height: 100%; }
.room-avatar-no { font-family: Georgia, serif; font-size: 24px; font-weight: 700; color: #fff3d6; text-shadow: 0 2px 5px #1a0d14; }
.room-avatar.is-empty {
  border-style: dashed; border-color: rgba(232, 188, 106, .68);
  background: radial-gradient(circle, rgba(64, 30, 44, .65), rgba(20, 9, 16, .78)) !important;
}
.room-avatar.is-empty .room-avatar-no { font-size: 28px; color: #f0ce8e; text-shadow: 0 0 10px rgba(243, 212, 139, .35); }
.room-seat-label { font-size: 10px; font-weight: 600; letter-spacing: 2px; color: #f0ce8e; margin-top: 2px; }
.room-seat-name {
  max-width: 100%; font-size: 15px; font-weight: 700; color: #fff3d6;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  text-shadow: 0 1px 4px rgba(0, 0, 0, .85);
}
.room-seat-state {
  margin-top: 4px; padding: 4px 13px; border-radius: 20px;
  font-size: 10px; font-weight: 600; color: #e2be9a;
  border: 1px solid rgba(214, 166, 86, .48);
  background: rgba(20, 8, 15, .55);
}
.room-seat-state.is-ok { color: #a4f0bc; border-color: rgba(132, 232, 170, .68); background: rgba(36, 96, 62, .32); }
.room-seat-state.is-pending { color: #ffd494; border-color: rgba(243, 180, 90, .65); background: rgba(110, 72, 26, .3); }
.room-seat-state.is-wait { color: #cba8b6; }
.room-seat-action {
  font-size: 10px; font-weight: 600; color: #ffebb8; padding: 4px 12px; border-radius: 20px;
  border: 1px solid rgba(243, 212, 139, .68);
  background: linear-gradient(180deg, rgba(124, 82, 30, .48), rgba(68, 42, 14, .58));
  box-shadow: inset 0 1px 0 rgba(255, 240, 200, .25), 0 2px 6px rgba(0, 0, 0, .45);
}
.room-seat-action.is-kick {
  color: #ffdcd2;
  border-color: rgba(238, 122, 104, .76);
  background: linear-gradient(180deg, rgba(128, 44, 38, .56), rgba(70, 20, 20, .66));
  box-shadow: inset 0 1px 0 rgba(255, 214, 204, .22), 0 2px 6px rgba(0, 0, 0, .45);
}

.room-bottom {
  display: flex; align-items: center; justify-content: space-between; gap: 8px 14px; flex-wrap: wrap;
  padding: 7px 14px; border-radius: 10px;
  border: 1px solid rgba(226, 180, 102, .34);
  background: rgba(22, 9, 16, .62);
}
.room-invite { display: flex; align-items: center; gap: 8px; }
.room-counts { display: flex; align-items: center; gap: 6px; }
.room-counts .count-chip { min-width: 44px; padding: 5px 6px; font-size: 11px; }
.room-counts-label { font-size: 11px; font-weight: 600; letter-spacing: 2px; color: #f0ce8e; }
.room-tip { font-size: 11px; font-weight: 600; letter-spacing: .5px; color: #e2be9a; }
.room-tip.is-ok { color: #a4f0bc; }
.room-actions { display: flex; align-items: center; justify-content: space-between; margin-top: auto; }
.room-action-note { font-size: 11px; letter-spacing: .5px; color: #d8b596; }
.room-start {
  min-width: 260px; text-align: center; box-sizing: border-box;
  font-size: 15px; font-weight: 700; letter-spacing: 3px;
  padding: 11px 24px; border-radius: 8px;
}
.setup-state { margin-top: 3px; font-size: 9px; color: #cba8b6; }
.setup-state.is-ok { color: #a4f0bc; }

/* ---------- 好友体系：大厅入口徽标 / 好友弹层 / 邀请提醒 ---------- */

/* 好友图标用字符，字号与图形图标对齐（图形图标是 22×22 的 SVG） */
.guild-icon-text {
  width: 24px; height: 24px; display: flex; align-items: center; justify-content: center;
  font-size: 22px; line-height: 1; color: #eac876;
  text-shadow: 0 2px 3px rgba(0, 0, 0, .85);
}
/* 在线好友数：压在「好友」文字右上，不占布局宽度 */
.guild-nav-badge {
  position: absolute; right: 22%; top: 6px;
  min-width: 17px; height: 17px; padding: 0 4px;
  border-radius: 9px;
  display: flex; align-items: center; justify-content: center;
  font-family: Georgia, serif; font-size: 11px; font-weight: 700; line-height: 1;
  color: #2b1504;
  background: linear-gradient(180deg, #ffe39a, #c78f2a);
  border: 1px solid rgba(255, 248, 220, .9);
  box-shadow: 0 2px 5px rgba(0, 0, 0, .6);
}

.friends-dialog { width: 620px; max-height: 470px; display: flex; flex-direction: column; }
.friends-add { display: flex; gap: 8px; margin-top: 12px; flex-shrink: 0; }
.friends-input {
  flex: 1; min-width: 0; height: 38px; padding: 0 12px;
  box-sizing: border-box;
  border-radius: 7px;
  border: 1px solid rgba(243, 212, 139, .45);
  background: rgba(18, 8, 14, .8);
  color: #ffeecd; font-size: 14px;
}
.friends-input-ph { color: rgba(220, 186, 145, .55); }
.friends-search { flex-shrink: 0; min-height: 38px; padding: 0 18px; font-size: 13px; }

/* 查找结果：头像 + 昵称 + 加为好友 */
.friends-found {
  display: flex; align-items: center; gap: 10px;
  margin-top: 8px; padding: 8px 10px; flex-shrink: 0;
  border-radius: 7px;
  border: 1px solid rgba(124, 226, 247, .45);
  background: rgba(30, 48, 56, .5);
}
.friends-found-name { flex: 1; min-width: 0; font-size: 14px; font-weight: 700; color: #fff3d6;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.friends-add-btn { flex-shrink: 0; min-height: 32px; padding: 0 14px; font-size: 12.5px; }
.friends-notice {
  display: block; margin-top: 8px; flex-shrink: 0;
  font-size: 12px; color: #ffc9a2; line-height: 1.3;
}

.friends-avatar {
  width: 34px; height: 34px; flex-shrink: 0; border-radius: 4px;
  border: 1.5px solid #8a6a3c; overflow: hidden;
  background-size: cover; background-position: center;
  display: flex; align-items: center; justify-content: center;
}
/* 在线好友头像描青边，与牌桌「行动中」同一套颜色语言 */
.friends-avatar.is-online { border-color: #7ce2f7; box-shadow: 0 0 7px rgba(124, 226, 247, .35); }
.friends-avatar-initial {
  font-family: Georgia, serif; font-size: 15px; font-weight: 700;
  color: #fff1d5; text-shadow: 0 1px 3px #1a0d14;
}

.friends-list {
  margin-top: 10px; flex: 1; min-height: 0; overflow-y: auto;
  display: flex; flex-direction: column; gap: 6px;
}
.friends-row {
  display: flex; align-items: center; gap: 10px;
  padding: 7px 9px; border-radius: 7px;
  border: 1px solid rgba(243, 212, 139, .18);
  background: linear-gradient(180deg, rgba(60, 32, 46, .55), rgba(24, 11, 18, .7));
}
.friends-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.friends-name {
  font-size: 14px; font-weight: 700; color: #fff3d6;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.friends-meta { display: flex; align-items: center; gap: 4px; }
.friends-dot { width: 6px; height: 6px; border-radius: 50%; background: #7a6754; flex-shrink: 0; }
.friends-dot.is-online { background: #4fd08a; box-shadow: 0 0 6px rgba(79, 208, 138, .8); }
.friends-status { font-size: 11px; color: #c9ae8c; line-height: 1; }
.friends-id { font-size: 11px; color: #a08c76; line-height: 1; }
.friends-invite { flex-shrink: 0; min-height: 32px; padding: 0 16px; font-size: 12.5px; }
.friends-invite-hint {
  flex-shrink: 0; font-size: 11px; color: #9d8a74; line-height: 1.2;
  max-width: 68px; text-align: right;
}
.friends-remove {
  flex-shrink: 0; min-height: 32px; padding: 0 10px; font-size: 12px;
  color: #e0a894; border-color: rgba(200, 120, 100, .45);
}
.friends-empty { padding: 22px 10px; text-align: center; font-size: 12.5px; color: #c2a68e; line-height: 1.6; }

/* 我的账号 ID：好友靠它互加，必须完整可复制 */
.friends-myid {
  display: flex; align-items: center; gap: 9px;
  margin-top: 10px; padding: 8px 10px; flex-shrink: 0;
  border-radius: 7px;
  border: 1px dashed rgba(243, 212, 139, .45);
  background: rgba(20, 8, 14, .6);
}
.friends-myid-label { font-size: 11.5px; color: #c9ae8c; flex-shrink: 0; }
.friends-myid-value {
  flex: 1; min-width: 0; font-family: Georgia, monospace; font-size: 13px;
  color: #ffe9b8; letter-spacing: .3px;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.friends-copy { flex-shrink: 0; min-height: 30px; padding: 0 12px; font-size: 12px; }

/* 邀请提醒：浮在大厅 / 房间上方，不挡主要操作 */
.invite-toast {
  /* 落在左侧「卡牌/筹码陈列区」上方：右侧操作面板从 x=682 起、底部导航从 y=503 起，
     所以提示卡只能占 x≈150~670、y≈150~330 这块真正的空白。
     放居中会压住操作面板（实测 ovPanel=true），放底部会压住导航。 */
  position: absolute; left: 150px; top: 150px;
  z-index: 26; width: 320px;
  box-sizing: border-box; padding: 10px 14px;
  border-radius: 11px;
  border: 1px solid rgba(255, 214, 130, .72);
  background: linear-gradient(180deg, rgba(92, 52, 40, .97), rgba(36, 16, 12, .97));
  box-shadow: 0 8px 22px rgba(0, 0, 0, .75), 0 0 16px rgba(243, 198, 108, .28);
  display: flex; flex-direction: column; gap: 5px;
  animation: dialogIn 180ms ease-out both;
}
/* 邀请提醒是舞台级浮层（三屏共用一份），不再区分大厅/房间偏移 */
.invite-toast-head { display: flex; align-items: center; gap: 6px; }
.invite-toast-dot {
  width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0;
  background: #ffd77e; box-shadow: 0 0 8px rgba(255, 215, 126, .9);
  animation: onlinePulse 1.6s ease-in-out infinite;
}
.invite-toast-title {
  flex: 1; min-width: 0; font-size: 14px; font-weight: 700; color: #ffe9c0;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.invite-toast-sub { font-size: 11.5px; color: #e0c4a2; line-height: 1.3; }
.invite-toast-btns { display: flex; gap: 8px; margin-top: 2px; }
.invite-toast-go { flex: 1; min-height: 34px; justify-content: center; font-size: 13.5px; }
.invite-toast-no { flex-shrink: 0; min-height: 34px; padding: 0 14px; font-size: 12.5px; }

/* ========== 局内快捷聊天 ==========
   整层 z-index 11：高于托盘(9)，低于换手提醒(15)/展演(16)/弹层(20)。
   容器与气泡一律 pointer-events:none，只有面板本体接管点击，
   否则气泡会吃掉右侧筹码堆的触摸事件。 */
.chat-trigger { background: linear-gradient(180deg, #5b3a4e, #2a1622); }
.chat-trigger.is-open { border-color: #ffe4a1; box-shadow: 0 0 0 2px rgba(255, 220, 150, .35); }

.chat-layer {
  position: absolute; right: 16px; width: 300px; z-index: 11;
  pointer-events: none; display: flex; flex-direction: column; align-items: flex-end; gap: 6px;
}
/* 面板本体：不再用带位移的 dialogIn —— 那会让整块内容在 180ms 内边淡入边
   向上位移 10px，手指按在某个条目上时条目自己还在移动，抬手就落到邻居上。
   改为纯透明度淡入，元素落点从第一帧起就是最终位置。 */
.chat-panel {
  width: 300px; box-sizing: border-box; pointer-events: auto;
  padding: 10px; border-radius: 10px;
  border: 1px solid rgba(240, 205, 140, .55);
  background: linear-gradient(180deg, rgba(48, 26, 36, .97), rgba(20, 11, 18, .97));
  box-shadow: 0 10px 26px rgba(0, 0, 0, .6), inset 0 1px 0 rgba(255, 240, 200, .16);
  animation: chatPanelIn 120ms ease-out both;
}
@keyframes chatPanelIn { 0% { opacity: 0; } 100% { opacity: 1; } }
.chat-panel-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
.chat-tabs { display: flex; gap: 6px; }
/* 切换 tab 的误触根因：两个 tab 内容高度差近 100px，切换瞬间面板骤缩 / 骤长，
   手指还停在原位时新元素正好长到指尖下，抬手就落在别的条目上。
   给内容区固定高度（取两者较大值），切换只换内容、不动面板尺寸。 */
.chat-tab {
  position: relative;
  padding: 9px 18px; border-radius: 7px; font-size: 13px; font-weight: 600;
  color: #ddc7a4; border: 1px solid rgba(226, 190, 126, .35); background: rgba(9, 9, 13, .35);
}
/* 触屏热区外扩到约 40px 高：视觉上仍是小胶囊，实际可按面积翻倍，
   两个 tab 之间也不再需要「精准点中」 */
.chat-tab::after {
  content: ''; position: absolute; left: -4px; right: -4px; top: -7px; bottom: -7px;
}
.chat-tab.is-active { color: #2a1807; border-color: #f4d48d; background: linear-gradient(180deg, #ffe4a1, #c89238); }
.chat-close {
  position: relative;
  width: 26px; height: 26px; border-radius: 6px; text-align: center; line-height: 24px;
  font-size: 17px; color: #e8cfa4; border: 1px solid rgba(226, 190, 126, .35); background: rgba(9, 9, 13, .35);
}
.chat-close::after {
  content: ''; position: absolute; left: -9px; right: -9px; top: -9px; bottom: -9px;
}
/* 内容区定高：快捷语 8 条恰好铺满、表情 3×3、选目标共用同一块高度。
   原来三态高度各不相同（约 300 / 200 / 260px），每次切换面板都跳一下，
   既造成误触，也让「刚点完表情、面板缩小」把下面的牌桌露出来被误点。
   314 = 8 条 × 34px + 7 × 6px 间隙，正好等于快捷语满铺高度。 */
.chat-body {
  /* 三态共用同一块高度：8 条 × 34px + 7 × 6px 间隙 = 314，
     表情 3×3 合计 312，选目标在同一块里滚动。切换只换内容、不动面板尺寸。 */
  height: 314px;
  display: flex; flex-direction: column;
  overflow: hidden;
}
.chat-grid { display: flex; flex-wrap: wrap; gap: 6px; align-content: flex-start; }
.chat-grid.is-text { flex-direction: column; }
.chat-item.is-text {
  flex: 0 0 auto;
  min-height: 34px; box-sizing: border-box;
  display: flex; align-items: center;
  padding: 8px 11px; border-radius: 7px; font-size: 12px; line-height: 1.35; color: #f2dfbd;
  border: 1px solid rgba(226, 190, 126, .28); background: rgba(255, 240, 200, .06);
}
.chat-item.is-text:active { background: rgba(255, 225, 160, .2); }
/* 9 个表情排成 3×3 铺满 278px 内宽（88×3 + 6×2 = 276）：
   原来是 64px 四列、最后一行只剩 1 个，行末空位让手指落到相邻格上。
   100px 高使 3 行合计 312px ≈ 快捷语满铺 314px，切换时面板几乎不跳。 */
.chat-item.is-emoji {
  width: 88px; height: 100px; box-sizing: border-box;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px;
  border-radius: 8px; border: 1px solid rgba(226, 190, 126, .28); background: rgba(255, 240, 200, .06);
}
.chat-item.is-emoji:active { background: rgba(255, 225, 160, .2); }
.chat-item-icon { font-size: 26px; line-height: 1; }
.chat-item-label { font-size: 10px; color: #dcc39a; }
.chat-panel-note {
  display: block; margin-top: 8px; min-height: 15px;
  font-size: 10px; color: #a89072; text-align: center;
}

.chat-feed { display: flex; flex-direction: column; align-items: flex-end; gap: 5px; width: 300px; }
.chat-bubble {
  max-width: 300px; display: flex; align-items: center; gap: 6px;
  padding: 6px 10px; border-radius: 10px 10px 3px 10px;
  font-size: 12px; line-height: 1.35; color: #fff3dd;
  border: 1px solid rgba(255, 220, 150, .45);
  background: linear-gradient(180deg, rgba(74, 38, 52, .94), rgba(32, 16, 26, .94));
  box-shadow: 0 4px 12px rgba(0, 0, 0, .45);
  animation: chatBubbleLife 2800ms ease-out both;
}
.chat-bubble.is-mine {
  border-color: rgba(160, 230, 190, .5);
  background: linear-gradient(180deg, rgba(30, 74, 58, .94), rgba(14, 36, 30, .94));
}
.chat-bubble.is-emoji { font-size: 13px; }
.chat-bubble-seat { flex: 0 0 auto; font-size: 10px; color: #f0ce8e; opacity: .9; }
.chat-bubble-icon { font-size: 18px; line-height: 1; }
.chat-bubble-text { flex: 1; min-width: 0; }

.chat-fly {
  position: absolute; left: 0; top: 0; width: 1080px; height: 560px;
  z-index: 16; pointer-events: none;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px;
  animation: chatFlyLife 1600ms ease-out both;
}
.chat-fly-emoji {
  font-size: 150px; line-height: 1; text-shadow: 0 10px 18px rgba(0, 0, 0, .6);
  animation: chatEmojiPop 1600ms cubic-bezier(.18, .9, .28, 1) both;
}
.chat-fly-label {
  font-size: 26px; font-weight: 700; letter-spacing: 6px; color: #ffe9b8;
  text-shadow: 0 3px 12px rgba(0, 0, 0, .85);
  animation: chatFlyLabel 1600ms ease-out both;
}

@keyframes chatBubbleLife {
  0%   { opacity: 0; transform: translateX(28px) scale(.88); }
  8%   { opacity: 1; transform: translateX(0) scale(1); }
  85%  { opacity: 1; transform: translateX(0) scale(1); }
  100% { opacity: 0; transform: translateX(12px) scale(.96); }
}
@keyframes chatFlyLife { 0% { opacity: 0; } 12% { opacity: 1; } 76% { opacity: 1; } 100% { opacity: 0; } }
@keyframes chatEmojiPop {
  0%   { opacity: 0; transform: scale(.2) rotate(-24deg) translateY(60px); }
  28%  { opacity: 1; transform: scale(1.25) rotate(8deg) translateY(0); }
  45%  { transform: scale(1) rotate(-4deg); }
  62%  { transform: scale(1.08) rotate(3deg); }
  100% { transform: scale(1.35) rotate(0deg) translateY(-30px); }
}
@keyframes chatFlyLabel {
  0%   { opacity: 0; transform: scale(.6); }
  25%  { opacity: 1; transform: scale(1); }
  80%  { opacity: 1; }
  100% { opacity: 0; transform: scale(1.1); }
}

/* ========== 表情第二步：选择目标玩家 ==========
   复用聊天面板的 300px 宽，4 个席位一行两个刚好；
   目标卡只有头像 + 昵称 + 号位，不做复杂信息，避免挑人时读半天。 */
/* 选目标：同样落在 .chat-body 的定高里，只让目标网格自己滚动。
   4 人局 2 行目标卡 + 「返回选表情」按钮刚好放得下，不需要滚动。 */
.chat-target { display: flex; flex-direction: column; gap: 8px; height: 100%; }
.chat-pending {
  display: flex; align-items: center; gap: 8px; padding: 6px 8px;
  border-radius: 7px; border: 1px solid rgba(240, 205, 140, .4);
  background: rgba(255, 235, 190, .08);
}
.chat-target-grid { display: flex; flex-wrap: wrap; gap: 6px; align-content: flex-start; overflow-y: auto; }
.chat-pending-icon { font-size: 24px; line-height: 1; }
.chat-pending-text { flex: 1; font-size: 11px; color: #ffe9bd; }
.chat-target-grid { display: flex; flex-wrap: wrap; gap: 6px; }
.chat-target-item {
  width: 68px; box-sizing: border-box; padding: 6px 3px;
  display: flex; flex-direction: column; align-items: center; gap: 2px;
  border-radius: 8px; border: 1px solid rgba(226, 190, 126, .32);
  background: rgba(255, 240, 200, .06);
}
.chat-target-item.is-self { border-color: rgba(140, 230, 190, .65); background: rgba(30, 80, 62, .28); }
.chat-target-item:active { background: rgba(255, 225, 160, .2); }
.chat-target-avatar {
  width: 34px; height: 34px; border-radius: 50%; overflow: hidden;
  border: 1px solid rgba(255, 226, 170, .6); background: rgba(0, 0, 0, .35);
  display: flex; align-items: center; justify-content: center;
}
.chat-target-avatar image { width: 100%; height: 100%; }
.chat-target-avatar.is-preset text { font-size: 15px; color: #fff3d8; text-shadow: 0 1px 3px #000; }
.chat-target-name {
  font-size: 11px; color: #f4e0bb; max-width: 62px;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.chat-target-seat { font-size: 9px; color: #b89b75; }
.chat-target-back {
  padding: 6px 10px; text-align: center; font-size: 11px; color: #e8cfa4;
  border: 1px solid rgba(226, 190, 126, .35); border-radius: 6px; background: rgba(9, 9, 13, .35);
}
.chat-bubble-target { flex: 0 0 auto; font-size: 10px; color: #ffcf8a; }

/* ========== 定向表情：飞向目标头像 + 命中特效 ==========
   整层 pointer-events:none，z-index 17 高于动作展演(16)、低于弹层(20)。
   起点由 inline style 给 left/top，位移由 --dx/--dy 给 keyframes，
   与 showcase 的 --from-x/--from-y 是同一套机制。 */
.chat-projectile-layer {
  position: absolute; left: 0; top: 0; width: 1080px; height: 560px;
  z-index: 17; pointer-events: none;
}
.chat-projectile {
  position: absolute; width: 56px; height: 56px; margin: -28px 0 0 -28px;
  display: flex; align-items: center; justify-content: center;
  font-size: 48px; line-height: 1; text-shadow: 0 6px 12px rgba(0, 0, 0, .7);
  animation: chatGiftFlight 1500ms cubic-bezier(.25, .65, .35, 1) both;
}
.chat-projectile.is-throw { animation-name: chatThrowFlight; }
.chat-projectile.is-gift { animation-name: chatGiftFlight; }
.chat-splat {
  position: absolute; width: 92px; height: 92px; margin: -46px 0 0 -46px;
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  font-size: 18px; font-weight: 700; color: #fff2cf;
  background: radial-gradient(circle, rgba(226, 58, 42, .92) 0%, rgba(176, 32, 26, .7) 45%, rgba(150, 26, 20, 0) 72%);
  box-shadow: 0 0 0 4px rgba(255, 170, 90, .35), 0 0 22px rgba(255, 90, 50, .8);
  text-shadow: 0 2px 5px #000;
  animation: chatSplatLife 1500ms ease-out both;
}
.chat-gift-halo {
  position: absolute; width: 92px; height: 92px; margin: -46px 0 0 -46px;
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  font-size: 30px; border: 2px solid rgba(255, 228, 160, .8);
  background: radial-gradient(circle, rgba(255, 224, 150, .32), rgba(255, 224, 150, 0) 70%);
  box-shadow: 0 0 20px rgba(255, 214, 130, .7);
  animation: chatHaloLife 1500ms ease-out both;
}
.chat-projectile-label {
  position: absolute; margin-left: -110px; width: 220px; text-align: center;
  transform: translateY(34px); white-space: nowrap;
  font-size: 13px; font-weight: 700; color: #ffe9b8;
  text-shadow: 0 2px 8px #000, 0 0 6px rgba(0, 0, 0, .9);
  animation: chatProjectileLabel 1500ms ease-out both;
}

@keyframes chatThrowFlight {
  0%   { opacity: 0; transform: translate(0, 0) scale(.45) rotate(-35deg); }
  10%  { opacity: 1; transform: translate(0, -24px) scale(1) rotate(-15deg); }
  62%  { opacity: 1; transform: translate(var(--dx), var(--dy)) scale(1.1) rotate(30deg); }
  72%  { opacity: 1; transform: translate(var(--dx), var(--dy)) scale(1.45) rotate(45deg); }
  100% { opacity: 0; transform: translate(var(--dx), var(--dy)) scale(1.5) rotate(50deg); }
}
@keyframes chatGiftFlight {
  0%   { opacity: 0; transform: translate(0, 0) scale(.5); }
  14%  { opacity: 1; transform: translate(0, -16px) scale(1); }
  66%  { opacity: 1; transform: translate(var(--dx), var(--dy)) scale(1.1); }
  82%  { opacity: 1; transform: translate(var(--dx), var(--dy)) scale(1.25); }
  100% { opacity: 0; transform: translate(var(--dx), var(--dy)) scale(1.3) translateY(-14px); }
}
@keyframes chatSplatLife {
  0%, 58% { opacity: 0; transform: scale(.2); }
  66% { opacity: 1; transform: scale(.7); }
  82% { opacity: .95; transform: scale(1.25); }
  100% { opacity: 0; transform: scale(1.55); }
}
@keyframes chatHaloLife {
  0%, 58% { opacity: 0; transform: scale(.3) rotate(-20deg); }
  70% { opacity: 1; transform: scale(1) rotate(0deg); }
  88% { opacity: .9; transform: scale(1.3) rotate(20deg); }
  100% { opacity: 0; transform: scale(1.5) rotate(35deg); }
}
@keyframes chatProjectileLabel {
  0%, 55% { opacity: 0; }
  68% { opacity: 1; }
  88% { opacity: 1; }
  100% { opacity: 0; }
}

/* ========== 天梯榜 ==========
   930px 弹层内放 9 列：名次 44 + 玩家 210 + 7 个指标列等分。
   表格限高滚动，避免 50 行把 560 舞台撑破；表头不随滚动（sticky 省略，
   行高固定 34px，滚动时列名由 dialog-sub 兜住说明）。
   字号下限：844×390 下 scale≈0.696，舞台字 10px 只剩 ~7 物理像素。
   榜单是「一眼扫九列」的读表场景，表头 / 数值 / 评分口径统一不低于 12px；
   只有「你 / 观察期」这类带底色胶囊的辅助角标允许 10px。 */
/* 弹层高度必须受限：舞台只有 560px 高，内容（表格 + 公式 + 准入说明 + 免责）
   累加后已经到 550px，只剩上下各 5px。再增加一行文案就会顶破舞台。
   给上限 + 内部滚动，让文案可以自由加长而不破坏布局。 */
.leaderboard-dialog {
  width: 930px;
  max-height: 520px;
  display: flex; flex-direction: column;
}
.leaderboard-dialog .dialog-body,
.leaderboard-dialog .leaderboard-body {
  min-height: 0; overflow-y: auto;
}
.leaderboard-body {
  display: flex; flex-direction: column; gap: 8px;
  min-height: 0; flex: 1 1 auto;
  /* 不能写 overflow: hidden —— 内容超限时会被静默裁掉（提示条与说明文字消失）。
     改 auto：超限可滚，内容始终可达。 */
  overflow-y: auto;
}
.leaderboard-meta { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; font-size: 12px; }
.leaderboard-source { color: #c9ac81; }
.leaderboard-my { color: #ffe4a8; font-weight: 700; }
.leaderboard-provisional { color: #ffb98a; }
/* 表格是可伸缩项：弹层高度受限时，优先压缩表格（它本来就能滚动），
   而不是让公式 / 准入说明被压出可视区（那样会出现文字叠在表格上的重影）。
   min-height/max-height 都取「整行倍数」，避免滚动截断卡在行中间：
   表头 30 + 数据行 34×N。234 = 30 + 34×6，装 6 行整；108 = 30 + 34×2，保底 2 行。 */
/* 表格高度上限 259px：这是「公式 + 入榜条件 + 免责」三行文字必须常驻可见
   的前提下能给出的最大空间（body 351 - 文字 92 = 259）。
   取舍说明：入榜规则是玩家理解榜单的前提，不能为了多显示一行数据把它挤掉；
   数据行可以滚动，规则不能。 */
.leaderboard-table {
  max-height: 208px; overflow-y: auto; box-sizing: border-box;
  border: 1px solid rgba(226, 190, 126, .38); border-radius: 6px;
  background: rgba(12, 7, 11, .42);
  /* 表格自身保持可滚：即使 body 也能滚，表格内滚动体验更直接（不必滚整页）。 */
  flex: 0 1 auto; min-height: 0;
}
/* 公式与说明文字不允许被压缩，它们是必须完整可读的内容 */
.leaderboard-formula, .leaderboard-rule, .leaderboard-note { flex: 0 0 auto; }
/* 表格外层包一层相对定位，用来放「可滚动」提示 */
/* 包裹层只负责给提示条提供定位上下文，不参与横向分配。
   不能写成 display:flex 且不指定方向 —— 那会让表格变成横向 flex item，
   被压到「内容宽度」，九列的列宽计算全部失效（右侧数值列直接消失）。
   flex-shrink 必须为 0 且高度写死：父级是 flex 列，允许收缩时会把它压到 163px，
   表格高度跟着变，所有按 234px 算的布局（含提示条位置）全部错位。 */
.leaderboard-table-wrap {
  position: relative; display: block;
  /* 必须与表格同高：只给表格 max-height、wrap 由内容决定的话，
     表格会溢出 wrap（实测溢出 35px），后随的提示条正好落进溢出区，
     视觉上压在公式文字上。两者同高才能保证提示条在表格真正底边之后。 */
  /* 高度写死，不能只给 max-height：表格设了 overflow:auto 后不再撑开父级，
     wrap 会塌成 0 高，后随的提示条被上提到表格内部（实测 hintTop 279 < 表格底 320）。
     写死同高，提示条才落在表格真正的底边之后。 */
  height: 208px;
  flex: 0 0 208px;
}
.leaderboard-table-wrap .leaderboard-table { width: 100%; }
/* 提示条不再覆盖在滚动容器上，而是放在表格「下方」独立成行。
   原因：滚动容器内部的行位置取决于 scrollTop，任何绝对定位的覆盖层
   都会随滚动状态时而盖住整行、时而露出半截，无法稳定对齐。
   放到外面后，表格底部自然就是一条裁切边界，提示条在其下方说明「还有更多」。 */
.leaderboard-scroll-hint {
  position: static;
  display: flex; align-items: center; justify-content: center;
  height: 16px; margin: 2px 0 0; flex: 0 0 auto;
  pointer-events: none;
}
.leaderboard-scroll-hint text { font-size: 10px; color: #e8c48a; opacity: .9; line-height: 1; }
/* 表格是滚动容器（overflow-y:auto 会同时裁掉溢出部分），
   榜首行头像框与皇冠有轻微上溢，给第一行留一点内边距免得被裁头。 */
.leaderboard-table { padding-top: 2px; }
/* 每行改成纵向：上面可能有分组标题，下面是数据行。
   分组标题必须独占一行，否则会被挤进九列里错位。
   表头行（is-head）没有分组标题，直接横向排列。 */
.leaderboard-row {
  padding: 0 6px;
  border-bottom: 1px solid rgba(226, 190, 126, .16);
  font-size: 12px; color: #f0dcb8;
}
.lb-row-inner { display: flex; align-items: center; height: 34px; }
.leaderboard-row.is-head {
  display: flex; align-items: center;
  height: 30px; font-weight: 700; color: #ffe0a0; font-size: 12px;
  background: linear-gradient(180deg, rgba(94, 56, 72, .95), rgba(44, 22, 32, .95));
  border-bottom-color: rgba(226, 190, 126, .45);
}
/* 分组标题：正式榜用金调，观察期用灰调，一眼能分清段位。
   下内边距要留足 —— 下面的行里有皇冠（top:-4px 上溢），
   标题贴着行会给皇冠压出「被截断」的错觉。 */
.lb-section-head {
  display: flex; align-items: baseline; gap: 8px;
  padding: 7px 2px 8px;
  border-bottom: 1px solid rgba(226, 190, 126, .28);
}
/* 紧随分组标题的数据行：多留 4px 高度而不是 padding-top。
   用 padding 会把固定 34px 里的内容挤下去，反而更贴皇冠；
   增高才能让皇冠（top:-4px）完整落在行框内不被裁。
   用显式 class 而不是相邻选择器：WXSS 对 + 的支持不如标准 CSS 稳。 */
.lb-row-inner.has-section { height: 38px; }
.lb-section-title { font-size: 13px; font-weight: 700; letter-spacing: .5px; }
.lb-section-sub { font-size: 11px; color: #b79a72; }
.lb-section-head.is-official .lb-section-title { color: #ffd884; }
.lb-section-head.is-trial .lb-section-title { color: #9fb0c0; }
.lb-section-head.is-trial .lb-section-sub { color: #7d8b99; }
/* 观察期行整体压暗，与正式榜拉开层次 */
.leaderboard-row.is-trial { background: rgba(20, 26, 34, .28); }
.leaderboard-row.is-trial .lb-c-num.is-score { color: #b9c6d3; font-weight: 400; }
.leaderboard-row.is-me { background: rgba(54, 122, 96, .26); }
.leaderboard-row:last-child { border-bottom: none; }
.lb-c-rank { flex: 0 0 44px; position: relative; display: flex; align-items: center; justify-content: center; }
.lb-c-name { flex: 0 0 210px; display: flex; align-items: center; gap: 5px; min-width: 0; }
.lb-c-num { flex: 1; text-align: center; }
.lb-c-num.is-score { color: #ffd884; font-weight: 700; font-size: 15px; }
/* 胜率列承载「50%(2/4)」，比纯数字宽，给两倍权重。
   字号略收（11px）避免「100%(14/20)」在窄列里换行。 */
.lb-c-num.lb-c-rate { flex: 1.6; font-size: 11px; white-space: nowrap; }
/* 观察期胜率压暗：样本不足时这个百分比参考价值有限，
   与正式榜同样醒目会让人误以为「1局100%」比「20局70%」更强。 */
.lb-c-num.is-provisional { color: #96a3b0; }
.lb-avatar {
  width: 22px; height: 22px; flex-shrink: 0; border-radius: 50%; overflow: hidden;
  border: 1px solid rgba(255, 226, 170, .55); background: rgba(0, 0, 0, .4);
  display: flex; align-items: center; justify-content: center;
}
.lb-avatar image { width: 100%; height: 100%; }
.lb-avatar.is-preset { background: linear-gradient(150deg, #7a4a5e, #24121c); }
.lb-avatar.is-preset text { font-size: 12px; color: #fff3d8; }

/* ========== 天梯榜首：专属头像框 ==========
   样式目标「高贵华丽」：三层金环 + 顶部皇冠 + 背后暖金辉光。
   尺寸比普通头像大一圈（26 vs 22），但行高固定 34px 不变，
   靠 .lb-c-name 的 align-items:center 居中，不会把行撑高。
   动画只做辉光的缓慢呼吸，不做位移 —— 表格里每行都在动会晃眼，
   而且截图验收要靠 animation:none 停帧，位移类动画停帧后位置会偏。 */
.lb-avatar-crown {
  position: relative; flex-shrink: 0;
  width: 26px; height: 26px;
  display: flex; align-items: center; justify-content: center;
}
.lb-avatar.is-champion {
  width: 24px; height: 24px; border: none; position: relative; z-index: 2;
  /* 冠军头像也要有自己的深色底：.lb-avatar 的基础底色很淡，
     没有 is-preset 类时初始字是深棕色，落在浅底上几乎看不见（截图里像空白圈）。
     这里用深酒红渐变托住文字，与外圈金色形成对比。 */
  background: linear-gradient(155deg, #6d3a4e, #2a1420);
  /* 四层金环：亮金细边 → 暗金实体环 → 半透金晕 → 外扩柔光。
     单环看起来只是「描边」，多层才有金属包边的厚度感。 */
  box-shadow:
    0 0 0 1.5px #fff3cc,
    0 0 0 3px #d9a63c,
    0 0 0 4.5px #8a5f16,
    0 0 0 5.5px rgba(255, 224, 150, .5),
    0 0 11px 3px rgba(255, 190, 70, .8);
}
.lb-avatar.is-champion text { font-size: 12px; color: #ffe9b0; font-weight: 700; }
/* 背后的暖金辉光，缓慢呼吸 */
.lb-crown-glow {
  position: absolute; left: 50%; top: 50%; width: 36px; height: 36px;
  margin: -18px 0 0 -18px; border-radius: 50%; z-index: 1;
  background: radial-gradient(circle, rgba(255, 226, 150, .7) 0%, rgba(255, 190, 60, .3) 48%, rgba(255, 170, 40, .1) 66%, transparent 76%);
  animation: crownBreathe 2.6s ease-in-out infinite;
}
@keyframes crownBreathe {
  0%, 100% { opacity: .62; transform: scale(.94); }
  50% { opacity: 1; transform: scale(1.08); }
}
/* 三个冠齿：不用 clip-path（小程序 WebView 支持不稳，容易被忽略后变成一块方条），
   改用三个小三角块并排。每个三角用 border 技巧画，颜色走金属金。 */
.lb-crown::before,
.lb-crown::after {
  content: ''; position: absolute; bottom: 100%; width: 0; height: 0;
  border-left: 3px solid transparent; border-right: 3px solid transparent;
  border-bottom: 5px solid #ffdc84;
  filter: drop-shadow(0 -1px 0 rgba(255, 255, 255, .55));
}
.lb-crown::before { left: 0; }
.lb-crown::after { right: 0; }
/* 中间的冠齿用主体自身的上边框尖角表达 */
.lb-crown {
  position: absolute; left: 50%; top: -4px; z-index: 3;
  width: 16px; height: 11px; margin-left: -8px;
  background: linear-gradient(180deg, #fff8da 0%, #ffdc84 34%, #e2a936 70%, #9c6a14 100%);
  border-radius: 1px 1px 3px 3px;
  box-shadow: 0 1px 2px rgba(0, 0, 0, .6), inset 0 1px 0 rgba(255, 255, 255, .8);
}
/* 中间冠齿 */
.lb-crown text {
  display: block; position: absolute; left: 50%; bottom: 100%;
  width: 0; height: 0; margin-left: -3px; font-size: 0;
  border-left: 3px solid transparent; border-right: 3px solid transparent;
  border-bottom: 6px solid #ffe9a8;
  filter: drop-shadow(0 1px 0 rgba(160, 110, 20, .8));
}
/* 冠带正中的宝石 */
.lb-crown-gem {
  position: absolute; left: 50%; bottom: 2px; width: 3px; height: 3px;
  margin-left: -1.5px; border-radius: 50%; z-index: 2;
  background: radial-gradient(circle, #fffdf0 0%, #ffd979 60%, #b8862f 100%);
  box-shadow: 0 0 2px rgba(255, 240, 190, .9);
}

/* 榜首整行：淡金底 + 左侧金条，与「你」的绿底区分开 */
.leaderboard-row.is-champion {
  background: linear-gradient(90deg, rgba(120, 88, 24, .48), rgba(70, 48, 12, .18) 62%, transparent);
  box-shadow: inset 2px 0 0 #ffd77f;
}
/* 榜首名次：金色圆牌衬底。
   不能用伪元素压在 text 上 —— 小程序里 text 的 ::before 层级不可靠，
   实测会把数字完全盖住（只剩一个金球）。改为真实节点叠加：
   .lb-c-rank 负责定位，.lb-c-rank-medal 是圆牌，.lb-c-rank-num 是数字。
   列宽仍保持 44px（9 列表格靠列宽对齐，不能改 flex-basis）。 */
.lb-c-rank-medal {
  position: absolute; left: 50%; top: 50%;
  width: 19px; height: 19px; margin: -9.5px 0 0 -9.5px; border-radius: 50%; z-index: 0;
  background: radial-gradient(circle at 42% 34%, #fff6d0 0%, #ffd979 42%, #d49a28 74%, #8f6212 100%);
  box-shadow: 0 1px 3px rgba(0, 0, 0, .55), inset 0 1px 0 rgba(255, 255, 255, .7);
}
.lb-c-rank-num { position: relative; z-index: 1; }
.lb-c-rank-num.is-champion { color: #2a1a02; font-weight: 700; text-shadow: 0 1px 0 rgba(255, 246, 208, .85); }
.lb-name.is-champion { color: #ffe9b0; font-weight: 700; max-width: 92px; }
.lb-champion {
  flex-shrink: 0; font-size: 10px; padding: 1px 5px; border-radius: 4px; font-weight: 700;
  color: #3a2606;
  background: linear-gradient(180deg, #fff2c4, #ffd979 55%, #e0a631);
  border: 1px solid rgba(255, 240, 190, .9);
  box-shadow: 0 1px 3px rgba(0, 0, 0, .45);
}
.lb-name { max-width: 108px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.lb-me, .lb-provisional {
  flex-shrink: 0; font-size: 10px; padding: 1px 4px; border-radius: 4px;
  border: 1px solid rgba(255, 220, 150, .45); color: #ffe4b0;
}
.lb-provisional { border-color: rgba(255, 170, 120, .45); color: #ffb98a; }
.leaderboard-empty { padding: 20px; text-align: center; font-size: 12px; color: #c9ac81; }
.leaderboard-formula { font-size: 12px; line-height: 1.45; color: #c6a981; }
.leaderboard-note { font-size: 11px; line-height: 1.45; color: #aa8e6f; }
/* 入榜条件比免责说明更重要，用暖金提高可读性 */
.leaderboard-rule { font-size: 12px; line-height: 1.45; color: #e8c48a; }
/* 未登录提示：整条可点，直接进资料/登录弹层 */
.leaderboard-login-hint {
  display: flex; align-items: center; gap: 10px;
  margin: 6px 0 2px; padding: 7px 10px;
  border-radius: 6px;
  border: 1px solid rgba(255, 205, 120, .5);
  background: linear-gradient(90deg, rgba(120, 82, 24, .5), rgba(70, 48, 14, .22));
}
.lb-hint-text { flex: 1; font-size: 12px; line-height: 1.4; color: #ffe2b0; }
.lb-hint-btn {
  flex-shrink: 0; font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 4px;
  color: #3a2606;
  background: linear-gradient(180deg, #fff2c4, #ffd979 55%, #e0a631);
  border: 1px solid rgba(255, 240, 190, .9);
}
.lb-hint-hover { opacity: .85; }

/* ========== 娱乐模式：增益选择 / 技能面板 / 战报 ========== */
.ent-overlay { z-index: 26; }
.ent-dialog { width: 560px; padding: 16px 18px 18px; }
.ent-dialog-sub { display: block; font-size: 13px; color: #d9bf95; margin: 2px 0 12px; text-align: center; }
.buff-choices, .skill-choices { display: flex; flex-direction: column; gap: 8px; }
.buff-choice, .skill-choice {
  display: flex; align-items: center; gap: 12px;
  padding: 10px 12px; border-radius: 9px; min-height: 58px; box-sizing: border-box;
  border: 1px solid rgba(226, 190, 126, .35);
  background: rgba(255, 240, 200, .06);
}
.buff-choice.is-active { border-color: #f4d48d; background: linear-gradient(180deg, rgba(255,228,161,.22), rgba(200,146,56,.16)); }
.buff-icon, .skill-icon { font-size: 30px; width: 40px; text-align: center; flex-shrink: 0; }
.buff-copy, .skill-copy { display: flex; flex-direction: column; gap: 2px; flex: 1; }
.buff-name, .skill-name { font-size: 16px; font-weight: 700; color: #ffe6b4; }
.buff-desc, .skill-desc { font-size: 12px; line-height: 1.4; color: #d9c19a; }
.buff-check { font-size: 12px; font-weight: 700; color: #3a2606; padding: 2px 8px; border-radius: 4px; background: linear-gradient(180deg, #fff2c4, #ffd979); }
.skill-left { font-size: 12px; font-weight: 500; color: #e2a860; }
.skill-choice.is-locked { opacity: .45; }
.skill-targets { display: flex; flex-direction: column; gap: 8px; }
.skill-target {
  padding: 12px; border-radius: 8px; text-align: center; font-size: 15px; color: #ffe6b4;
  border: 1px solid rgba(226, 190, 126, .4); background: rgba(255, 240, 200, .08);
}
.skill-target.is-disabled { opacity: .4; }
.skill-back { margin-top: 4px; }
.ent-result {
  position: absolute; left: 50%; top: 76px; transform: translateX(-50%);
  z-index: 27; display: flex; flex-direction: column; align-items: center; gap: 2px;
  padding: 10px 22px; border-radius: 10px; min-width: 260px; max-width: 520px;
  border: 1.5px solid #f4d48d;
  background: linear-gradient(180deg, rgba(84, 40, 60, .97), rgba(24, 10, 19, .97));
  box-shadow: 0 8px 24px rgba(0, 0, 0, .6);
  animation: fadeIn 160ms ease-out both;
}
.ent-result-title { font-size: 16px; font-weight: 700; color: #ffe6b4; }
.ent-result-text { font-size: 13px; color: #e8cf9f; text-align: center; }
