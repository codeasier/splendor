/* ---------- 10. 动效 & 3段式桌面动作展演（取出/翻起 → 悬停展示 1.2s → 飞入工作台） ---------- */
.action-showcase {
  position: absolute; left: 0; top: 0; width: 1080px; height: 560px;
  z-index: 16; pointer-events: none;
  display: flex; align-items: center; justify-content: center;
  animation: showcaseLifecycle 1750ms ease-out both;
}
.showcase-backdrop {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background:
    radial-gradient(ellipse 46% 48% at 50% 48%, rgba(255, 214, 128, .24) 0%, rgba(20, 6, 14, .58) 56%, transparent 82%);
  animation: showcaseBackdrop 1750ms ease-out both;
}
.showcase-banner {
  position: absolute; left: 50%; top: 76px;
  width: 440px; margin-left: -220px;
  padding: 8px 20px 10px;
  border-radius: 28px;
  border: 1.5px solid rgba(255, 230, 168, .85);
  background:
    radial-gradient(ellipse 85% 90% at 50% 10%, rgba(136, 56, 82, .92), rgba(26, 9, 18, .95) 85%);
  box-shadow:
    0 0 0 2px rgba(18, 6, 12, .85),
    0 0 24px rgba(255, 206, 112, .45),
    0 12px 28px rgba(0, 0, 0, .82);
  display: flex; flex-direction: column; align-items: center; gap: 2px;
  z-index: 4;
  animation: showcaseBanner 1750ms cubic-bezier(.2, .8, .3, 1) both;
}
.showcase-badge {
  font-size: 9px; font-weight: 700; letter-spacing: 3px; color: #ffd984;
}
.showcase-title {
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", Georgia, serif;
  font-size: 19px; font-weight: 700; letter-spacing: 2px; color: #fff5d6;
  text-shadow: 0 2px 6px #000;
}
.showcase-sub {
  font-size: 11px; color: #edd0a8; letter-spacing: .5px;
}

/* 卡牌展演主体：从卡槽/牌库坐标翻起 → 中央悬停展示 ~1.2s → 飞入工作台/对手席位 */
.showcase-actor {
  position: relative; z-index: 3;
  margin-top: 24px;
  display: flex; align-items: center; justify-content: center;
  animation: showcaseCardFlight 1750ms cubic-bezier(.22, .82, .28, 1) both;
}
.showcase-halo {
  position: absolute; left: 50%; top: 50%;
  width: 240px; height: 240px; margin-left: -120px; margin-top: -120px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 224, 148, .52) 0%, rgba(255, 196, 92, .18) 46%, transparent 72%);
  filter: blur(2px);
}
.showcase-card-row {
  position: relative; z-index: 2;
  display: flex; align-items: center; gap: 18px;
}
.card-showcase {
  width: 138px; height: 184px;
  border-radius: 9px;
  border: 2px solid #fff0be;
  box-shadow:
    0 0 0 2px #7ce2f7,
    0 0 28px rgba(255, 214, 122, .75),
    0 4px 0 #b8925a,
    0 8px 0 #6e502a,
    0 22px 42px rgba(0, 0, 0, .88);
}
.card-showcase .card-art { height: 100%; }
.card-showcase .card-points { font-size: 38px; left: 8px; top: 2px; }
.card-showcase .card-gem { width: 32px; height: 32px; right: 7px; top: 6px; }
.card-showcase .card-foot { left: 6px; bottom: 7px; width: 62px; max-height: 120px; gap: 4px; }
.card-showcase .cost-bubble { width: 26px; height: 26px; }
.card-showcase .cost-bubble text { font-size: 15px; }
.card-showcase .card-name { font-size: 12px; right: 6px; bottom: 5px; padding: 2px 6px; }

.showcase-deck {
  position: relative; left: 0; top: 0;
  width: 118px; height: 172px;
  transform: none;
  box-shadow:
    0 0 26px rgba(255, 214, 122, .65),
    0 6px 0 #917148,
    0 20px 38px rgba(0, 0, 0, .85);
}
.showcase-deck .deck-edges { height: 164px; }
.showcase-deck .deck-crest { width: 52px; height: 52px; margin-left: -26px; margin-top: -26px; }
.showcase-deck .deck-label { font-size: 24px; }

.showcase-gold-bonus {
  display: flex; flex-direction: column; align-items: center; gap: 6px;
}
.showcase-gold-tag {
  padding: 2px 9px; border-radius: 12px;
  font-size: 11px; font-weight: 700; color: #2b1504;
  border: 1px solid #fff2c6;
  background: linear-gradient(180deg, #ffeaad, #d49b3c);
  box-shadow: 0 3px 8px rgba(0, 0, 0, .65);
}

/* 拿取筹码展演主体：每枚筹码从右侧各自筹码堆升起 → 中央并排悬停展示 ~1.2s → 飞入工作台筹码槽 */
.showcase-coins {
  position: relative; z-index: 3;
  margin-top: 28px;
  display: flex; align-items: center; justify-content: center; gap: 22px;
}
.showcase-coin-item {
  display: flex; flex-direction: column; align-items: center; gap: 8px;
  animation: showcaseCoinFlight 1750ms cubic-bezier(.22, .82, .28, 1) both;
}
.showcase-coin {
  position: relative; width: 68px; height: 68px; border-radius: 50%;
  box-shadow:
    0 0 0 2px #fff0be,
    0 0 24px rgba(255, 214, 122, .68),
    0 4px 0 #b8843e,
    0 8px 0 #5e3d16,
    0 16px 28px rgba(0, 0, 0, .85);
}
.showcase-coin-gem {
  position: absolute; left: 50%; top: 50%;
  width: 36px; height: 36px; margin-left: -18px; margin-top: -18px;
}
.showcase-coin-label {
  padding: 3px 10px; border-radius: 12px;
  font-size: 11px; font-weight: 700; color: #fff4d6;
  border: 1px solid rgba(243, 212, 139, .78);
  background: rgba(22, 9, 16, .88);
  box-shadow: 0 3px 8px rgba(0, 0, 0, .72);
}

@keyframes showcaseLifecycle {
  0%, 96% { opacity: 1; visibility: visible; }
  100% { opacity: 0; visibility: hidden; }
}
@keyframes showcaseBackdrop {
  0% { opacity: 0; }
  14%, 76% { opacity: 1; }
  94%, 100% { opacity: 0; }
}
@keyframes showcaseBanner {
  0% { opacity: 0; transform: translateY(-16px) scale(.92); }
  14%, 78% { opacity: 1; transform: translateY(0) scale(1); }
  95%, 100% { opacity: 0; transform: translateY(-10px) scale(.95); }
}
@keyframes showcaseCardFlight {
  0% {
    opacity: .85;
    transform: translate3d(var(--from-x, 0px), var(--from-y, 0px), 0) perspective(520px) rotateX(24deg) rotateY(var(--flip-from, 0deg)) scale(.54);
  }
  18% {
    opacity: 1;
    transform: translate3d(0, -4px, 0) perspective(520px) rotateX(4deg) rotateY(0deg) scale(1.06);
  }
  26%, 76% {
    opacity: 1;
    transform: translate3d(0, 0, 0) perspective(520px) rotateX(2deg) rotateY(0deg) scale(1);
  }
  96% {
    opacity: .22;
    transform: translate3d(var(--to-x, 0px), var(--to-y, 210px), 0) perspective(520px) rotateX(18deg) rotateY(0deg) scale(.26);
  }
  100% {
    opacity: 0;
    transform: translate3d(var(--to-x, 0px), var(--to-y, 210px), 0) scale(.2);
  }
}
@keyframes showcaseCoinFlight {
  0% {
    opacity: .85;
    transform: translate3d(var(--coin-from-x, 280px), var(--coin-from-y, 0px), 0) perspective(460px) rotateX(24deg) scale(.56);
  }
  18% {
    opacity: 1;
    transform: translate3d(0, -6px, 0) perspective(460px) rotateX(4deg) scale(1.08);
  }
  26%, 76% {
    opacity: 1;
    transform: translate3d(0, 0, 0) perspective(460px) rotateX(2deg) scale(1);
  }
  96% {
    opacity: .22;
    transform: translate3d(var(--coin-to-x, 0px), var(--coin-to-y, 220px), 0) perspective(460px) rotateX(18deg) scale(.32);
  }
  100% {
    opacity: 0;
    transform: translate3d(var(--coin-to-x, 0px), var(--coin-to-y, 220px), 0) scale(.22);
  }
}

@keyframes cardDeal {
  0% { opacity: .35; }
  100% { opacity: 1; }
}
@keyframes coinLift {
  0% { transform: translateY(0); }
  100% { transform: translateY(-4px); }
}
@keyframes nobleIn {
  0% { opacity: 0; }
  100% { opacity: 1; }
}
@keyframes fadeIn { 0% { opacity: 0; } 100% { opacity: 1; } }
@keyframes dialogIn {
  0% { opacity: 0; transform: translateY(10px) scale(.98); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes turnBreath { 0%, 100% { opacity: .9; } 50% { opacity: 1; } }
@keyframes vaultPulse {
  0% { box-shadow: 0 0 0 0 rgba(255, 154, 106, .7); }
  70% { box-shadow: 0 0 0 8px rgba(255, 154, 106, 0); }
  100% { box-shadow: 0 0 0 0 rgba(255, 154, 106, 0); }
}

