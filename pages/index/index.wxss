    inset 0 0 0 2px rgba(255, 255, 255, .16),
    inset 0 -6px 10px rgba(0, 0, 0, .42);
  overflow: hidden;
}
/* 宝石切面：斜向高光 + 顶部弧面反光 */
.pile-coin::before {
  content: '';
  position: absolute;
  left: -12%;
  top: -18%;
  width: 78%;
  height: 88%;
  border-radius: 50%;
  background: linear-gradient(145deg, rgba(255, 255, 255, .55) 0%, rgba(255, 255, 255, .1) 48%, transparent 72%);
  transform: rotate(-16deg);
}
.pile-coin::after {
  content: '';
  position: absolute;
  left: 14%;
  top: 7%;
  width: 62%;
  height: 34%;
  border-radius: 50%;
  background: radial-gradient(ellipse at 50% 100%, rgba(255, 255, 255, .6), transparent 72%);
}
.pile-count { font-family: Georgia, serif; font-size: 15px; font-weight: 700; color: #fbeed2; line-height: 1; text-shadow: 0 1px 3px rgba(0, 0, 0, .8); }
.pile-name { font-size: 10px; color: #d9b79d; line-height: 1; letter-spacing: .5px; }
.pile-tip { display: block; font-size: 10px; color: #b9958b; margin-top: 5px; }

/* ---------- 底部资产凹槽 ---------- */
.tray {
  position: absolute;
  left: 100px;
  top: 438px;
  width: 950px;
  height: 114px;
  border: 2px solid #dfb06a;
  border-radius: 60px 60px 14px 14px;
  background:
    repeating-linear-gradient(90deg, rgba(255, 255, 255, .014) 0px, rgba(255, 255, 255, .014) 1px, transparent 1px, transparent 5px),
    linear-gradient(180deg, rgba(50, 27, 41, .96), rgba(14, 7, 13, .98));
  box-shadow:
    0 -6px 24px rgba(0, 0, 0, .6),
    inset 0 2px 0 rgba(255, 226, 164, .32),
