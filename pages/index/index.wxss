@import "art.wxss";

/* ==================================================================
 * 璀璨宝石 · 横屏 2.5D 实体牌桌
 * ------------------------------------------------------------------
 * 视觉规则
 *   光源：左上柔和主光；所有实体向右下投短阴影，左上留高光。
 *   视角：接近俯视，远端市场行缩小 5%，字仍保持正立；明显侧转只用于左侧牌库。
 *   材质：绒布粗糙无锐反光 / 纸牌哑光薄边 / 金属三层倒角 / 宝石小面积高亮切面。
 *   层级：桌布 → 投影 → 纸叠与筹码侧壁 → 顶面 → 数字图标 → 选中轮廓 → 弹层。
 * 所有尺寸为 1080×560 逻辑舞台坐标，由 stage 等比缩放。
 * ================================================================== */

page, .viewport { width: 100%; height: 100vh; overflow: hidden; }
.viewport { position: relative; background: #1b0d15; }

.stage {
  position: absolute;
  left: 50%; top: 50%;
  width: 1080px; height: 560px;
  margin-left: -540px; margin-top: -280px;
  transform-origin: center center;
  overflow: hidden;
  border-radius: 10px;
  box-shadow: 0 18px 60px rgba(0, 0, 0, .75), inset 0 0 0 1px rgba(243, 212, 139, .22);
}

/* ---------- 1. 场景：酒红绒面桌布 ---------- */
.felt {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background:
    radial-gradient(ellipse 76% 68% at 46% 36%, rgba(196, 146, 162, .3) 0%, rgba(135, 89, 107, .12) 58%, transparent 100%),
    linear-gradient(158deg, #714457 0%, #684050 34%, #583344 70%, #35232f 100%);
}
/* 绒面经纬：对比度远低于卡面内容，只提供织物手感 */
.felt-grain {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background:
    repeating-linear-gradient(45deg, rgba(255, 236, 218, .014) 0px, rgba(255, 236, 218, .014) 1px, transparent 1px, transparent 5px),
    repeating-linear-gradient(-45deg, rgba(24, 10, 20, .045) 0px, rgba(24, 10, 20, .045) 1px, transparent 1px, transparent 5px),
    repeating-linear-gradient(0deg, rgba(255, 255, 255, .01) 0px, rgba(255, 255, 255, .01) 1px, transparent 1px, transparent 3px);
}
/* 柔和光斑：模拟桌面顶灯，不产生锐利边缘 */
.felt-light {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background: radial-gradient(ellipse 60% 58% at 38% 30%, rgba(255, 224, 190, .1) 0%, transparent 100%);
}
/* 四边压暗，把视线收进牌桌中央 */
.felt-vignette {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background: radial-gradient(ellipse 94% 102% at 50% 48%, transparent 44%, rgba(30, 14, 24, .62) 100%);
  box-shadow: inset 0 0 80px rgba(18, 8, 16, .42);
}
.table-emblem {
  position: absolute;
  left: 50%; top: 48%;
  width: 430px; height: 430px;
  margin-left: -215px; margin-top: -215px;
  background-size: 100% 100%; background-repeat: no-repeat;
  opacity: .055;
}
/* 实体木框：内高光 / 暖棕主体 / 外暗边，三层倒角方向一致 */
.wood-edge { position: absolute; z-index: 1; }
.wood-top, .wood-bottom { left: 0; right: 0; height: 10px; }
.wood-top {
  top: 0;
  background: linear-gradient(180deg, #8a5c3b 0%, #5a352d 46%, #2a1720 100%);
  box-shadow: inset 0 1px 0 rgba(255, 225, 176, .42), 0 3px 10px rgba(0, 0, 0, .55);
}
.wood-bottom {
  bottom: 0;
  background: linear-gradient(0deg, #8a5c3b 0%, #5a352d 46%, #2a1720 100%);
  box-shadow: inset 0 -1px 0 rgba(255, 225, 176, .28), 0 -3px 10px rgba(0, 0, 0, .5);
}
.wood-left, .wood-right { top: 0; bottom: 0; width: 10px; }
.wood-left { left: 0; background: linear-gradient(90deg, #33202a, #6b4234 55%, rgba(60, 34, 44, 0)); }
.wood-right { right: 0; background: linear-gradient(270deg, #33202a, #6b4234 55%, rgba(60, 34, 44, 0)); }
.corner {
  position: absolute; width: 16px; height: 16px; z-index: 2; opacity: .7;
  border: 1px solid rgba(243, 212, 139, .28); border-radius: 50%;
}
.corner::before {
  content: ''; position: absolute; left: 4px; top: 4px; width: 6px; height: 6px;
  background: linear-gradient(135deg, #f3d48b, #805026); transform: rotate(45deg);
}
.corner-tl { left: 16px; top: 16px; }
.corner-tr { right: 16px; top: 16px; }
.corner-bl { left: 16px; bottom: 16px; }
.corner-br { right: 16px; bottom: 16px; }

/* ---------- 2. 通用材质原语 ---------- */
/* 宝石图标：卡面右上 / 费用徽章 / 筹码中央 / 贵族需求 / 玩家资源栏同源 */
.gem-icon { background-size: 100% 100%; background-repeat: no-repeat; background-position: center; }
/* 筹码顶面：象牙白内盘 + 资源色外圈 + 左上弧高光（侧壁由各组件叠加） */
.coin-face { background-size: 100% 100%; background-repeat: no-repeat; background-position: center; }

/* ---------- 3. 顶部：对手状态 / 回合标题 / 右上入口 ---------- */
.top-bar {
  position: absolute; left: 0; top: 0; width: 1080px; height: 68px;
  z-index: 8; pointer-events: none;
}
.top-bar > view { pointer-events: auto; }
.rival-badge {
  position: absolute; left: 18px; top: 8px;
  width: 208px; height: 58px;
  display: flex; align-items: center; gap: 7px;
  padding: 4px 8px;
  background-size: 100% 100%; background-repeat: no-repeat;
  box-shadow: 0 6px 14px rgba(0, 0, 0, .6);
}
.rival-avatar {
  width: 42px; height: 46px; flex-shrink: 0;
  border: 2px solid #c5954a; border-radius: 3px;
  background-size: cover; background-position: center 22%;
  filter: brightness(1.08) saturate(1.04);
  box-shadow: inset 0 0 0 1px rgba(255, 240, 200, .35), 0 2px 6px rgba(0, 0, 0, .6);
}
.rival-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
.rival-head { display: flex; align-items: baseline; justify-content: space-between; }
.rival-name { font-size: 13px; font-weight: 700; color: #fff1d5; letter-spacing: 1px; }
.rival-score { font-size: 10px; color: #e8c489; }
.mini-tokens { display: flex; gap: 3px; }
.mini-token {
  position: relative; width: 17px; height: 17px; border-radius: 50%;
  border: 1px solid rgba(243, 212, 139, .6);
  display: flex; align-items: center; justify-content: center;
  background-color: #24141f;
  box-shadow: inset 0 1px 2px rgba(255, 255, 255, .18);
}
.mini-token text {
  position: relative; z-index: 1;
  font-family: Georgia, serif; font-size: 10px; font-weight: 700; color: #fff1d5;
  text-shadow: 0 1px 2px #000;
}
.mini-token.is-zero { opacity: .35; }
.rival-extra { display: flex; flex-direction: column; gap: 2px; font-size: 9px; color: #d8b596; }

.turn-banner {
  position: absolute; left: 380px; top: 8px; width: 320px;
  display: flex; flex-direction: column; align-items: center; gap: 2px;
}
.turn-main {
  font-family: "Songti SC", "STSong", Georgia, serif;
  font-size: 25px; font-weight: 700; letter-spacing: 5px;
  color: #ffe6ae;
  text-shadow: 0 2px 6px rgba(0, 0, 0, .85);
  animation: turnBreath 3.2s ease-in-out infinite;
}
.turn-sub { font-size: 10px; color: #e0bd96; letter-spacing: .5px; }
.turn-banner::after {
  content: ''; position: absolute; left: 0; right: 0; bottom: -8px; height: 10px;
  background-size: 100% 100%; background-repeat: no-repeat; opacity: .7;
}

.top-right { position: absolute; right: 16px; top: 8px; display: flex; align-items: center; gap: 9px; }
.gold-box { display: flex; flex-direction: column; align-items: center; gap: 2px; }
.gold-coin {
  position: relative; width: 38px; height: 38px; border-radius: 50%;
  box-shadow: 0 2px 0 #8f6f33, 0 4px 0 #5a3d1f, 0 8px 12px rgba(0, 0, 0, .6);
}
.pile-gem { position: absolute; left: 50%; top: 50%; width: 22px; height: 22px; margin-left: -11px; margin-top: -11px; }
.gold-label { font-size: 9px; color: #e8c489; }
.round-btn {
  width: 30px; height: 30px; border-radius: 50%;
  border: 1px solid #c5954a;
  background: linear-gradient(155deg, #5c3a48, #24141f 78%);
  box-shadow: inset 0 1px 0 rgba(255, 240, 200, .3), inset 0 -2px 4px rgba(0, 0, 0, .6), 0 3px 7px rgba(0, 0, 0, .55);
  display: flex; align-items: center; justify-content: center;
  font-family: Georgia, serif; font-size: 17px; color: #ffe6ae;
}
.round-btn:active { transform: translateY(1px); }

/* ---------- 4. 左侧牌库：侧转的实体牌叠 ---------- */
.left-rail { position: absolute; left: 128px; top: 88px; width: 96px; height: 346px; z-index: 4; }
/* 整组牌库落在桌布上的柔和接触投影 */
.rail-shadow {
  position: absolute; left: -14px; top: -10px; width: 132px; height: 366px;
  border-radius: 50%;
  background: radial-gradient(ellipse 60% 58% at 50% 50%, rgba(18, 8, 16, .5), transparent 78%);
}
.deck-slot { position: absolute; left: 0; width: 84px; height: 112px; }
.deck-lv-2 { top: 0; left: 12px; }
.deck-lv-1 { top: 117px; left: 6px; }
.deck-lv-0 { top: 234px; left: 0; }
.deck-stack {
  position: absolute; left: 12px; top: 4px;
  width: 58px; height: 104px;
  border-radius: 3px;
  transform: perspective(620px) rotateY(-21deg) rotateZ(4deg);
  transform-origin: 62% 50%;
  transition: transform 160ms cubic-bezier(.2, .8, .3, 1), box-shadow 160ms;
  box-shadow:
    5px 8px 14px rgba(12, 5, 12, .72),
    1px 1px 0 rgba(255, 240, 205, .18),
    inset 0 0 0 1px rgba(243, 212, 139, .5);
}
.deck-slot.deck-hover .deck-stack { transform: perspective(620px) rotateY(-16deg) rotateZ(3deg) translateX(-2px); }
.deck-face {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  border-radius: 2px;
  background-size: 100% 100%; background-repeat: no-repeat;
}
/* 右侧可见的浅色纸叠：几层卡纸 + 层间暗线 */
.deck-edges {
  position: absolute; right: -8px; top: 3px; width: 8px; height: 98px;
  z-index: 3;
  transform: skewY(-5deg);
  background: repeating-linear-gradient(180deg, #f6ead0 0px, #f6ead0 2px, #c7a880 2px, #c7a880 3px);
  border-right: 1px solid #8b6e4b;
  box-shadow: 2px 3px 7px rgba(12, 5, 12, .62);
}
.deck-stack::after {
  content: ''; position: absolute; left: 2px; right: -6px; bottom: -5px; height: 6px;
  background: repeating-linear-gradient(90deg, #efe0c2 0px, #efe0c2 3px, #b89a72 3px, #b89a72 4px);
  transform: skewX(-28deg);
  box-shadow: 0 3px 6px rgba(12, 5, 12, .6);
}
/* 左上主光在牌背形成一道斜向覆膜高光 */
.deck-sheen {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  border-radius: 2px;
  background: linear-gradient(118deg, rgba(255, 255, 255, .3) 0%, rgba(255, 255, 255, .06) 26%, transparent 50%, rgba(0, 0, 0, .34) 100%);
}
.deck-crest {
  position: absolute; left: 50%; top: 42%;
  width: 38px; height: 38px; margin-left: -19px; margin-top: -19px;
  border-radius: 50%;
  border: 1px solid rgba(255, 232, 180, .8);
  background: radial-gradient(circle at 34% 26%, rgba(24, 12, 20, .55), rgba(8, 4, 9, .86) 80%);
  box-shadow: inset 0 1px 0 rgba(255, 240, 205, .3), 0 2px 6px rgba(0, 0, 0, .66);
  display: flex; align-items: center; justify-content: center;
  z-index: 4;
}
.deck-label {
  font-family: Georgia, "Songti SC", serif; font-size: 17px; font-weight: 700;
  line-height: 1; color: #fff1d5; text-shadow: 0 1px 3px #000;
}
.deck-count {
  position: absolute; right: 4px; bottom: 8px;
  min-width: 22px; height: 18px; padding: 0 4px; border-radius: 9px;
  border: 1px solid rgba(243, 212, 139, .75);
  background: rgba(20, 10, 18, .88);
  box-shadow: 0 2px 5px rgba(0, 0, 0, .6);
  display: flex; align-items: center; justify-content: center;
  font-family: Georgia, serif; font-size: 11px; font-weight: 700; color: #ffe9bd;
  z-index: 5;
}
.deck-stack.is-empty { opacity: .42; }
.rail-hint {
  position: absolute; left: -4px; top: 350px; width: 110px;
  font-size: 9px; color: #d8b596; text-align: center; letter-spacing: .5px;
  text-shadow: 0 1px 3px rgba(0, 0, 0, .8);
}

/* ---------- 5. 中央市场：三行四列发展卡 ---------- */
.board {
  position: absolute; left: 248px; top: 88px;
  width: 540px; height: 346px;
  display: flex; flex-direction: column; justify-content: space-between;
  z-index: 5;
}
.board::before {
  content: ''; position: absolute; left: -12px; top: -10px; right: -12px; bottom: -10px;
  border: 1px solid rgba(243, 212, 139, .11); border-radius: 10px;
  background: linear-gradient(160deg, rgba(255, 232, 200, .028), rgba(20, 10, 18, .1));
  box-shadow: inset 0 3px 14px rgba(20, 8, 16, .28);
}
.card-row { position: relative; height: 112px; display: flex; justify-content: space-between; }
.row-label {
  position: absolute; left: -30px; top: 50%; margin-top: -12px;
  width: 24px; height: 24px; border-radius: 50%;
  border: 1px solid rgba(243, 212, 139, .45);
  background: rgba(24, 12, 20, .42);
  font-family: Georgia, serif; font-size: 11px; font-weight: 700;
  line-height: 22px; text-align: center; color: #f3d48b;
  box-shadow: inset 0 0 0 2px rgba(24, 12, 20, .45);
}
/* 远端行略小 5%，中端 2.5%，保持字正立与可读性 */
.card-slot {
  position: relative; width: 88px; height: 112px;
  transition: transform 150ms cubic-bezier(.2, .8, .3, 1);
  animation: cardDeal 300ms ease-out both;
}
.row-far .card-slot { transform: scale(.95); }
.row-mid .card-slot { transform: scale(.975); }
.row-near .card-slot { transform: scale(1); }
.card-slot.is-selected { transform: translateY(-5px) scale(1.03); z-index: 7; }
.card-slot.slot-hover { transform: translateY(2px) scale(.99); }

/* 纸牌：细薄边缘、左上亮边、右下暗边、短接触阴影 */
.card {
  position: relative; width: 88px; height: 112px;
  border-radius: 5px;
  border-top: 1px solid rgba(255, 252, 238, .92);
  border-left: 1px solid rgba(255, 248, 224, .8);
  border-right: 1px solid #937352;
  border-bottom: 1px solid #6b5037;
  background: #efe2c6;
  overflow: hidden;
  box-shadow:
    0 1px 0 #b99a6f,
    0 2px 0 #6f543a,
    3px 5px 9px rgba(18, 8, 16, .58),
    inset 0 0 0 1px rgba(255, 250, 232, .55);
  transition: box-shadow 150ms ease, border-color 150ms ease;
}
/* 可购买：低强度暖色细边，弱于青蓝选中态 */
.card.is-affordable {
  border-color: rgba(255, 214, 140, .85);
  box-shadow: 0 0 0 1px rgba(255, 208, 120, .5), 0 1px 0 #b99a6f, 0 2px 0 #6f543a, 3px 6px 11px rgba(18, 8, 16, .6);
}
/* 选中：细窄青蓝轮廓 + 抬升后更大更软的阴影（作用于整张卡，不遮挡自身文字） */
.card-slot.is-selected .card {
  border-color: #6fd8ef;
  box-shadow:
    0 0 0 2px #6fd8ef,
    0 0 14px rgba(111, 216, 239, .45),
    0 6px 0 #6f543a,
    8px 16px 22px rgba(12, 5, 12, .7);
}
/* 插画层与信息层分离：油画单独一层，动态数字/文字叠在其上，缩放互不干扰 */
.card-art {
  position: absolute; left: 0; right: 0; top: 0; height: 82px;
  overflow: hidden;
}
.card-photo {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background-size: cover; background-position: 42% center; background-repeat: no-repeat;
  background-color: #4a3340;
  /* 素材已在生成阶段自适应抬过暗部；运行时只做极轻的补偿 */
  filter: brightness(1.04) saturate(1.05);
}
.art-glaze {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background:
    linear-gradient(118deg, rgba(255, 255, 255, .1) 0%, rgba(255, 255, 255, .02) 24%, transparent 46%),
    linear-gradient(0deg, rgba(14, 8, 14, .72) 0%, rgba(14, 8, 14, .18) 30%, transparent 58%);
}
.card-name {
  position: absolute; left: 0; right: 0; bottom: 0; z-index: 2;
  padding: 2px 2px 3px; text-align: center;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", Georgia, serif;
  font-size: 10px; font-weight: 600; letter-spacing: .6px;
  color: #fff1d5; text-shadow: 0 1px 3px rgba(0, 0, 0, .95);
}
/* 左上声望：古典衬线斜体、暖白、深色描边 */
.card-points {
  position: absolute; left: 5px; top: 1px; z-index: 4;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 27px; font-style: italic; font-weight: 700; line-height: 1;
  color: #fff1d5;
  /* 多角度深色描边：即使插画局部是高光，分数仍一眼可辨 */
  text-shadow:
    0 0 4px #120a10, 0 0 7px #120a10,
    2px 2px 3px #120a10, -2px -2px 3px #120a10,
    2px -2px 3px #120a10, -2px 2px 3px #120a10,
    0 3px 6px rgba(0, 0, 0, .9);
}
/* 右上永久红利：切面宝石嵌在金属圆座里 */
.card-gem {
  position: absolute; right: 4px; top: 4px; z-index: 4;
  width: 22px; height: 22px; border-radius: 50%;
  border: 1px solid rgba(243, 212, 139, .9);
  background-color: #24141f;
  box-shadow: inset 0 1px 2px rgba(255, 255, 255, .28), 0 2px 5px rgba(0, 0, 0, .7);
  overflow: hidden;
}
/* 底部象牙白纸带：费用徽章为同套宝石切面 + 白色数字 */
.card-foot {
  position: absolute; left: 0; right: 0; bottom: 0; height: 30px; z-index: 4;
  display: flex; flex-wrap: wrap; align-content: center; gap: 3px; padding: 3px 4px;
  background: linear-gradient(180deg, #f7eed9, #ddc8a4);
  border-top: 1px solid rgba(146, 108, 62, .7);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .85);
}
.cost-bubble {
  position: relative; width: 19px; height: 19px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  border: 1px solid rgba(20, 10, 16, .55);
  box-shadow: inset 0 1px 2px rgba(255, 255, 255, .35), 0 1px 2px rgba(0, 0, 0, .45);
  overflow: hidden;
}
.cost-bubble text {
  position: relative; z-index: 2;
  font-family: Georgia, serif; font-size: 12px; font-weight: 700; line-height: 1;
  text-shadow: 0 1px 2px #000, 0 0 3px #000;
}
.cost-bubble.is-covered { opacity: .45; }
/* 空卡槽：桌布上的压痕，而非半透明贴纸 */
.card-empty {
  width: 88px; height: 112px; border-radius: 5px;
  border: 1px dashed rgba(243, 212, 139, .22);
  background: rgba(18, 8, 16, .2);
  box-shadow: inset 0 3px 12px rgba(0, 0, 0, .4);
}

/* ---------- 6. 公共筹码：顶面 / 环形倒角 / 可见侧壁 / 接触阴影 ---------- */
.right-rail { position: absolute; left: 800px; top: 88px; width: 264px; height: 346px; z-index: 5; }
.rail-title {
  display: block; height: 15px; line-height: 15px; white-space: nowrap;
  font-size: 8px; letter-spacing: .4px; color: #e8c489; opacity: .8;
  text-shadow: 0 1px 3px rgba(0, 0, 0, .8);
}
.pile-area { position: absolute; left: 0; top: 0; width: 92px; height: 346px; }
.pile-list { position: absolute; left: 0; top: 20px; width: 92px; height: 320px; }
.pile-item {
  position: absolute; width: 76px; height: 52px;
  display: flex; align-items: center;
  transition: transform 220ms cubic-bezier(.2, .8, .3, 1);
}
/* 单列等距，仅轻微右移错落；6 类资源始终占位，耗尽时显示 0 */
.pile-slot-5 { left: 0px;  top: 0px; }
.pile-slot-3 { left: 2px;  top: 54px; }
.pile-slot-1 { left: 4px;  top: 108px; }
.pile-slot-0 { left: 6px;  top: 162px; }
.pile-slot-2 { left: 8px;  top: 216px; }
.pile-slot-4 { left: 10px; top: 270px; }
.pile-coin {
  position: relative; width: 46px; height: 46px; border-radius: 50%;
  box-shadow:
    0 2px 0 -1px rgba(60, 38, 28, .95),
    0 4px 0 -2px rgba(48, 30, 24, .9),
    0 6px 0 -3px rgba(36, 22, 18, .85),
    0 8px 0 -4px rgba(24, 14, 14, .8),
    5px 12px 15px rgba(12, 5, 12, .72),
    inset 0 1px 0 rgba(255, 255, 255, .4);
  transition: transform 240ms cubic-bezier(.2, .8, .3, 1), box-shadow 240ms;
}
.pile-gem { width: 24px; height: 24px; margin-left: -12px; margin-top: -12px; }
.pile-count {
  position: absolute; left: 42px; top: 26px;
  min-width: 18px; height: 18px; padding: 0 4px; border-radius: 9px;
  border: 1px solid rgba(243, 212, 139, .65);
  background: rgba(20, 10, 18, .9);
  box-shadow: 0 2px 5px rgba(0, 0, 0, .6);
  display: flex; align-items: center; justify-content: center;
  font-family: Georgia, serif; font-size: 11px; font-weight: 700; color: #fff1d5;
}
.pile-name { display: none; }
/* 黄金获取规则已在规则弹层说明，这里不再占位，避免压住最后一枚筹码 */
.pile-tip { display: none; }
.pile-item.is-selected .pile-coin {
  transform: translateY(-4px);
  box-shadow:
    0 0 0 2px #6fd8ef,
    0 0 16px rgba(111, 216, 239, .5),
    0 3px 0 -1px rgba(60, 38, 28, .95),
    0 6px 0 -2px rgba(48, 30, 24, .9),
    0 9px 0 -3px rgba(36, 22, 18, .85),
    7px 16px 20px rgba(12, 5, 12, .75);
}
.pile-item.pile-hover .pile-coin { transform: translateY(2px); }
.pile-item.is-disabled { opacity: .4; }
.pile-item.is-gold.is-disabled { opacity: .78; }

/* ---------- 7. 贵族肖像 ---------- */
.noble-area { position: absolute; left: 120px; top: 0; width: 96px; height: 346px; }
.noble-row { position: absolute; left: 0; top: 20px; display: flex; flex-direction: column; gap: 7px; }
.noble {
  position: relative; width: 90px; height: 100px;
  border-radius: 4px;
  border: 1px solid #c5954a;
  background: linear-gradient(160deg, #3a2530, #1c1018);
  box-shadow:
    0 1px 0 #8f6f33, 0 3px 0 #4a3018,
    4px 7px 12px rgba(12, 5, 12, .66),
    inset 0 0 0 1px rgba(255, 240, 200, .16);
  overflow: hidden;
  animation: nobleIn 420ms ease-out both;
}
.noble-face {
  position: absolute; left: 3px; right: 3px; top: 3px; height: 67px;
  border: 1px solid rgba(60, 34, 26, .6);
  overflow: hidden;
}
.noble-photo {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background-size: cover; background-position: center 24%; background-repeat: no-repeat;
  background-color: #3a2530;
  filter: brightness(1.06) saturate(1.05);
}
.noble-face::after {
  content: ''; position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background: radial-gradient(ellipse 76% 82% at 50% 38%, transparent 34%, rgba(12, 6, 12, .55) 100%);
}
.noble-points {
  position: absolute; right: 4px; bottom: 8px; z-index: 3;
  width: 21px; height: 21px; border-radius: 50%;
  border: 1px solid #fff0c0;
  background: radial-gradient(circle at 36% 26%, #ffe9a8, #c5954a 72%, #805026);
  display: flex; align-items: center; justify-content: center;
  font-family: Georgia, serif; font-size: 14px; font-weight: 700; color: #3b2208;
  box-shadow: 0 2px 4px rgba(0, 0, 0, .6);
}
.noble-title { display: none; }
.noble-reqs { position: absolute; left: 4px; bottom: 8px; z-index: 3; display: flex; gap: 3px; }
.noble-req {
  position: relative; width: 16px; height: 16px; border-radius: 50%;
  border: 1px solid rgba(243, 212, 139, .5);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 1px 2px rgba(0, 0, 0, .55);
}
.noble-req text {
  position: relative; z-index: 2;
  font-family: Georgia, serif; font-size: 9px; font-weight: 700; color: #fff1d5;
  text-shadow: 0 1px 2px #000, 0 0 3px #000;
}
.noble-none { font-size: 11px; color: #d8b596; }

/* ---------- 8. 底部玩家工作台 ---------- */
.tray { position: absolute; left: 100px; top: 430px; width: 950px; height: 130px; z-index: 9; }
.tray-rim {
  position: absolute; left: 0; top: 0; width: 950px; height: 130px;
  background-size: 100% 100%; background-repeat: no-repeat;
}
/* 深皮革底托的织物/斜向反光，避免凹陷区成为死黑 */
.tray-rim::after {
  content: ''; position: absolute; left: 0; top: 60px; right: 0; bottom: 0;
  background:
    repeating-linear-gradient(90deg, rgba(255, 235, 200, .018) 0px, rgba(255, 235, 200, .018) 1px, transparent 1px, transparent 6px),
    repeating-linear-gradient(0deg, rgba(0, 0, 0, .09) 0px, rgba(0, 0, 0, .09) 1px, transparent 1px, transparent 4px),
    linear-gradient(105deg, transparent 20%, rgba(255, 220, 170, .045) 46%, transparent 72%);
}
.tray-left { position: absolute; left: 12px; top: -10px; width: 220px; height: 122px; display: flex; align-items: flex-end; gap: 10px; z-index: 3; }
/* 金属相框：内侧高光 / 暖金主体 / 外侧棕金暗边 */
.portrait-frame {
  position: relative; width: 76px; height: 90px; flex-shrink: 0;
  border: 3px solid #c5954a; border-radius: 4px;
  background: linear-gradient(150deg, #e8c47a, #805026);
  box-shadow:
    inset 0 1px 0 rgba(255, 245, 210, .8),
    inset 0 -2px 0 rgba(90, 52, 20, .8),
    0 2px 0 #5a3718, 0 8px 18px rgba(0, 0, 0, .78);
}
.portrait {
  position: absolute; left: 2px; top: 2px; right: 2px; bottom: 2px;
  border: 1px solid rgba(20, 10, 16, .65);
  background-size: cover; background-position: center 20%; background-repeat: no-repeat;
  filter: brightness(1.08) saturate(1.04);
  box-shadow: inset 0 0 12px rgba(0, 0, 0, .5);
}
.portrait-gem {
  position: absolute; right: -10px; bottom: -7px;
  width: 25px; height: 25px; transform: rotate(45deg);
  border: 2px solid #eaffd0;
  background: linear-gradient(135deg, #b9ff8f, #2fa84a 55%, #0c5223);
  box-shadow: 0 3px 9px rgba(0, 0, 0, .75), inset 0 0 7px rgba(255, 255, 255, .5);
}
.portrait-gem::after {
  content: ''; position: absolute; left: 22%; top: 18%; width: 56%; height: 44%;
  border-radius: 50%; background: rgba(255, 255, 255, .4);
}
.player-badges { display: flex; flex-direction: column; gap: 5px; margin-bottom: 6px; }
.score-disc, .vault-total {
  border-radius: 50%;
  border: 2px solid rgba(240, 205, 140, .82);
  background: radial-gradient(circle at 36% 26%, #5c3a48, #150b13 80%);
  box-shadow: inset 0 1px 0 rgba(255, 235, 190, .28), 0 3px 7px rgba(0, 0, 0, .7);
  display: flex; align-items: baseline; justify-content: center;
}
.score-disc { width: 46px; height: 46px; padding-top: 9px; }
.score-num { font-family: Georgia, serif; font-size: 21px; font-weight: 700; color: #ffe3a6; line-height: 1; }
.score-den { font-size: 9px; color: #c9a279; }
.tray-reserved {
  width: 46px; padding: 3px 0; border-radius: 6px;
  border: 1px solid rgba(240, 205, 140, .5);
  background: rgba(20, 10, 18, .72);
  display: flex; flex-direction: column; align-items: center;
}
.tray-reserved-num { font-family: Georgia, serif; font-size: 16px; font-weight: 700; color: #f6d9a2; line-height: 1.1; }
.tray-reserved-label { font-size: 8px; color: #d1ac8b; }

.tray-vault { position: absolute; left: 296px; top: 16px; width: 430px; height: 100px; z-index: 3; }
.vault-total { position: absolute; left: -54px; top: 36px; width: 42px; height: 42px; padding-top: 8px; }
.vault-total-num { font-family: Georgia, serif; font-size: 19px; font-weight: 700; color: #ffe3a6; line-height: 1; }
.vault-total-den { font-size: 9px; color: #c9a279; }
.vault-groups { display: flex; flex-direction: column; gap: 7px; }
.vault-group { display: flex; align-items: center; gap: 7px; }
.vault-label { width: 52px; flex-shrink: 0; font-size: 9px; color: #d8b596; letter-spacing: .5px; text-align: right; }
.vault-row { display: flex; gap: 5px; align-items: center; }
/* 永久红利：小型卡片图标（圆角矩形），与持有筹码的圆形嵌槽明确区分 */
.disc-chip {
  position: relative; width: 19px; height: 24px; border-radius: 3px;
  border: 1px solid rgba(243, 212, 139, .55);
  display: flex; align-items: center; justify-content: center;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .22), 0 2px 4px rgba(0, 0, 0, .6);
}
.disc-chip text {
  position: relative; z-index: 2;
  font-family: Georgia, serif; font-size: 11px; font-weight: 700; color: #fff1d5;
  text-shadow: 0 1px 2px #000, 0 0 3px #000;
}
.disc-empty { font-size: 9px; color: #9c7f80; }
/* 持有筹码：深色内凹嵌槽 + 宝石小图标 + 斜体衬线数字 */
.vault-token {
  position: relative; width: 44px; height: 34px; border-radius: 7px;
  border: 1px solid rgba(243, 212, 139, .28);
  background: linear-gradient(180deg, rgba(74, 54, 66, .95), rgba(12, 7, 13, .97));
  box-shadow: inset 0 2px 0 rgba(255, 240, 205, .14), inset 0 -7px 11px rgba(0, 0, 0, .7), 0 2px 5px rgba(0, 0, 0, .6);
  overflow: hidden;
  transition: transform 120ms ease;
}
.vault-token::after {
  content: ''; position: absolute; left: 12%; top: 6%; width: 62%; height: 30%;
  border-radius: 50%; background: linear-gradient(180deg, rgba(255, 255, 255, .13), transparent);
}
.vault-token-icon { position: absolute; left: 3px; top: 5px; width: 20px; height: 20px; opacity: .9; }
.vault-token-num {
  position: absolute; right: 4px; top: 5px; z-index: 2;
  font-family: Georgia, serif; font-style: italic; font-size: 20px; font-weight: 700; line-height: 1;
  color: #fff1d5; text-shadow: 0 2px 3px rgba(0, 0, 0, .95), 0 0 8px rgba(255, 255, 255, .2);
}
.vault-token.is-zero { opacity: .38; }
.vault-token.can-discard { border: 2px solid #ff9a6a; animation: vaultPulse 1.2s infinite; }
.vault-token.vault-hover { transform: translateY(2px); }

.tray-right { position: absolute; right: 12px; top: 56px; width: 220px; height: 68px; display: flex; flex-direction: column; gap: 6px; z-index: 3; }
.hint {
  height: 16px; line-height: 16px; font-size: 10px; color: #e3c69c;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.hint-warn { color: #ffb47a; }
.btn-row { display: flex; gap: 5px; justify-content: flex-end; }
.btn {
  padding: 6px 9px; border-radius: 6px; font-size: 10px;
  border: 1px solid #c5954a;
  background: linear-gradient(180deg, #5c3a48, #24141f);
  color: #f6e2bd;
  box-shadow: inset 0 1px 0 rgba(255, 240, 205, .24), inset 0 -2px 0 rgba(0, 0, 0, .5), 0 3px 7px rgba(0, 0, 0, .55);
  transition: transform 100ms ease, box-shadow 100ms ease;
}
.btn:active { transform: translateY(2px); box-shadow: inset 0 1px 0 rgba(255, 240, 205, .2); }
.btn-primary {
  border-color: #ffe6ae;
  background: linear-gradient(180deg, #f6d18a, #d7a24a 44%, #a97124);
  color: #301a08;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .6), 0 3px 8px rgba(0, 0, 0, .5);
}
.btn-off { opacity: .5; }

/* ---------- 9. 弹层 ---------- */
.overlay {
  position: absolute; left: 0; top: 0; width: 1080px; height: 560px;
  background: rgba(10, 4, 10, .72);
  display: flex; align-items: center; justify-content: center;
  z-index: 20;
  animation: fadeIn 160ms ease-out both;
}
.overlay-top { z-index: 30; }
.dialog {
  position: relative; border: 1px solid #c5954a; border-radius: 12px;
  background:
    repeating-linear-gradient(45deg, rgba(255, 230, 200, .012) 0px, rgba(255, 230, 200, .012) 1px, transparent 1px, transparent 6px),
    linear-gradient(160deg, #4d2b3c, #23121d);
  box-shadow: inset 0 0 0 3px rgba(12, 5, 11, .34), inset 0 0 0 4px rgba(243, 212, 139, .18), 0 24px 70px rgba(0, 0, 0, .8);
  padding: 18px 22px;
  animation: dialogIn 180ms cubic-bezier(.2, .8, .3, 1) both;
}
.dialog-head { display: flex; flex-direction: column; gap: 5px; margin-bottom: 14px; padding-bottom: 11px; border-bottom: 1px solid rgba(226, 183, 106, .34); }
.dialog-title { font-family: "Songti SC", "STSong", Georgia, serif; font-size: 23px; font-weight: 700; color: #ffe0a4; letter-spacing: 2px; }
.dialog-sub { font-size: 12px; color: #d4b096; }
.dialog-btns { display: flex; gap: 10px; justify-content: flex-end; margin-top: 16px; }

.detail-dialog { width: 700px; }
.detail-body { display: flex; gap: 20px; align-items: flex-start; }
/* 详情卡适度放大 2~4% 的观感，完整展示插画与费用 */
.card-big {
  width: 150px; height: 204px; flex-shrink: 0; transform: scale(1.02);
  /* 详情即选中态：细窄青蓝轮廓与桌面上的选中卡保持一致 */
  border-color: #6fd8ef;
  box-shadow: 0 0 0 2px #6fd8ef, 0 0 16px rgba(111, 216, 239, .35),
    0 4px 0 #6f543a, 9px 18px 26px rgba(12, 5, 12, .75);
}
.card-big .card-art { height: 150px; }
.card-big .card-foot { height: 54px; padding: 5px; gap: 5px; }
.card-big .card-name { font-size: 14px; bottom: 3px; }
.card-big .card-points { font-size: 40px; left: 8px; }
.card-big .card-gem { width: 32px; height: 32px; right: 8px; top: 8px; }
.card-big .cost-bubble { width: 28px; height: 28px; }
.card-big .cost-bubble text { font-size: 16px; }
.detail-info { flex: 1; display: flex; flex-direction: column; gap: 9px; }
.detail-section { font-size: 12px; color: #f0ce8e; font-weight: 600; letter-spacing: 1px; }
.cost-line { display: flex; align-items: center; gap: 8px; }
.cost-line-dot { width: 17px; height: 17px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, .4); }
.cost-line.is-missing .cost-line-num { color: #ffb0a6; }
.cost-line-label { font-size: 12px; color: #f5e1bd; width: 58px; }
.cost-line-num { font-size: 12px; color: #d4b096; }
.detail-summary { font-size: 14px; font-weight: 700; margin-top: 6px; }
.detail-summary.ok { color: #9fe4b4; }
.detail-summary.no { color: #ffb0a6; }
.detail-note { font-size: 11px; color: #bb9aaa; line-height: 1.7; }

.reserved-dialog { width: 620px; }
.reserved-list { display: flex; gap: 14px; min-height: 168px; align-items: flex-start; flex-wrap: wrap; }
.card-small { width: 110px; height: 150px; }
.card-small .card-art { height: 106px; }
.card-small .card-foot { height: 44px; }
.card-small .card-points { font-size: 30px; }
.card-small .card-gem { width: 25px; height: 25px; }
.card-small .cost-bubble { width: 22px; height: 22px; }
.card-small .cost-bubble text { font-size: 13px; }
.card-small .card-name { font-size: 12px; }
.empty-tip { font-size: 13px; color: #c8a4b0; line-height: 1.7; }

.rules-dialog { width: 720px; }
.rules-body { display: flex; flex-direction: column; gap: 9px; }
.rule-item { font-size: 13px; color: #f2e0c6; line-height: 1.6; }
.rule-note { font-size: 11px; color: #bb9aaa; margin-top: 6px; line-height: 1.6; }

.result-dialog { width: 460px; display: flex; flex-direction: column; align-items: center; gap: 12px; }
.result-crown { font-size: 46px; color: #ffd47b; text-shadow: 0 0 24px rgba(255, 200, 100, .7); }
.result-title { font-family: "Songti SC", "STSong", Georgia, serif; font-size: 36px; font-weight: 700; letter-spacing: 4px; color: #ffe0a4; text-shadow: 0 3px 10px rgba(0, 0, 0, .8); }
.result-detail { font-size: 14px; color: #e0bd96; }
.result-dialog .dialog-btns { justify-content: center; }

/* ---------- 10. 动效：拿起 / 放下 / 补牌 / 到访 ---------- */
@keyframes cardDeal {
  0% { opacity: .35; }
  100% { opacity: 1; }
}
@keyframes coinLift {
  0% { transform: translateY(0); }
  100% { transform: translateY(-4px); }
}
@keyframes nobleIn {
  0% { opacity: 0; transform: translateY(-8px); }
  100% { opacity: 1; transform: translateY(0); }
}
@keyframes fadeIn { 0% { opacity: 0; } 100% { opacity: 1; } }
@keyframes dialogIn {
  0% { opacity: 0; transform: translateY(10px) scale(.98); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes turnBreath { 0%, 100% { opacity: .88; } 50% { opacity: 1; } }
@keyframes vaultPulse {
  0% { box-shadow: 0 0 0 0 rgba(255, 154, 106, .7); }
  70% { box-shadow: 0 0 0 8px rgba(255, 154, 106, 0); }
  100% { box-shadow: 0 0 0 0 rgba(255, 154, 106, 0); }
}

/* ---------- 11. 多人房间版：席位条 / 大厅 / 玩家详情 / 资料 ----------
   统一材质：深紫棕皮革 + 三层暖金倒角 + 左上柔光，与既有弹层同源。
   席位条占据原单对手徽章的位置（左 16px / 宽 352px），不与回合横幅相交。 */
.seat-strip { position: absolute; left: 16px; top: 8px; width: 352px; display: flex; gap: 6px; }
.seat-badge {
  position: relative; width: 112px; flex: 0 0 112px; height: 54px;
  display: flex; align-items: center; gap: 6px; padding: 4px 6px;
  border-radius: 6px; overflow: hidden;
  border: 1px solid rgba(197, 149, 74, .55);
  background: linear-gradient(155deg, #5c3a48 0%, #2a1724 62%, #1b0f19 100%);
  box-shadow: inset 0 1px 0 rgba(255, 240, 200, .28), inset 0 -3px 6px rgba(0, 0, 0, .55), 0 5px 12px rgba(0, 0, 0, .6);
}
.seat-badge.is-current {
  border-color: #69d7e8;
  box-shadow: inset 0 1px 0 rgba(255, 240, 200, .3), 0 0 0 1px rgba(105, 215, 232, .55), 0 5px 14px rgba(0, 0, 0, .65);
}
.seat-badge.is-bot { opacity: .94; }
.seat-badge.is-empty { opacity: .6; }
.seat-hover { transform: translateY(1px); }
.seat-avatar {
  width: 34px; height: 38px; flex-shrink: 0; border-radius: 3px;
  border: 2px solid #c5954a; overflow: hidden;
  display: flex; align-items: center; justify-content: center;
  box-shadow: inset 0 0 0 1px rgba(255, 240, 200, .35), 0 2px 6px rgba(0, 0, 0, .6);
}
.seat-avatar-img { width: 100%; height: 100%; }
.seat-avatar-initial { font-family: Georgia, serif; font-size: 15px; color: #fff1d5; text-shadow: 0 1px 3px #1a0d14; }
.seat-meta { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
.seat-name {
  font-size: 11px; font-weight: 700; color: #fff1d5; letter-spacing: .5px;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.seat-sub { font-size: 8px; color: #d8b596; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.seat-stats { position: absolute; right: 5px; bottom: 2px; display: flex; gap: 5px; font-size: 7px; color: #a8897c; }
.room-btn { font-size: 15px; }
.portrait-hover { transform: translateY(2px); }

/* 房间大厅 */
.lobby-dialog { width: 760px; }
.lobby-body { display: flex; flex-direction: column; gap: 12px; }
.lobby-section { display: flex; flex-direction: column; gap: 7px; }
.lobby-label { font-size: 12px; font-weight: 600; color: #f0ce8e; letter-spacing: 1px; }
.count-row { display: flex; gap: 8px; }
.count-btn {
  min-width: 82px; padding: 6px 14px; border-radius: 5px; text-align: center;
  font-size: 13px; color: #e8d0b2; border: 1px solid rgba(197, 149, 74, .5);
  background: linear-gradient(160deg, #4a2c3a, #22121d);
  box-shadow: inset 0 1px 0 rgba(255, 240, 200, .18);
}
.count-btn.is-active {
  color: #1b1020; font-weight: 700; border-color: #f3d48b;
  background: linear-gradient(160deg, #f3d48b, #c5954a);
}
.seat-setup { display: flex; gap: 8px; }
.setup-seat {
  flex: 1; min-width: 0; padding: 8px; border-radius: 6px;
  border: 1px solid rgba(197, 149, 74, .34);
  background: rgba(24, 12, 20, .6);
  display: flex; flex-direction: column; align-items: flex-start; gap: 4px;
}
.setup-avatar { width: 30px; height: 32px; border-radius: 3px; border: 1px solid #c5954a; }
.setup-label { font-size: 10px; color: #e8c489; }
.setup-name { font-size: 11px; color: #fff1d5; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.setup-toggle {
  margin-top: 3px; padding: 3px 6px; border-radius: 4px; font-size: 9px;
  color: #cfe9ec; border: 1px solid rgba(105, 215, 232, .5); background: rgba(22, 48, 56, .5);
}
.setup-toggle.is-bot { color: #f2d7a4; border-color: rgba(243, 212, 139, .5); background: rgba(62, 42, 20, .5); }
.setup-host { margin-top: 3px; font-size: 9px; color: #a8897c; }
.invite-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
/* button 走 open-type="share"，需去掉原生默认样式才能与 .btn 一致 */
.share-btn {
  margin: 0; min-height: 0; line-height: 1.5;
  display: inline-flex; align-items: center; justify-content: center;
}
.share-btn::after { border: none; }
.room-code {
  font-family: Georgia, serif; font-size: 22px; font-weight: 700; letter-spacing: 5px;
  color: #ffe0a4; padding: 2px 10px; border-radius: 4px;
  border: 1px dashed rgba(243, 212, 139, .7); background: rgba(24, 12, 20, .7);
}
.invite-tip { font-size: 10px; color: #c8a68c; }
.join-row { display: flex; gap: 8px; align-items: center; }
.room-input, .profile-input {
  height: 32px; padding: 0 10px; border-radius: 5px; font-size: 13px; color: #fff1d5;
  border: 1px solid rgba(197, 149, 74, .55);
  background: rgba(14, 7, 12, .8);
  box-shadow: inset 0 2px 5px rgba(0, 0, 0, .6);
}
.room-input { width: 190px; letter-spacing: 2px; }
.room-hint, .profile-note { font-size: 10px; color: #b99884; line-height: 1.6; }
.room-notice { font-size: 11px; color: #9fe0ea; }

/* 玩家详情 */
.player-dialog { width: 780px; }
.player-body { display: flex; gap: 18px; }
.player-left { width: 260px; flex: 0 0 260px; display: flex; flex-direction: column; gap: 7px; }
.player-right { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 7px; }
.player-avatar {
  width: 66px; height: 72px; border-radius: 4px; overflow: hidden;
  border: 2px solid #c5954a;
  box-shadow: inset 0 0 0 1px rgba(255, 240, 200, .35), 0 4px 12px rgba(0, 0, 0, .6);
}
.player-avatar-img { width: 100%; height: 100%; }
.player-score { font-family: Georgia, serif; font-size: 20px; font-weight: 700; color: #ffe0a4; }
.player-mini { font-size: 10px; color: #c8a68c; }
.score-line {
  display: flex; justify-content: space-between; font-size: 12px; color: #e8d0b2;
  padding: 4px 8px; border-radius: 4px; background: rgba(24, 12, 20, .55);
}
.player-chips { display: flex; flex-wrap: wrap; gap: 5px; align-items: center; }
.player-chips .disc-chip.is-zero { opacity: .35; }
.pd-list { display: flex; flex-direction: column; gap: 6px; }
.pd-card {
  display: flex; align-items: center; gap: 8px; padding: 5px 8px; border-radius: 5px;
  border: 1px solid rgba(197, 149, 74, .28); background: rgba(24, 12, 20, .55);
}
.pd-card-art { position: relative; width: 52px; height: 40px; flex-shrink: 0; border-radius: 3px; overflow: hidden; border: 1px solid rgba(243, 212, 139, .4); }
.pd-card-art .card-photo { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-size: cover; background-position: center; }
.pd-card-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.pd-card-name { font-size: 12px; color: #fff1d5; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pd-card-sub { font-size: 9px; color: #c8a68c; }
.pd-card-gem { width: 20px; height: 20px; flex-shrink: 0; }
.pd-noble {
  display: flex; align-items: center; gap: 8px; padding: 5px 8px; border-radius: 5px;
  border: 1px solid rgba(197, 149, 74, .28); background: rgba(24, 12, 20, .55);
}
.pd-noble-title { flex: 1; font-size: 12px; color: #fff1d5; }
.pd-noble-points { font-family: Georgia, serif; font-size: 14px; font-weight: 700; color: #ffe0a4; }
.pd-noble-reqs { display: flex; gap: 4px; }

/* 玩家资料 */
.profile-dialog { width: 640px; }
.profile-body { display: flex; flex-direction: column; gap: 9px; }
.profile-current { display: flex; align-items: center; gap: 12px; padding: 8px 10px; border-radius: 6px; background: rgba(24, 12, 20, .6); border: 1px solid rgba(197, 149, 74, .3); }
.profile-avatar { width: 54px; height: 60px; flex-shrink: 0; border-radius: 4px; overflow: hidden; border: 2px solid #c5954a; }
.profile-avatar-img { width: 100%; height: 100%; }
.profile-avatar-preset { background: radial-gradient(circle at 32% 24%, rgba(255, 240, 210, .55), #c98a4b 52%, rgba(20, 10, 16, .92) 100%); }
.profile-current-text { display: flex; flex-direction: column; gap: 4px; }
.profile-nickname { font-family: "Songti SC", Georgia, serif; font-size: 19px; font-weight: 700; color: #ffe0a4; }
.profile-avatar-name { font-size: 10px; color: #c8a68c; }
.profile-input-row { display: flex; gap: 8px; align-items: center; }
.profile-input { flex: 1; }
.native-avatar-btn {
  height: 32px; padding: 0 10px; border-radius: 5px; font-size: 11px; line-height: 30px;
  color: #1b1020; border: 1px solid #f3d48b;
  background: linear-gradient(160deg, #f3d48b, #c5954a);
}
.native-avatar-btn::after { border: none; }
.preset-nicknames { display: flex; gap: 6px; flex-wrap: wrap; }
.preset-nick {
  padding: 3px 8px; border-radius: 12px; font-size: 10px; color: #d8b596;
  border: 1px solid rgba(197, 149, 74, .4); background: rgba(24, 12, 20, .55);
}
.preset-avatars { display: flex; gap: 6px; flex-wrap: wrap; }
.preset-avatar {
  width: 68px; height: 46px; border-radius: 4px; overflow: hidden;
  border: 1px solid rgba(197, 149, 74, .5);
  display: flex; align-items: flex-end; justify-content: center; padding-bottom: 3px;
}
.preset-avatar text { font-size: 8px; color: #fff1d5; text-shadow: 0 1px 3px #000; }
.preset-avatar.is-active { border: 2px solid #69d7e8; box-shadow: 0 0 0 1px rgba(105, 215, 232, .5); }

/* ---------- 12. 入口界面 / 房间界面 ----------
   与牌桌同源材质：深紫棕皮革 + 暖金倒角 + 左上柔光；
   入口页只保留「人机对战 / 邀请好友」两条主路径，其余入口收敛到底部。 */
.board-layer {
  position: absolute; left: 0; top: 0; width: 1080px; height: 560px;
}
.screen-layer {
  position: absolute; left: 0; top: 0; width: 1080px; height: 560px;
  box-sizing: border-box; z-index: 12;
}

/* 首页 */
.home-screen {
  display: flex; align-items: stretch; gap: 26px;
  padding: 38px 44px 26px;
  background:
    radial-gradient(ellipse 66% 58% at 26% 26%, rgba(255, 224, 190, .08), transparent 68%),
    linear-gradient(162deg, rgba(24, 10, 20, .34), rgba(16, 7, 14, .62));
}
.home-brand {
  flex: 0 0 320px; display: flex; flex-direction: column; align-items: flex-start;
  padding-top: 10px;
}
.brand-crest {
  width: 62px; height: 62px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  border: 1px solid rgba(243, 212, 139, .55);
  background: radial-gradient(circle at 34% 24%, #ffeec4 0%, #e2b268 34%, #a97124 68%, #4d2c12 100%);
  box-shadow: inset 0 2px 0 rgba(255, 255, 255, .55), inset 0 -3px 8px rgba(60, 30, 8, .6), 0 8px 20px rgba(0, 0, 0, .6);
  margin-bottom: 16px;
}
.brand-gem { width: 30px; height: 30px; }
.brand-title {
  font-family: "Songti SC", "STSong", Georgia, serif;
  font-size: 44px; font-weight: 700; letter-spacing: 9px;
  color: #ffe6b8; text-shadow: 0 4px 16px rgba(0, 0, 0, .78), 0 1px 0 rgba(255, 240, 200, .25);
}
.brand-en { font-size: 11px; letter-spacing: 7px; color: rgba(243, 212, 139, .66); margin-top: 3px; }
.brand-rule {
  width: 100%; height: 1px; margin: 17px 0 13px;
  background: linear-gradient(90deg, rgba(243, 212, 139, .75), rgba(243, 212, 139, .05));
}
.brand-desc { font-size: 12px; line-height: 1.95; color: #dcc0b2; }
.brand-meta { font-size: 10px; letter-spacing: 1px; color: rgba(243, 212, 139, .72); margin-top: 12px; }
.brand-player {
  margin-top: auto; width: 100%; box-sizing: border-box;
  display: flex; align-items: center; gap: 10px; padding: 8px 10px;
  border-radius: 8px; border: 1px solid rgba(197, 149, 74, .4);
  background: rgba(24, 12, 20, .55);
  box-shadow: inset 0 1px 0 rgba(255, 240, 205, .14);
}
.brand-player-hover { transform: translateY(1px); }
.brand-avatar {
  width: 40px; height: 44px; flex-shrink: 0; border-radius: 4px; overflow: hidden;
  border: 2px solid #c5954a;
  box-shadow: inset 0 0 0 1px rgba(255, 240, 200, .32), 0 3px 8px rgba(0, 0, 0, .6);
}
.brand-avatar-img { width: 100%; height: 100%; }
.brand-player-text { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
.brand-player-name { font-size: 13px; font-weight: 700; color: #fff1d5; }
.brand-player-sub { font-size: 9px; color: #b99884; }

.home-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
.home-choices { display: flex; gap: 18px; flex: 1; min-height: 0; }
.choice {
  position: relative; flex: 1; min-width: 0;
  display: flex; flex-direction: column; align-items: flex-start; justify-content: center;
  padding: 18px 20px; border-radius: 12px;
  border: 1px solid rgba(197, 149, 74, .45);
  background:
    repeating-linear-gradient(45deg, rgba(255, 230, 200, .014) 0px, rgba(255, 230, 200, .014) 1px, transparent 1px, transparent 6px),
    linear-gradient(158deg, #55303f 0%, #2c1723 62%, #1d0f18 100%);
  box-shadow:
    inset 0 0 0 1px rgba(12, 5, 11, .35), inset 0 1px 0 rgba(255, 225, 180, .16),
    0 14px 34px rgba(0, 0, 0, .58);
}
.choice-room {
  background:
    repeating-linear-gradient(45deg, rgba(255, 230, 200, .014) 0px, rgba(255, 230, 200, .014) 1px, transparent 1px, transparent 6px),
    linear-gradient(158deg, #4b3242 0%, #271a26 62%, #180f18 100%);
}
.choice-tag {
  font-size: 9px; letter-spacing: 3px; color: #f0ce8e;
  padding: 3px 8px; border-radius: 3px; border: 1px solid rgba(243, 212, 139, .42);
}
.choice-tag-gold {
  color: #1b1020; border-color: #f3d48b;
  background: linear-gradient(160deg, #f3d48b, #c5954a);
}
.choice-title {
  font-family: "Songti SC", "STSong", Georgia, serif;
  font-size: 29px; font-weight: 700; letter-spacing: 4px; color: #ffe6b8;
  margin-top: 12px; text-shadow: 0 3px 10px rgba(0, 0, 0, .7);
}
.choice-desc { font-size: 12px; line-height: 1.75; color: #cfae9f; margin-top: 7px; min-height: 42px; }
.choice-points { display: flex; flex-direction: column; gap: 5px; margin-top: 12px; }
.choice-point { font-size: 11px; color: #b99884; }
.choice-point::before { content: '·'; margin-right: 6px; color: #c5954a; }
.choice-counts { display: flex; gap: 7px; margin-top: 18px; }
.count-chip {
  min-width: 60px; padding: 6px 10px; border-radius: 5px; text-align: center;
  font-size: 12px; color: #e8d0b2; border: 1px solid rgba(197, 149, 74, .45);
  background: linear-gradient(160deg, #4a2c3a, #22121d);
  box-shadow: inset 0 1px 0 rgba(255, 240, 200, .16);
}
.count-chip.is-active {
  color: #1b1020; font-weight: 700; border-color: #f3d48b;
  background: linear-gradient(160deg, #f3d48b, #c5954a);
}
.choice-btn {
  margin-top: 16px; width: 100%; box-sizing: border-box;
  text-align: center; font-size: 15px; font-weight: 700; letter-spacing: 3px;
  padding: 10px 0; border-radius: 7px;
}
.home-foot { display: flex; flex-direction: column; gap: 7px; }
.home-join { display: flex; align-items: center; gap: 9px; }
.home-input { width: 208px; }
.home-cloud { font-size: 10px; letter-spacing: .5px; color: #c6a596; }
.home-cloud.is-cloud { color: #9fe4b4; }

/* 房间界面 */
.room-screen {
  display: flex; flex-direction: column; gap: 13px;
  padding: 24px 40px 22px;
  background: linear-gradient(170deg, rgba(24, 10, 20, .56), rgba(14, 6, 12, .78));
}
.room-top { display: flex; align-items: center; gap: 22px; }
.room-code-block { display: flex; flex-direction: column; gap: 2px; flex: 0 0 auto; }
.room-code-label { font-size: 9px; letter-spacing: 3px; color: rgba(243, 212, 139, .72); }
.room-code-big {
  font-family: Georgia, serif; font-size: 32px; font-weight: 700; letter-spacing: 6px;
  color: #ffe6b8; text-shadow: 0 3px 12px rgba(0, 0, 0, .75);
}
.room-backend { font-size: 9px; color: #9fe4b4; letter-spacing: 1px; }
.room-status-block { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
.room-status-main { font-size: 18px; font-weight: 700; letter-spacing: 1px; color: #ffe0a4; }
.room-status-sub { font-size: 10px; line-height: 1.6; color: #c6a596; }
.room-leave { flex: 0 0 auto; font-size: 12px; padding: 8px 14px; }

.room-seat-row { display: flex; gap: 12px; flex: 0 0 auto; height: 262px; }
.room-seat {
  flex: 1; min-width: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 7px;
  padding: 16px 10px 14px; border-radius: 10px;
  border: 1px solid rgba(197, 149, 74, .4);
  background: linear-gradient(160deg, #4b2a3a, #241320);
  box-shadow: inset 0 1px 0 rgba(255, 240, 205, .14), 0 10px 24px rgba(0, 0, 0, .5);
}
.room-seat.is-self { background: linear-gradient(160deg, #5d3446, #2b1725); }
.room-seat.is-ready {
  border-color: rgba(120, 214, 156, .65);
  box-shadow: inset 0 1px 0 rgba(255, 240, 205, .16),
    0 0 0 1px rgba(120, 214, 156, .22), 0 0 18px rgba(80, 190, 130, .18), 0 10px 24px rgba(0, 0, 0, .5);
}
.room-seat.is-empty { border-style: dashed; opacity: .78; }
.room-avatar {
  width: 60px; height: 60px; flex-shrink: 0; border-radius: 50%; overflow: hidden;
  display: flex; align-items: center; justify-content: center;
  border: 2px solid #c5954a;
  box-shadow: inset 0 0 0 1px rgba(255, 240, 200, .3), 0 4px 12px rgba(0, 0, 0, .6);
}
.room-avatar-img { width: 100%; height: 100%; }
.room-avatar-no { font-family: Georgia, serif; font-size: 22px; color: #fff1d5; text-shadow: 0 1px 4px #1a0d14; }
.room-seat-label { font-size: 9px; letter-spacing: 2px; color: #e8c489; }
.room-seat-name {
  max-width: 100%; font-size: 14px; font-weight: 700; color: #fff1d5;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.room-seat-state {
  margin-top: 6px; padding: 4px 11px; border-radius: 20px;
  font-size: 10px; color: #d4b096;
  border: 1px solid rgba(197, 149, 74, .38);
}
.room-seat-state.is-ok { color: #9fe4b4; border-color: rgba(120, 214, 156, .55); background: rgba(46, 106, 72, .22); }
.room-seat-state.is-pending { color: #ffcf8a; border-color: rgba(243, 180, 90, .55); background: rgba(110, 72, 26, .22); }
.room-seat-state.is-wait { color: #b79aa6; }
.room-seat-action { font-size: 10px; color: #f0ce8e; padding: 2px 6px; text-decoration: underline; }

.room-bottom { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
.room-invite { display: flex; align-items: center; gap: 10px; }
.room-counts { display: flex; align-items: center; gap: 8px; }
.room-counts-label { font-size: 10px; letter-spacing: 2px; color: #e8c489; }
.room-tip { font-size: 11px; letter-spacing: .5px; color: #c6a596; }
.room-tip.is-ok { color: #9fe4b4; }
.room-actions { display: flex; align-items: center; justify-content: space-between; margin-top: auto; }
.room-action-note { font-size: 11px; letter-spacing: .5px; color: #b99884; }
.room-start {
  min-width: 250px; text-align: center; box-sizing: border-box;
  font-size: 15px; font-weight: 700; letter-spacing: 3px;
  padding: 11px 24px; border-radius: 8px;
}
.setup-state { margin-top: 3px; font-size: 9px; color: #b79aa6; }
.setup-state.is-ok { color: #9fe4b4; }
