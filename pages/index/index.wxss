}
.room-input { width: 196px; letter-spacing: 2px; }
.room-hint, .profile-note { font-size: 10px; color: #cba894; line-height: 1.6; }
.room-notice { font-size: 11px; color: #a8ecf7; font-weight: 600; }

/* 玩家详情弹层 */
.player-dialog { width: 780px; }
.player-body { display: flex; gap: 18px; }
.player-left { width: 260px; flex: 0 0 260px; display: flex; flex-direction: column; gap: 7px; }
.player-right { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 7px; }
.player-avatar {
  width: 66px; height: 72px; border-radius: 5px; overflow: hidden;
  border: 2px solid #deb062;
  box-shadow: inset 0 0 0 1px rgba(255, 240, 200, .38), 0 4px 12px rgba(0, 0, 0, .68);
}
.player-avatar-img { width: 100%; height: 100%; }
.player-score { font-family: Georgia, serif; font-size: 21px; font-weight: 700; color: #ffebb8; }
.player-mini { font-size: 10px; color: #d8b89e; }
.score-line {
