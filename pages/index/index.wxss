@import "art.wxss";
@import "theme-picker.wxss";
@import "theme-pokemon.generated.wxss";
@import "theme-cyberpunk.generated.wxss";
@import "theme-ai.generated.wxss";

/* ==================================================================
 * 璀璨宝石 · 皇家典藏版 2.5D 实体牌桌 (Renaissance Royal Edition)
 * ------------------------------------------------------------------
 * 视觉规则
 *   光源：左上暖烛主光；所有实体向右下投立体接触阴影，左上留金属与丝绒高光。
 *   视角：接近俯视，远端市场行缩小 5%，字仍保持正立；明显侧转只用于左侧牌库。
 *   材质：威尼斯帝国酒红丝绒 / 乌木镶金画框 / 雕花黄铜包角 / 珐琅镶钻筹码。
 *   层级：桌布 → 投影 → 纸叠与筹码侧壁 → 顶面 → 数字图标 → 选中轮廓 → 弹层。
 * 所有尺寸为 1080×560 逻辑舞台坐标，由 stage 等比缩放。
 * ================================================================== */

page, .viewport { width: 100%; height: 100vh; overflow: hidden; }
.viewport {
  position: relative;
  background: radial-gradient(ellipse 90% 85% at 50% 50%, #240d18 0%, #11050b 100%);
}

.stage {
  position: absolute;
  left: 50%; top: 50%;
  width: 1080px; height: 560px;
  margin-left: -540px; margin-top: -280px;
  transform-origin: center center;
  overflow: hidden;
  border-radius: 12px;
  box-shadow:
    0 24px 72px rgba(0, 0, 0, .88),
    0 0 0 1px rgba(243, 212, 139, .36),
    inset 0 0 0 1px rgba(255, 232, 178, .32);
}

/* ---------- 1. 场景：威尼斯皇家酒红丝绒桌布 + 佛罗伦萨织金星盘 ---------- */
.felt {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background:
    radial-gradient(ellipse 68% 60% at 48% 40%, rgba(186, 72, 102, .34) 0%, rgba(118, 36, 62, .16) 54%, transparent 100%),
    radial-gradient(ellipse 95% 90% at 50% 48%, #5e1f35 0%, #441527 46%, #2a0c19 80%, #17060e 100%);
}
/* 丝绒经纬与暗花织纹：细腻提供宫廷织物触感 */
.felt-grain {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background:
    repeating-linear-gradient(45deg, rgba(255, 234, 198, .016) 0px, rgba(255, 234, 198, .016) 1px, transparent 1px, transparent 6px),
    repeating-linear-gradient(-45deg, rgba(16, 4, 12, .055) 0px, rgba(16, 4, 12, .055) 1px, transparent 1px, transparent 6px),
    repeating-linear-gradient(0deg, rgba(255, 240, 210, .009) 0px, rgba(255, 240, 210, .009) 1px, transparent 1px, transparent 3px);
}
/* 柔和烛光顶灯：聚光于中央市场与宝石区 */
.felt-light {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background:
    radial-gradient(ellipse 56% 52% at 44% 34%, rgba(255, 222, 168, .13) 0%, transparent 72%),
    radial-gradient(ellipse 40% 36% at 78% 28%, rgba(255, 214, 148, .06) 0%, transparent 70%);
}
/* 四周暗角与内嵌金线画框，把视线收进牌桌中央 */
.felt-vignette {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background: radial-gradient(ellipse 92% 96% at 50% 48%, transparent 48%, rgba(16, 5, 12, .72) 100%);
  box-shadow:
    inset 0 0 90px rgba(10, 3, 8, .58),
    inset 0 0 0 14px rgba(24, 9, 16, .25);
}
.felt-vignette::after {
  content: '';
  position: absolute; left: 14px; top: 14px; right: 14px; bottom: 14px;
  border: 1px solid rgba(243, 212, 139, .18);
  border-radius: 6px;
  box-shadow: inset 0 0 0 2px rgba(20, 7, 14, .45), inset 0 0 0 3px rgba(243, 212, 139, .07);
  pointer-events: none;
}
.table-emblem {
  position: absolute;
  left: 50%; top: 46%;
  width: 480px; height: 480px;
  margin-left: -240px; margin-top: -240px;
  background-size: 100% 100%; background-repeat: no-repeat;
  opacity: .08;
  transform: perspective(460px) rotateX(48deg) scale(1.18);
  filter: drop-shadow(0 2px 8px rgba(0, 0, 0, .5));
}
/* 实体红木镶金边梁：三层高光倒角 + 内嵌金线 */
.wood-edge { position: absolute; z-index: 2; pointer-events: none; }
.wood-top, .wood-bottom { left: 0; right: 0; height: 11px; }
.wood-top {
  top: 0;
  background: linear-gradient(180deg, #9c6a3e 0%, #633928 42%, #361b18 82%, #b88946 100%);
  box-shadow: inset 0 1px 0 rgba(255, 236, 190, .52), 0 4px 12px rgba(0, 0, 0, .68);
}
.wood-bottom {
  bottom: 0;
  background: linear-gradient(0deg, #9c6a3e 0%, #633928 42%, #361b18 82%, #b88946 100%);
  box-shadow: inset 0 -1px 0 rgba(255, 236, 190, .36), 0 -4px 12px rgba(0, 0, 0, .62);
}
.wood-left, .wood-right { top: 0; bottom: 0; width: 11px; }
.wood-left {
  left: 0;
  background: linear-gradient(90deg, #8c5c36 0%, #522e22 52%, #2b1514 84%, #b88946 100%);
  box-shadow: 4px 0 12px rgba(0, 0, 0, .62);
}
.wood-right {
  right: 0;
  background: linear-gradient(270deg, #8c5c36 0%, #522e22 52%, #2b1514 84%, #b88946 100%);
  box-shadow: -4px 0 12px rgba(0, 0, 0, .62);
}
/* 四角雕花黄铜包角（由 art.wxss 提供红宝石黄铜矢量纹章） */
.corner {
  position: absolute; width: 34px; height: 34px; z-index: 3; opacity: .92;
  background-size: 100% 100%; background-repeat: no-repeat;
  filter: drop-shadow(0 2px 5px rgba(0, 0, 0, .65));
  pointer-events: none;
}
.corner-tl { left: 8px; top: 8px; }
.corner-tr { right: 8px; top: 8px; transform: scaleX(-1); }
.corner-bl { left: 8px; bottom: 8px; transform: scaleY(-1); }
.corner-br { right: 8px; bottom: 8px; transform: scale(-1, -1); }

/* ---------- 2. 通用材质原语 ---------- */
.gem-icon { background-size: 100% 100%; background-repeat: no-repeat; background-position: center; }
.coin-face { background-size: 100% 100%; background-repeat: no-repeat; background-position: center; }

/* ---------- 3. 顶部：对手铭牌条 / 皇家回合横幅 / 右上金库与入口 ---------- */
.top-bar {
  position: absolute; left: 0; top: 0; width: 1080px; height: 72px;
  z-index: 8; pointer-events: none;
}
.top-bar > .seat-strip, .top-bar > .turn-banner, .top-bar > .top-right { pointer-events: auto; }
.rival-badge {
  position: absolute; left: 18px; top: 8px;
  width: 208px; height: 58px;
  display: flex; align-items: center; gap: 7px;
  padding: 4px 8px;
  background-size: 100% 100%; background-repeat: no-repeat;
  box-shadow: 0 6px 14px rgba(0, 0, 0, .6);
}
.rival-avatar {
  width: 42px; height: 46px; flex-shrink: 0;
  border: 2px solid #c5954a; border-radius: 3px;
  background-size: cover; background-position: center 22%;
  filter: brightness(1.08) saturate(1.04);
  box-shadow: inset 0 0 0 1px rgba(255, 240, 200, .35), 0 2px 6px rgba(0, 0, 0, .6);
}
.rival-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
.rival-head { display: flex; align-items: baseline; justify-content: space-between; }
.rival-name { font-size: 13px; font-weight: 700; color: #fff1d5; letter-spacing: 1px; }
.rival-score { font-size: 10px; color: #e8c489; }
.mini-tokens { display: flex; gap: 3px; }
.mini-token {
  position: relative; width: 17px; height: 17px; border-radius: 50%;
  border: 1px solid rgba(243, 212, 139, .6);
  display: flex; align-items: center; justify-content: center;
  background-color: #24141f;
  box-shadow: inset 0 1px 2px rgba(255, 255, 255, .18);
}
.mini-token text {
  position: relative; z-index: 1;
  font-family: Georgia, serif; font-size: 10px; font-weight: 700; color: #fff1d5;
  text-shadow: 0 1px 2px #000;
}
.mini-token.is-zero { opacity: .35; }
.rival-extra { display: flex; flex-direction: column; gap: 2px; font-size: 9px; color: #d8b596; }

/* 皇家回合铭牌：中央悬浮鎏金横幅 */
/* 紧凑回合提示：夹在对手条与右上入口之间（626~808），
   原先 23px 的「你的回合」大标题占满整条顶栏，现在只保留
   行动中是谁 + 计时 + 轮次 / 上一手，横向空间让给对手摘要卡。 */
.turn-banner {
  position: absolute; left: 634px; top: 7px; width: 178px;
  padding: 3px 9px 4px 10px;
  border-radius: 14px;
  border: 1px solid rgba(243, 212, 139, .38);
  background:
    radial-gradient(ellipse 80% 90% at 50% 15%, rgba(128, 62, 86, .48), rgba(26, 10, 19, .78) 85%);
  box-shadow:
    inset 0 1px 0 rgba(255, 242, 204, .28),
    inset 0 -2px 6px rgba(0, 0, 0, .55),
    0 6px 18px rgba(0, 0, 0, .58);
  display: flex; flex-direction: column; justify-content: center; gap: 2px;
  /* 状态行降字号时会矮，固定下限避免换手时整块抖动 */
  min-height: 48px;
  overflow: hidden;
}
.turn-banner.is-mine {
  border-color: rgba(124, 226, 247, .62);
  box-shadow:
    inset 0 1px 0 rgba(226, 250, 255, .3),
    inset 0 -2px 6px rgba(0, 0, 0, .55),
    0 0 12px rgba(124, 226, 247, .2),
    0 6px 18px rgba(0, 0, 0, .58);
}
.turn-line { display: flex; align-items: center; gap: 5px; min-width: 0; }
/* 行动中是谁：条内最大一行，13px（原 23px），其余空间留给资源行 */
.turn-main {
  flex: 1; min-width: 0;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", Georgia, serif;
  font-size: 13px; font-weight: 700; letter-spacing: .8px; line-height: 1.2;
  color: #ffebb8;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  text-shadow: 0 2px 6px rgba(0, 0, 0, .92), 0 0 12px rgba(243, 198, 108, .28);
}
/* 「3 号位 · 某某某 的回合」比「你的回合 · 2 号位」长一截，降一档保住单行 */
.turn-main.is-long { font-size: 11.5px; letter-spacing: .4px; }
/* 计时：第一行右端的数字药丸，进度条改成整条底边（不抢横向空间） */
.turn-clock {
  flex-shrink: 0; min-width: 34px; height: 15px; padding: 0 4px;
  border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  background: rgba(14, 5, 10, .82);
  border: 1px solid rgba(243, 212, 139, .34);
}
.turn-clock-num {
  font-family: Georgia, serif; font-size: 12px; font-weight: 700; letter-spacing: .2px;
  color: #ffe9bb; line-height: 1;
  text-shadow: 0 1px 3px rgba(0, 0, 0, .9);
}
.turn-clock-track {
  position: absolute; left: 0; right: 0; bottom: 0; height: 2.5px;
  overflow: hidden; border-radius: 0 0 14px 14px;
  background: rgba(10, 4, 8, .55);
}
.turn-clock-fill {
  height: 100%;
  background: linear-gradient(90deg, #6fd7a4, #d7f0b4);
  transition: width .4s linear;
}
.turn-clock.is-urgent { border-color: rgba(255, 140, 110, .8); }
.turn-clock.is-urgent .turn-clock-num { color: #ff9a86; animation: clockPulse .9s ease-in-out infinite; }
.turn-clock-fill.is-urgent { background: linear-gradient(90deg, #ff7a5c, #ffbf6b); }
.turn-clock.is-mine .turn-clock-num { color: #b9f4ff; }
.turn-clock.is-mine.is-urgent .turn-clock-num { color: #ff9a86; }
@keyframes clockPulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.14); opacity: .82; }
}
/* 第二行：轮次 + 上一手（低权重记录，明确区别于当前选择） */
.turn-sub-row { display: flex; align-items: center; gap: 4px; min-width: 0; }
.turn-round {
  flex-shrink: 0; padding: 0 4px; height: 12px; border-radius: 3px;
  display: flex; align-items: center;
  font-size: 8.5px; color: #e8c8a2; letter-spacing: .2px; line-height: 1;
  background: rgba(20, 8, 14, .5);
}
.turn-sub {
  flex: 1; min-width: 0;
  font-size: 8.5px; color: #d8b596; letter-spacing: .1px; line-height: 1.3;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  text-shadow: 0 1px 3px rgba(0, 0, 0, .85);
}
.turn-sub.is-net { color: #ffc470; font-weight: 700; }
/* 「上一手」标签把记录与当前状态显式区分开 */
.turn-sub.is-last { color: #c9ae93; }
.turn-sub-tag {
  margin-right: 2px; padding: 0 2px; border-radius: 2px;
  background: rgba(243, 212, 139, .16);
  color: #dcb886; font-size: 7.5px;
}
.turn-banner::after { display: none; }

.top-right {
  position: absolute; right: 18px; top: 10px;
  display: flex; align-items: center; gap: 8px;
  padding: 4px 10px 4px 8px;
  border-radius: 26px;
  border: 1px solid rgba(232, 188, 106, .36);
  background: linear-gradient(160deg, rgba(64, 32, 46, .78), rgba(22, 10, 18, .86));
  box-shadow: inset 0 1px 0 rgba(255, 240, 200, .2), 0 6px 16px rgba(0, 0, 0, .55);
}
.gold-box {
  display: flex; align-items: center; gap: 6px;
  padding-right: 7px;
  border-right: 1px solid rgba(243, 212, 139, .24);
}
.gold-coin {
  position: relative; width: 34px; height: 34px; border-radius: 50%;
  box-shadow: 0 2px 0 #8f6f33, 0 4px 0 #5a3d1f, 0 6px 10px rgba(0, 0, 0, .65);
}
.pile-gem { position: absolute; left: 50%; top: 50%; width: 22px; height: 22px; margin-left: -11px; margin-top: -11px; }
.gold-label {
  font-family: "Songti SC", Georgia, serif;
  font-size: 11px; font-weight: 700; color: #ffe6ae; letter-spacing: .5px;
  text-shadow: 0 1px 3px rgba(0, 0, 0, .85);
}
.round-btn {
  width: 31px; height: 31px; border-radius: 50%;
  border: 1px solid #d9ab5c;
  background: radial-gradient(circle at 34% 26%, #734558 0%, #3d202e 58%, #1e0f18 100%);
  box-shadow:
    inset 0 1px 0 rgba(255, 244, 212, .42),
    inset 0 -2px 4px rgba(0, 0, 0, .68),
    0 3px 8px rgba(0, 0, 0, .62);
  display: flex; align-items: center; justify-content: center;
  font-family: Georgia, serif; font-size: 16px; font-weight: 700; color: #ffebb8;
  text-shadow: 0 1px 3px rgba(0, 0, 0, .85);
}
.round-btn:active { transform: translateY(1px); }
.round-btn-hover { transform: translateY(1px); }
/* 退出按钮：常驻、但用暖红调区分于其它入口，提醒它有破坏性 */
.quit-btn {
  border-color: #e08a72;
  background: radial-gradient(circle at 34% 26%, #8a3f46 0%, #4a1c26 58%, #24101a 100%);
  color: #ffd8c6;
}
.quit-btn text { font-size: 15px; }
/* 托管角标：压在头像右下角，青蓝色与「行动中」区分开 */
.auto-badge {
  position: absolute; right: -4px; bottom: -3px; z-index: 5;
  padding: 0 3px; height: 11px; border-radius: 5px;
  display: flex; align-items: center;
  font-size: 8px; font-weight: 700; line-height: 1; letter-spacing: .1px;
  color: #05202a;
  background: linear-gradient(180deg, #9fe8f7, #4bb6d2);
  border: 1px solid rgba(226, 252, 255, .9);
  box-shadow: 0 1px 3px rgba(0, 0, 0, .7);
}
/* 托管中的头像压暗一档，暗示「这个人现在不在」 */
.seat-avatar.is-auto { filter: saturate(.55) brightness(.82); }
/* 操作区的托管开关 */
.auto-btn { flex-shrink: 0; padding: 0 8px; min-height: 40px; font-size: 11px; }
.auto-btn.is-on {
  border-color: #9fe8f7;
  background: linear-gradient(180deg, #3d6f7e, #16323b 62%, #0b1c22);
  color: #ccf5ff;
  box-shadow: inset 0 1px 0 rgba(210, 250, 255, .4), 0 0 8px rgba(120, 220, 245, .3), 0 3px 7px rgba(0, 0, 0, .55);
}

/* ---------- 4. 左侧牌库：沿 2.5D 牌桌左缘斜铺的厚牌叠（参考图1） ---------- */
/* 预留区：桌沿最左侧那条原本空着的绒面，铺本机 3 张预留卡（卡面与市场卡同款） */
.reserved-rail {
  position: absolute; left: 30px; top: 82px; width: 92px; height: 348px;
  display: flex; flex-direction: column; gap: 4px;
  z-index: 5;
}
.reserved-slot { position: relative; width: 92px; height: 112px; }
.reserved-slot.reserved-hover { transform: translateY(2px) scale(.99); }
.reserved-empty {
  width: 92px; height: 112px; border-radius: 7px;
  border: 1px dashed rgba(243, 212, 139, .34);
  background:
    linear-gradient(180deg, rgba(58, 26, 42, .28), rgba(16, 6, 12, .34));
  box-shadow: inset 0 3px 12px rgba(0, 0, 0, .44);
}
/* 竖排「预留」标签，用 flex 逐个字符堆叠，不依赖 writing-mode */
.reserved-tag {
  position: absolute; left: -19px; top: 2px;
  width: 15px; display: flex; flex-direction: column; align-items: center; gap: 1px;
  pointer-events: none;
}
.reserved-tag-ch {
  font-family: "Songti SC", "STSong", Georgia, serif;
  font-size: 10px; font-weight: 700; line-height: 1.05; color: #e8c489;
  text-shadow: 0 1px 3px rgba(0, 0, 0, .95);
}
.reserved-tag-num {
  margin-top: 2px;
  font-family: Georgia, serif; font-size: 9px; font-weight: 700; color: #ffebb8;
  text-shadow: 0 1px 3px rgba(0, 0, 0, .95);
}

.left-rail { position: absolute; left: 138px; top: 82px; width: 102px; height: 348px; z-index: 4; }
.rail-shadow {
  position: absolute; left: -6px; top: -4px; width: 112px; height: 356px;
  border-radius: 50%;
  background: radial-gradient(ellipse 60% 56% at 50% 50%, rgba(10, 3, 8, .55), transparent 78%);
  transform: rotate(10deg);
  pointer-events: none;
}
.deck-slot { position: absolute; left: 0; width: 88px; height: 112px; }
/* 沿 2.5D 透视左缘（/）自上而下向左下方阶梯展开，与参考图1一致 */
.deck-lv-2 { top: 4px; left: 32px; }
.deck-lv-1 { top: 114px; left: 16px; }
.deck-lv-0 { top: 226px; left: 0px; }
.deck-stack {
  position: absolute; left: 14px; top: 4px;
  width: 58px; height: 102px;
  border-radius: 4px;
  transform: perspective(340px) rotateX(24deg) skewX(-11.5deg) rotateZ(2.5deg) scale(0.76, 0.88);
  transform-origin: 50% 55%;
  transition: transform 180ms cubic-bezier(.2, .8, .3, 1), box-shadow 180ms;
  box-shadow:
    -8px 12px 18px rgba(6, 2, 6, .88),
    0 3px 0 #ebd5ad,
    0 5px 0 #9c7848,
    inset 0 0 0 1.5px rgba(255, 238, 188, .85);
}
.deck-slot.deck-hover .deck-stack {
  transform: perspective(340px) rotateX(20deg) skewX(-9deg) rotateZ(2deg) scale(0.80, 0.91) translateY(-4px);
}
.deck-face {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  border-radius: 3px;
  background-size: 100% 100%; background-repeat: no-repeat;
}
/* 左侧可见的厚重象牙白纸叠侧壁（参考图1左侧牌库立面） */
.deck-edges {
  position: absolute; left: -12px; top: 2px; width: 12px; height: 99px;
  z-index: 3;
  transform: skewY(12deg);
  background: linear-gradient(90deg, #fffdf8 0%, #f7ebd2 55%, #cfb286 100%);
  border-left: 1px solid #a68456;
  box-shadow: -4px 6px 10px rgba(6, 2, 6, .8);
}
.deck-stack::after {
  content: ''; position: absolute; left: -10px; right: 1px; bottom: -6px; height: 6px;
  background: linear-gradient(180deg, #fbf0d9, #b89564);
  transform: skewX(32deg);
  box-shadow: 0 5px 10px rgba(6, 2, 6, .8);
}
.deck-sheen {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  border-radius: 3px;
  background: linear-gradient(118deg, rgba(255, 255, 255, .34) 0%, rgba(255, 255, 255, .08) 28%, transparent 52%, rgba(0, 0, 0, .4) 100%);
}
.deck-crest {
  position: absolute; left: 50%; top: 43%;
  width: 34px; height: 34px; margin-left: -17px; margin-top: -17px;
  border-radius: 50%;
  border: 1.5px solid #ffe6a8;
  background: radial-gradient(circle at 34% 26%, rgba(44, 22, 34, .82), rgba(12, 5, 12, .94) 82%);
  box-shadow:
    0 0 0 2px rgba(24, 10, 18, .65),
    inset 0 1px 0 rgba(255, 245, 215, .45),
    0 3px 8px rgba(0, 0, 0, .78);
  display: flex; align-items: center; justify-content: center;
  z-index: 4;
}
.deck-label {
  font-family: Georgia, "Songti SC", serif; font-size: 16px; font-weight: 700;
  line-height: 1; color: #ffecb8; text-shadow: 0 1px 4px #000;
}
.deck-count {
  position: absolute; right: 8px; bottom: 8px;
  min-width: 22px; height: 18px; padding: 0 4px; border-radius: 9px;
  border: 1px solid #ecc478;
  background: linear-gradient(180deg, #3b1e2c, #180b13);
  box-shadow: inset 0 1px 0 rgba(255, 240, 200, .3), 0 3px 6px rgba(0, 0, 0, .72);
  display: flex; align-items: center; justify-content: center;
  font-family: Georgia, serif; font-size: 10px; font-weight: 700; color: #ffecb8;
  z-index: 5;
}
.deck-stack.is-empty { opacity: .42; }
.rail-hint {
  position: absolute; left: -10px; top: 344px; width: 108px;
  font-size: 9px; color: #d8b896; text-align: center; letter-spacing: .5px;
  text-shadow: 0 1px 3px rgba(0, 0, 0, .9);
}

/* ---------- 5. 中央市场：2.5D 单灭点扇形斜铺牌阵（参考图1：上窄下宽、四列汇聚于上方灭点） ---------- */
.board {
  position: absolute; left: 252px; top: 78px;
  width: 532px; height: 348px;
  display: flex; flex-direction: column; justify-content: space-between;
  z-index: 5;
}
.board::before { display: none; }
.card-row { position: relative; height: 112px; display: flex; justify-content: space-between; }
.row-label { display: none; }
.card-slot {
  position: relative; width: 92px; height: 112px;
  transition: transform 180ms cubic-bezier(.2, .8, .3, 1);
  animation: cardDeal 340ms cubic-bezier(.2, .8, .3, 1) both;
}
.card-slot.is-selected { transform: translateY(-8px) scale(1.05); z-index: 7; }
.card-slot.slot-hover { transform: translateY(2px) scale(.99); }

/* 典藏发展卡：参考图1的全幅油画 + 顶部半透明羊皮高光带 + 左下纵列成本圆章 + 底部立体纸厚 */
.card {
  position: relative; width: 92px; height: 112px;
  border-radius: 7px;
  border-top: 1px solid rgba(255, 252, 236, .96);
  border-left: 1px solid rgba(248, 232, 192, .88);
  border-right: 1px solid #9e7b4f;
  border-bottom: 1px solid #5e4224;
  background: #2b1822;
  overflow: hidden;
  transform-origin: 50% 50%;
  box-shadow:
    0 2px 0 #ebd4a8,
    0 4px 0 #a8824e,
    0 6px 0 #593e1e,
    0 12px 18px rgba(6, 2, 6, .88),
    5px 16px 22px rgba(0, 0, 0, .65),
    inset 0 0 0 1px rgba(255, 248, 225, .48);
  transition: box-shadow 180ms ease, border-color 180ms ease, transform 180ms ease;
}
/* 可购买：分两种光环，取代「把成本数字改成缺口」的旧做法
   绿光 = 现有筹码直接可买   金光 = 缺口需动用黄金
   三层同心阴影（实心描边 + 近场光晕 + 远场扩散）让光环比纸厚阴影更抢眼 */
.card.is-buyable {
  border-color: #63ffb0;
  box-shadow:
    0 0 0 3px rgba(46, 255, 148, 1),
    0 0 10px 2px rgba(34, 240, 132, .85),
    0 0 22px 6px rgba(24, 214, 122, .55),
    0 0 40px 14px rgba(16, 170, 96, .26),
    0 1.5px 0 #ebd4a8,
    0 3px 0 #b8925a,
    0 4.5px 0 #6e502a,
    0 12px 20px rgba(8, 2, 7, .9);
}
.card.is-buyable .card-photo { filter: brightness(1.15) saturate(1.18) contrast(1.04); }
.card.is-gold-buy {
  border-color: #ffc23c;
  box-shadow:
    0 0 0 3px rgba(255, 186, 44, 1),
    0 0 10px 2px rgba(255, 168, 22, .85),
    0 0 22px 6px rgba(240, 140, 12, .55),
    0 0 40px 14px rgba(190, 108, 8, .28),
    0 1.5px 0 #ebd4a8,
    0 3px 0 #b8925a,
    0 4.5px 0 #6e502a,
    0 12px 20px rgba(8, 2, 7, .9);
}
.card.is-gold-buy .card-photo { filter: brightness(1.12) saturate(1.14) contrast(1.04); }
/* 选中：璀璨青蓝宝石光环 + 抬升悬浮感 */
.card-slot.is-selected .card {
  border-color: #6fe3ff;
  box-shadow:
    0 0 0 2px #6fe3ff,
    0 0 20px rgba(111, 227, 255, .65),
    0 4px 0 #b8925a,
    0 7px 0 #6e502a,
    8px 18px 26px rgba(8, 2, 7, .86);
}
/* 全幅油画铺满整张卡面（参考图1） */
.card-art {
  position: absolute; left: 0; right: 0; top: 0; bottom: 0; height: 100%;
  overflow: hidden;
}
.card-photo {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background-size: cover; background-position: 48% center; background-repeat: no-repeat;
  background-color: #4a3340;
  filter: brightness(1.08) saturate(1.12) contrast(1.04);
}
/* 顶部半透明亮带承托声望与红利宝石，底部柔暗承托卡名（参考图1） */
.art-glaze {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background:
    linear-gradient(180deg, rgba(255, 248, 232, .68) 0%, rgba(246, 232, 204, .28) 23%, transparent 34%),
    linear-gradient(122deg, rgba(255, 248, 225, .14) 0%, transparent 44%),
    linear-gradient(0deg, rgba(14, 6, 12, .84) 0%, rgba(14, 6, 12, .22) 22%, transparent 44%);
  box-shadow: inset 0 0 0 1px rgba(243, 212, 139, .26);
}
.card-name {
  position: absolute; right: 4px; bottom: 3px; z-index: 3;
  padding: 1px 4px; border-radius: 4px;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", Georgia, serif;
  font-size: 9px; font-weight: 700; letter-spacing: .5px;
  color: #fff3d6;
  background: rgba(16, 6, 12, .52);
  text-shadow: 0 1px 2px #000;
}
/* 左上声望：参考图1的醒目白金立体衬线数字 */
.card-points {
  position: absolute; left: 6px; top: 1px; z-index: 4;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 27px; font-style: italic; font-weight: 700; line-height: 1;
  color: #fff8e4;
  text-shadow:
    0 1px 0 #7a5216,
    0 0 4px #12080e, 0 0 7px rgba(18, 8, 14, .9),
    1.5px 1.5px 2px #12080e, -1px -1px 2px #12080e,
    1px -1px 2px #12080e, -1px 1px 2px #12080e;
}
/* 右上永久红利：切面宝石徽章 */
.card-gem {
  position: absolute; right: 5px; top: 4px; z-index: 4;
  width: 23px; height: 23px; border-radius: 50%;
  border: 1.5px solid #f7dc9c;
  background-color: #1f101a;
  box-shadow:
    0 0 0 1px rgba(24, 10, 16, .85),
    inset 0 1px 2px rgba(255, 255, 255, .38),
    0 2px 6px rgba(0, 0, 0, .8);
  overflow: hidden;
}
/* 左下角纵列成本圆章（参考图1：气泡沿卡片左下侧纵向排列，直接叠在全幅插画上） */
.card-foot {
  position: absolute; left: 4px; bottom: 4px; top: auto; right: auto;
  width: 44px; height: auto; max-height: 76px; z-index: 4;
  display: flex; flex-direction: column-reverse; flex-wrap: wrap;
  align-content: flex-start; gap: 2px; padding: 0;
  background: transparent;
  border-top: none;
  box-shadow: none;
}
.cost-bubble {
  position: relative; width: 21px; height: 21px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background-color: #1f1119;
  border: 1.5px solid rgba(255, 244, 210, .95);
  box-shadow:
    0 0 0 1px rgba(14, 5, 10, .92),
    0 2px 0 rgba(14, 5, 10, .88),
    inset 0 1px 2px rgba(255, 255, 255, .55),
    0 3px 6px rgba(0, 0, 0, .78);
  overflow: hidden;
}
/* 四色成本（官方牌组特有）：21px 圆章 ×4 会超过 76px 纵向预算并折成第二列压住卡名，
   收窄到 17px + 1px 间距，保持单列 71px，卡名区域完全让开 */
.card-row .card-foot.is-dense { gap: 1px; }
.card-row .card-foot.is-dense .cost-bubble { width: 17px; height: 17px; }
.card-row .card-foot.is-dense .cost-bubble text { font-size: 11px; }
/* 五色成本圆章专属边框高光，强化白/蓝/绿/红/黑的边缘辨识度 */
.cost-bubble.gem-white { border-color: #556b82; box-shadow: 0 0 0 1px #ffffff, 0 2px 4px rgba(0, 0, 0, .8); }
.cost-bubble.gem-blue  { border-color: #a8e6ff; }
.cost-bubble.gem-green { border-color: #a8ffc4; }
.cost-bubble.gem-red   { border-color: #ffc2be; }
.cost-bubble.gem-black { border-color: #e6c48e; }
.cost-bubble text {
  position: relative; z-index: 2;
  font-family: Georgia, serif; font-size: 13px; font-weight: 700; line-height: 1;
  text-shadow:
    0 1px 2px #000,
    0 0 4px #000,
    1px 1px 0 #12080e, -1px -1px 0 #12080e,
    1px -1px 0 #12080e, -1px 1px 0 #12080e;
}
/* 白钻成本圆章为纯白底盘，配深海蓝黑字 + 白光描边，一眼与蓝/黑区分 */
.cost-bubble.gem-white text,
.noble-req.gem-white text,
.disc-chip.gem-white text {
  color: #142030 !important;
  text-shadow:
    0 1px 0 #ffffff,
    0 0 3px #ffffff,
    1px 1px 0 rgba(255, 255, 255, .9),
    -1px -1px 0 rgba(255, 255, 255, .9);
}
.card-empty {
  width: 92px; height: 112px; border-radius: 7px;
  border: 1px dashed rgba(243, 212, 139, .28);
  background: rgba(18, 7, 14, .32);
  box-shadow: inset 0 3px 12px rgba(0, 0, 0, .48);
}

/* ---------- 6. 右侧栏：2.5D 立体堆叠筹码柱 & 斜铺贵族画廊（参考图1） ---------- */
.right-rail { position: absolute; left: 802px; top: 82px; width: 262px; height: 350px; z-index: 5; }
.rail-title {
  display: block; height: 15px; line-height: 15px; white-space: nowrap;
  font-size: 9px; font-weight: 600; letter-spacing: .6px; color: rgba(243, 212, 139, .82);
  text-shadow: 0 1px 3px rgba(0, 0, 0, .9);
}
.pile-area { position: absolute; left: 0; top: 0; width: 102px; height: 350px; }
.pile-area::before { display: none; }
.pile-list { position: absolute; left: 0; top: 18px; width: 102px; height: 328px; }
.pile-item {
  position: absolute; width: 82px; height: 52px;
  display: flex; align-items: center;
  transition: transform 220ms cubic-bezier(.2, .8, .3, 1);
}
/* 沿右侧 2.5D 透视斜线（\）自上而下向右下方延伸，远小近大（参考图1） */
.pile-slot-5 { left: -4px; top: 0px;   transform: scale(.91); }
.pile-slot-3 { left: 3px;  top: 54px;  transform: scale(.94); }
.pile-slot-1 { left: 10px; top: 108px; transform: scale(.97); }
.pile-slot-0 { left: 17px; top: 162px; transform: scale(1.00); }
.pile-slot-2 { left: 24px; top: 216px; transform: scale(1.03); }
.pile-slot-4 { left: 31px; top: 270px; transform: scale(1.06); }
/* 3D 筹码堆叠容器：顶层在 y=0，底层向下层叠出清晰的筹码柱侧面，参考图1 */
.pile-stack {
  position: relative; left: 14px; top: -4px;
  width: 48px; height: 48px;
  transition: transform 220ms cubic-bezier(.2, .8, .3, 1);
  filter: drop-shadow(3px 9px 9px rgba(6, 2, 6, .82));
}
.pile-disc {
  position: absolute; left: 0; top: 0;
  width: 46px; height: 46px; border-radius: 50%;
  box-shadow:
    0 2.2px 0 #ebd08e,
    0 3.6px 0 #4a2c10,
    inset 0 -2px 3px rgba(0, 0, 0, .35);
}
.pile-coin {
  position: absolute; left: 0; top: 0;
  width: 46px; height: 46px; border-radius: 50%;
  box-shadow:
    0 2.2px 0 #f4d896,
    0 3.8px 0 #593614,
    inset 0 1px 0 rgba(255, 252, 232, .72);
  transition: transform 220ms cubic-bezier(.2, .8, .3, 1), box-shadow 220ms;
}
/* 筹码柱侧壁按宝石本色染色（参考图1：白/蓝/绿/红/黑/金六色筹码柱侧边一目了然） */
.pile-disc.coin-white, .pile-coin.coin-white { box-shadow: 0 2.4px 0 #e6eff8, 0 3.8px 0 #5c7085; }
.pile-disc.coin-blue,  .pile-coin.coin-blue  { box-shadow: 0 2.4px 0 #268cff, 0 3.8px 0 #073578; }
.pile-disc.coin-green, .pile-coin.coin-green { box-shadow: 0 2.4px 0 #1cd45e, 0 3.8px 0 #064d20; }
.pile-disc.coin-red,   .pile-coin.coin-red   { box-shadow: 0 2.4px 0 #f52c34, 0 3.8px 0 #69070c; }
.pile-disc.coin-black, .pile-coin.coin-black { box-shadow: 0 2.4px 0 #57443d, 0 3.8px 0 #140d0b; }
.pile-disc.coin-gold,  .pile-coin.coin-gold  { box-shadow: 0 2.4px 0 #ffd24c, 0 3.8px 0 #6e4406; }
.pile-gem { width: 24px; height: 24px; margin-left: -12px; margin-top: -12px; }
/* 筹码库存数字：参考图1直接落在筹码柱左下方的绒布上，醒目白金斜体衬线字 */
.pile-count {
  position: absolute; left: -2px; bottom: -2px; z-index: 6;
  min-width: 18px; height: 18px; padding: 0 2px;
  display: flex; align-items: center; justify-content: center;
  font-family: Georgia, "Times New Roman", serif;
  font-style: italic; font-size: 16px; font-weight: 700; color: #fff6db;
  text-shadow:
    0 2px 4px #000,
    0 0 6px #000,
    1px 1px 0 #12080e, -1px -1px 0 #12080e;
}
.pile-name { display: none; }
.pile-tip { display: none; }
.pile-item.is-selected .pile-stack { transform: translateY(-6px) scale(1.06); }
.pile-item.is-selected .pile-coin {
  box-shadow:
    0 0 0 2px #7ce2f7,
    0 0 18px rgba(124, 226, 247, .65),
    0 3px 0 #b8843e,
    0 6px 0 #6e481c,
    7px 16px 22px rgba(6, 2, 6, .85);
}
.pile-item.pile-hover .pile-stack { transform: translateY(2px); }
.pile-item.is-disabled { opacity: .38; }
.pile-item.is-gold.is-disabled { opacity: .9; }
/* 已选筹码堆右侧的放回按钮：点一次只退 1 枚，不必整篮清除。
   外层 hit 是放大后的透明热区，内层才是 24px 圆钮；×2 角标提示同色拿了两枚。 */
.pile-minus-hit {
  position: absolute; right: -8px; top: 0; z-index: 9;
  width: 32px; height: 52px;
  display: flex; align-items: center; justify-content: center;
}
.pile-minus {
  width: 24px; height: 24px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(160deg, #a02b3c 0%, #4b0d19 100%);
  border: 1px solid rgba(255, 214, 190, .85);
  box-shadow: 0 2px 6px rgba(0, 0, 0, .7), inset 0 1px 0 rgba(255, 255, 255, .28);
  color: #fff4e8; font-size: 17px; font-weight: 700; line-height: 1;
  transition: transform 120ms ease;
}
.pile-minus-hover .pile-minus { transform: scale(1.14); }
/* 角标居中放在圆钮正上方，别贴在减号右边，否则会被读成「−2」（实际点一次只退 1 枚） */
.pile-picked {
  position: absolute; left: 50%; top: -2px; margin-left: -9px;
  min-width: 18px; height: 16px; padding: 0 2px; border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  background: #ffe0a8; border: 1px solid #7a4a12;
  color: #4a1a08; font-size: 11px; font-weight: 800; line-height: 1;
  box-shadow: 0 1px 3px rgba(0, 0, 0, .6);
}

/* ---------- 7. 贵族肖像画廊：2.5D 斜铺 + 左侧纵列红利需求（参考图1） ---------- */
.noble-area { position: absolute; left: 122px; top: 0; width: 112px; height: 350px; }
.noble-area::before { display: none; }
.noble-row { position: absolute; left: 4px; top: 18px; display: flex; flex-direction: column; gap: 6px; }
.noble {
  position: relative; width: 92px; height: 100px;
  border-radius: 6px;
  border: 1.5px solid #e2b668;
  background: linear-gradient(165deg, #472435 0%, #24111c 68%, #160911 100%);
  transform-origin: 50% 50%;
  box-shadow:
    0 2.5px 0 #c99c52,
    0 5px 0 #5e3d16,
    6px 12px 18px rgba(6, 2, 6, .85),
    inset 0 0 0 1px rgba(255, 240, 200, .28);
  overflow: hidden;
  animation: nobleIn 420ms ease-out both;
}
.noble-face {
  position: absolute; left: 0; right: 0; top: 0; bottom: 0; height: 100%;
  overflow: hidden;
}
.noble-photo {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background-size: cover; background-position: 62% 22%; background-repeat: no-repeat;
  background-color: #3a2530;
  filter: brightness(1.08) saturate(1.1);
}
.noble-face::after {
  content: ''; position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background:
    linear-gradient(90deg, rgba(246, 232, 204, .75) 0%, rgba(236, 216, 180, .52) 26%, transparent 34%),
    linear-gradient(0deg, rgba(12, 5, 12, .72) 0%, transparent 36%);
}
.noble-points {
  position: absolute; right: 5px; bottom: 4px; z-index: 3;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 22px; font-style: italic; font-weight: 700; line-height: 1;
  color: #fff6db;
  text-shadow: 0 1px 0 #6e4514, 0 0 5px #000, 1px 1px 2px #000, -1px -1px 2px #000;
}
.noble-title { display: none; }
/* 左侧纵列红利需求卡标（参考图1贵族卡左侧竖排方章） */
.noble-reqs {
  position: absolute; left: 3px; bottom: 5px; z-index: 3;
  display: flex; flex-direction: column; gap: 2px;
}
.noble-req {
  position: relative; width: 17px; height: 19px; border-radius: 3px;
  background-color: #1e1018;
  border: 1px solid rgba(255, 236, 188, .88);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 1px 3px rgba(0, 0, 0, .75);
}
.noble-req text {
  position: relative; z-index: 2;
  font-family: Georgia, serif; font-size: 10px; font-weight: 700; color: #fff4d6;
  text-shadow: 0 1px 2px #000, 0 0 4px #000, 1px 1px 0 #12080e, -1px -1px 0 #12080e;
}
.noble-none { font-size: 11px; color: #d8b596; }

/* 3/4 人局 4~5 张贵族：紧凑双列 2.5D 画廊 */
.noble-area.is-compact { left: 114px; width: 148px; }
.noble-area.is-compact .noble-row {
  top: 18px; display: grid; grid-template-columns: repeat(2, 68px); gap: 6px;
  grid-auto-flow: row;
}
.noble-area.is-compact .noble { width: 68px; height: 90px; }
.noble-area.is-compact .noble-face { height: 100%; }
.noble-area.is-compact .noble-points {
  right: 4px; bottom: 3px; font-size: 18px;
}
.noble-area.is-compact .noble-reqs { left: 3px; bottom: 4px; gap: 2px; }
.noble-area.is-compact .noble-req { width: 14px; height: 15px; }
.noble-area.is-compact .noble-req text { font-size: 8px; }

/* ---------- 7.1 多贵族挑选弹层 / 等待横幅 / 贵族展演 ---------- */
.noble-dialog { width: 460px; padding: 14px 18px 12px; }
.noble-pick-row { display: flex; gap: 14px; justify-content: center; margin-top: 10px; }
.noble-pick {
  width: 112px; height: 124px; cursor: pointer;
  transition: transform 120ms ease-out, box-shadow 120ms ease-out;
}
.noble-pick .noble-title {
  display: block; position: absolute; left: 5px; top: 4px; z-index: 3;
  font-size: 10px; font-weight: 700; letter-spacing: 1px; color: #fff3d6;
  text-shadow: 0 1px 3px #000, 0 0 6px rgba(0, 0, 0, .9);
}
.noble-pick .noble-points { font-size: 18px; right: 5px; bottom: 3px; }
.noble-pick .noble-reqs { flex-direction: row; left: 5px; bottom: 5px; gap: 3px; }
.noble-pick .noble-req { width: 15px; height: 16px; }
.noble-pick-hover {
  transform: translateY(-4px) scale(1.04);
  border-color: #ffe9b0;
  box-shadow:
    0 2.5px 0 #c99c52,
    0 5px 0 #5e3d16,
    0 0 18px rgba(255, 224, 150, .55),
    6px 12px 18px rgba(6, 2, 6, .85),
    inset 0 0 0 1px rgba(255, 240, 200, .5);
}
.noble-pick-tip {
  display: block; margin-top: 10px; text-align: center;
  font-size: 10px; color: #cfa87c; letter-spacing: .5px;
}
/* 别人在挑：顶部非阻断横幅，不挡牌桌操作 */
.noble-waiting {
  position: absolute; left: 50%; top: 84px; transform: translateX(-50%);
  z-index: 12; pointer-events: none;
  padding: 6px 16px; border-radius: 16px;
  border: 1px solid rgba(243, 212, 139, .5);
  background: linear-gradient(160deg, rgba(84, 40, 60, .92), rgba(24, 10, 19, .94));
  box-shadow: 0 4px 14px rgba(0, 0, 0, .6), inset 0 1px 0 rgba(255, 242, 204, .25);
  animation: fadeIn 160ms ease-out both;
}
.noble-waiting-text {
  font-size: 12px; font-weight: 700; color: #ffe9bb; letter-spacing: 1px;
  text-shadow: 0 1px 3px rgba(0, 0, 0, .9);
}
/* 贵族到访展演：与购买卡同框架，只是主角换成贵族牌 */
.showcase-noble { position: relative; z-index: 2; }
.noble-showcase {
  width: 132px; height: 146px;
  border-width: 2px;
  animation: nobleIn 420ms ease-out both, showcaseGlow 1.2s ease-in-out infinite;
}
.noble-showcase .noble-title {
  display: block; position: absolute; left: 6px; top: 5px; z-index: 3;
  font-size: 12px; font-weight: 700; letter-spacing: 1px; color: #fff3d6;
  text-shadow: 0 1px 3px #000, 0 0 6px rgba(0, 0, 0, .9);
}
.noble-showcase .noble-points { font-size: 24px; }
.noble-showcase .noble-reqs { flex-direction: row; left: 6px; bottom: 6px; gap: 3px; }
.noble-showcase .noble-req { width: 17px; height: 18px; }

/* ---------- 8. 底部玩家皇家工作台 ---------- */
.tray { position: absolute; left: 84px; top: 430px; width: 950px; height: 130px; z-index: 9; }
.tray-rim {
  position: absolute; left: 0; top: 0; width: 950px; height: 130px;
  background-size: 100% 100%; background-repeat: no-repeat;
  filter: drop-shadow(0 -4px 14px rgba(0, 0, 0, .55));
}
.tray-rim::after {
  content: ''; position: absolute; left: 8px; top: 56px; right: 8px; bottom: 4px;
  border-radius: 0 0 8px 8px;
  background:
    repeating-linear-gradient(90deg, rgba(255, 235, 200, .02) 0px, rgba(255, 235, 200, .02) 1px, transparent 1px, transparent 6px),
    repeating-linear-gradient(0deg, rgba(0, 0, 0, .1) 0px, rgba(0, 0, 0, .1) 1px, transparent 1px, transparent 4px),
    linear-gradient(105deg, transparent 18%, rgba(255, 224, 172, .06) 48%, transparent 76%);
  pointer-events: none;
}
/* ---- 三功能区：左身份 236 / 中资源 478（236~714） / 右操作 236 ----
   边界刻意落在底板贴图自带的两条竖线装饰上，分隔线不额外画。 */
.tray-left {
  position: absolute; left: 14px; top: 10px; width: 208px; height: 110px;
  display: flex; align-items: center; gap: 9px; z-index: 3;
}
/* 皇家肖像金框：由 78×92 收到 64×80，把空间让给右侧数字 */
.portrait-frame {
  position: relative; width: 64px; height: 80px; flex-shrink: 0;
  border: 2.5px solid #d9ab5c; border-radius: 5px;
  background: linear-gradient(150deg, #f3d48b, #8a5622);
  box-shadow:
    0 0 0 1px rgba(24, 10, 16, .85),
    inset 0 1px 0 rgba(255, 248, 220, .88),
    inset 0 -2px 0 rgba(86, 48, 16, .85),
    0 3px 0 #523012, 0 8px 18px rgba(0, 0, 0, .8);
}
.portrait {
  position: absolute; left: 2px; top: 2px; right: 2px; bottom: 2px;
  border-radius: 2px;
  border: 1px solid rgba(20, 10, 16, .72);
  background-size: cover; background-position: center 20%; background-repeat: no-repeat;
  filter: brightness(1.08) saturate(1.06);
  box-shadow: inset 0 0 12px rgba(0, 0, 0, .55);
}
/* 自己的工作台也要标号位：牌桌上方席位条只列对手，自己是靠这块牌认位的 */
.portrait-seat {
  position: absolute; left: 50%; bottom: -9px; transform: translateX(-50%);
  padding: 0 6px; border-radius: 7px; white-space: nowrap;
  border: 1px solid rgba(255, 244, 205, .92);
  background: linear-gradient(160deg, #ffeaad, #c8952f 62%, #8d5f16);
  box-shadow: 0 2px 6px rgba(0, 0, 0, .8), inset 0 1px 0 rgba(255, 255, 255, .8);
}
.portrait-seat text {
  font-family: Georgia, serif; font-size: 9.5px; font-weight: 700; color: #2c1405;
  letter-spacing: .3px; line-height: 1.3;
}
.id-block { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 5px; }
.id-name {
  font-size: 11px; font-weight: 700; color: #fff1d5; letter-spacing: .4px;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  text-shadow: 0 1px 3px rgba(0, 0, 0, .9);
}
/* 声望与预留并排两格：标签在下、数字在上，统一成同一套「数值 + 说明」语言 */
.id-stats { display: flex; gap: 6px; }
.id-stat {
  flex: 1; min-width: 0; padding: 3px 4px 2px;
  display: flex; flex-direction: column; align-items: center; gap: 1px;
  border-radius: 6px;
  border: 1px solid rgba(240, 200, 126, .55);
  background: linear-gradient(180deg, rgba(66, 33, 48, .92), rgba(22, 10, 18, .94));
  box-shadow: inset 0 1px 0 rgba(255, 240, 200, .22), 0 2px 6px rgba(0, 0, 0, .6);
}
.id-stat-hover { transform: translateY(1px); }
.id-stat-num {
  font-family: Georgia, serif; font-size: 19px; font-weight: 700; line-height: 1;
  color: #ffe9b8; text-shadow: 0 2px 5px rgba(0, 0, 0, .9);
}
.id-stat-label { font-size: 10px; color: #e6c5a0; letter-spacing: .4px; line-height: 1; }
/* 声望达到终局线：换成金底深墨，明确「已达标」而不是把数字截断在 15 */
.id-score.is-reached {
  border-color: #ffe6a6;
  background: linear-gradient(180deg, #ffdf95, #b5771d 72%, #7d4d0d 100%);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .7), 0 3px 10px rgba(0, 0, 0, .66), 0 0 12px rgba(255, 210, 120, .4);
}
.id-score.is-reached .id-stat-num { color: #2b1504; text-shadow: 0 1px 0 rgba(255, 250, 232, .5); }
.id-score.is-reached .id-stat-label { color: #4a2a08; }

/* 资源区：宽度按底板装饰线对齐（236~714） */
.tray-vault {
  position: absolute; left: 246px; top: 16px; width: 456px; height: 100px;
  display: flex; flex-direction: column; gap: 4px; z-index: 3;
}
.vault-head { display: flex; align-items: center; gap: 8px; padding-left: 2px; }
.vault-total-text {
  font-size: 11px; color: #ecd0ad; letter-spacing: .4px;
  text-shadow: 0 1px 2px #000;
}
/* 总量数字紧跟文案，是这一块最需要一眼读到的数 */
.vault-total-num {
  font-family: Georgia, serif; font-size: 17px; font-weight: 700;
  color: #ffe9b8; letter-spacing: 0;
}
/* 超过 10 枚：总量转警示色，与「请退还筹码」的状态行互相印证 */
.vault-total-num.is-over { color: #ff9f86; text-shadow: 0 0 8px rgba(255, 120, 90, .45); }
.vault-group { display: flex; align-items: center; gap: 8px; }
.vault-label {
  width: 56px; flex-shrink: 0; font-size: 11px; font-weight: 600;
  color: #efcfa4; letter-spacing: .2px; text-align: right;
  text-shadow: 0 1px 2px #000; line-height: 1.15;
}
/* 两行共用 6 个 46px 定宽槽位：同色严格上下对齐，黄金只在筹码行有内容 */
.vault-row { display: flex; gap: 6px; align-items: center; }
.vault-sq, .vault-coin {
  position: relative; width: 52px; height: 34px;
  display: flex; align-items: center; justify-content: center;
}
/* 永久折扣：方形卡（有棱角的铭牌感） */
.vault-sq {
  border-radius: 4px;
  border: 1px solid rgba(255, 230, 172, .85);
  /* 方形卡：深底 + 左侧竖色条，不再铺圆形宝石图，避免看起来像筹码 */
  background:
    linear-gradient(180deg, rgba(86, 48, 66, .95) 0%, rgba(30, 14, 24, .98) 62%, rgba(16, 7, 13, .99) 100%);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, .3),
    inset 0 0 0 1px rgba(24, 10, 16, .55),
    0 2px 5px rgba(0, 0, 0, .7);
  padding-left: 5px;
}
/* 持有筹码：圆形筹码（与公共筹码池同一语言） */
.vault-coin {
  border-radius: 50%; z-index: 0;
  border: 1px solid rgba(243, 212, 139, .55);
  background: linear-gradient(180deg, rgba(82, 46, 64, .96) 0%, rgba(28, 13, 23, .98) 65%, rgba(14, 6, 12, .99) 100%);
  box-shadow:
    inset 0 1px 0 rgba(255, 242, 205, .28),
    inset 0 -5px 9px rgba(0, 0, 0, .72),
    0 3px 7px rgba(0, 0, 0, .68);
  transition: transform 120ms ease, border-color 120ms ease;
  background-size: 100% 100%; background-repeat: no-repeat;
}
/* 左侧竖色条：把「这张卡产出哪一色红利」做成一眼可辨的色标 */
.vault-sq::before {
  content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 5px;
  border-radius: 4px 0 0 4px;
  background: linear-gradient(180deg, rgba(255, 255, 255, .55), rgba(255, 255, 255, .1));
  box-shadow: inset -1px 0 0 rgba(0, 0, 0, .45);
  z-index: 2;
}
.sq-white::before { background: linear-gradient(180deg, #ffffff, #a9bacd); }
.sq-blue::before  { background: linear-gradient(180deg, #8cc2f5, #1c4f88); }
.sq-green::before { background: linear-gradient(180deg, #89e3aa, #0f5030); }
.sq-red::before   { background: linear-gradient(180deg, #ff9aa0, #8d1f27); }
.sq-black::before { background: linear-gradient(180deg, #9d8b98, #241a22); }
/* 折扣除去宝石圆图的压暗层（方卡靠底色与色条识别，不需要再压） */
.vault-sq::after { display: none; }
/* 数字压在宝石图案上：白宝石浅底改用深墨 + 四向白描边（与卡面成本气泡同一约定） */
.vault-sq::after, .vault-coin::after {
  content: ''; position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  border-radius: inherit;
  background: radial-gradient(ellipse 62% 58% at 50% 50%, rgba(10, 4, 10, .46), rgba(10, 4, 10, .12) 72%, transparent 100%);
  z-index: 1;
}
.vault-sq text, .vault-coin text {
  position: relative; z-index: 2;
  font-family: Georgia, serif; font-size: 18px; font-weight: 700; line-height: 1;
  color: #fff6de;
  text-shadow: 0 1px 3px #000, 0 0 5px rgba(0, 0, 0, .95), 1px 1px 0 #12080e, -1px -1px 0 #12080e;
}
.vault-sq text {
  font-size: 19px;
  color: #fff3d8;
  text-shadow: 0 2px 4px rgba(0, 0, 0, .95);
}
.vault-sq.is-zero text { color: rgba(255, 238, 210, .46); }
.vault-sq.is-light text, .vault-coin.is-light text {
  color: #101c28;
  text-shadow:
    1px 0 0 rgba(255, 255, 255, .92), -1px 0 0 rgba(255, 255, 255, .92),
    0 1px 0 rgba(255, 255, 255, .92), 0 -1px 0 rgba(255, 255, 255, .92),
    0 0 5px rgba(255, 255, 255, .85);
}
.vault-sq.is-wide text, .vault-coin.is-wide text { font-size: 14px; }
/* 零值：保留位置与数字，只压低底色与描边——不能看着像整项被禁用 */
.vault-sq.is-zero, .vault-coin.is-zero { background-color: rgba(30, 16, 24, .42); border-color: rgba(255, 230, 172, .3); box-shadow: none; }
.vault-sq.is-zero text, .vault-coin.is-zero text { color: rgba(255, 240, 214, .5); text-shadow: 0 1px 2px #000; }
.vault-sq.is-zero.is-light text, .vault-coin.is-zero.is-light text { color: rgba(240, 248, 255, .5); text-shadow: 0 1px 2px #000; }
.vault-coin.is-gold { border-color: #ffd98e; box-shadow: inset 0 1px 0 rgba(255, 248, 220, .6), inset 0 -5px 9px rgba(70, 40, 4, .8), 0 3px 8px rgba(0, 0, 0, .7), 0 0 8px rgba(255, 205, 110, .28); }
/* 折扣行第 6 位留给黄金：它是空位，不画任何章，只维持列宽 */
.vault-gold-gap { width: 52px; height: 34px; }
.vault-coin.vault-hover { transform: translateY(2px); }
/* 退还模式：可点的筹码描一圈暖光，已选入退还篮的打勾压暗 */
.vault-coin.can-discard { border-color: #ff9a6a; animation: vaultPulse 1.2s infinite; cursor: pointer; }
.vault-coin.can-discard.is-zero { animation: none; border-color: rgba(255, 154, 106, .3); }
.vault-coin.is-picked { border-color: #ff6a5c; background: linear-gradient(180deg, rgba(120, 40, 46, .98), rgba(48, 12, 16, .99)); }

/* 操作区：本次选择与确认（唯一主按钮就在这里）
   高度 108：标题行 15 + 明细 15 + 总量 18 + 主按钮 46 + 说明 12，间距 2。
   字号全部 ≥11px，844×390 缩到 0.7 后仍是 8px 物理像素，可读。 */
.tray-right {
  position: absolute; left: 722px; top: 12px; width: 210px; height: 108px;
  display: flex; flex-direction: column; gap: 2px; z-index: 4;
}
.pick-head { display: flex; align-items: center; gap: 5px; flex-shrink: 0; }
.pick-kind {
  font-size: 11px; font-weight: 700; letter-spacing: .5px; color: #f4d5a6;
  text-shadow: 0 1px 2px #000;
}
/* 增量标记：独立的 +n / −n 药丸，与「已有多少」分开，不混读 */
.pick-delta {
  margin-left: auto; padding: 0 5px; height: 15px; border-radius: 8px;
  display: flex; align-items: center;
  font-family: Georgia, serif; font-size: 12px; font-weight: 700; line-height: 1;
}
.pick-delta.is-plus { background: rgba(120, 226, 160, .22); border: 1px solid rgba(150, 244, 190, .62); color: #c4ffd8; }
.pick-delta.is-minus { background: rgba(255, 140, 120, .2); border: 1px solid rgba(255, 170, 150, .6); color: #ffcdbe; }
.pick-delta.is-idle { background: rgba(255, 240, 210, .1); border: 1px solid rgba(243, 212, 139, .28); color: #d9bf9c; }
/* 本次明细：单行省略，完整信息在标题里（逐色用「白×1」紧凑写法） */
.pick-title {
  flex-shrink: 0;
  font-size: 11px; color: #ffeacb; line-height: 1.25;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  text-shadow: 0 1px 2px #000;
}
/* 确认后总量：现在 → 之后并排，免心算 */
.pick-total { display: flex; align-items: baseline; gap: 3px; flex-shrink: 0; }
.pick-total-label { font-size: 10px; color: #dcbf9d; letter-spacing: .2px; }
.pick-total-num { font-family: Georgia, serif; font-size: 13px; font-weight: 700; color: #e9d2b4; }
.pick-total-num.is-next { color: #ffe289; font-size: 14px; }
.pick-total-arrow { font-size: 10px; color: #c9a688; }
.pick-actions { display: flex; gap: 5px; align-items: stretch; margin-top: auto; flex-shrink: 0; }
/* 主按钮高度 40 舞台 px（×0.7 ≈ 28 物理像素，配 210px 宽度已远超 44×44 触控下限的等效面积）；
   文案固定居中，换文案不改变版式 */
.pick-main {
  flex: 1; min-width: 0; min-height: 40px;
  justify-content: center; text-align: center;
  padding: 0 6px; font-size: 13px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.pick-clear, .pick-pass { flex-shrink: 0; min-height: 40px; padding: 0 9px; font-size: 12px; }
.pick-reason {
  flex-shrink: 0;
  font-size: 9.5px; color: #ffc9a2; line-height: 1.2; letter-spacing: .1px;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  text-shadow: 0 1px 2px #000;
}
/* 非本人回合：操作区整体降权，库存与牌面仍可细看 */
.tray-right.is-idle .pick-kind { color: #cbb094; }
.tray-right.is-idle .pick-title { color: #d6bda2; }
/* 轮到自己时工作台加一圈极淡青边，与对手卡的「行动中」同一套语言 */
.tray.is-my-turn .tray-rim { filter: drop-shadow(0 -4px 14px rgba(0, 0, 0, .55)) drop-shadow(0 0 10px rgba(124, 226, 247, .22)); }

.hint-warn { color: #ffba82; font-weight: 700; }
.btn-row { display: flex; gap: 6px; justify-content: flex-end; }
.btn {
  padding: 6px 11px; border-radius: 7px; font-size: 11px; font-weight: 600; letter-spacing: .4px;
  border: 1px solid #d6a656;
  background: linear-gradient(180deg, #683b4e 0%, #381c29 62%, #210f18 100%);
  color: #ffecd0;
  display: flex; align-items: center;
  box-shadow:
    inset 0 1px 0 rgba(255, 244, 214, .34),
    inset 0 -2px 0 rgba(0, 0, 0, .58),
    0 4px 9px rgba(0, 0, 0, .62);
  transition: transform 100ms ease, box-shadow 100ms ease;
}
.btn:active { transform: translateY(2px); box-shadow: inset 0 1px 0 rgba(255, 240, 205, .2); }
.btn-primary {
  border-color: #fff0be;
  background: linear-gradient(180deg, #ffeaad 0%, #eab658 42%, #be8124 85%, #8c5910 100%);
  color: #2b1504;
  font-weight: 700;
  text-shadow: 0 1px 0 rgba(255, 250, 230, .45);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, .78),
    inset 0 -2px 0 rgba(92, 52, 8, .55),
    0 4px 12px rgba(0, 0, 0, .62),
    0 0 14px rgba(234, 182, 88, .22);
}

.btn-off { opacity: .48; filter: saturate(.75); }

/* ---------- 9. 弹层：文艺复兴鎏金宝匣 ---------- */
.overlay {
  position: absolute; left: 0; top: 0; width: 1080px; height: 560px;
  background: radial-gradient(ellipse 80% 80% at 50% 50%, rgba(18, 6, 14, .74), rgba(6, 2, 6, .88));
  display: flex; align-items: center; justify-content: center;
  z-index: 20;
  animation: fadeIn 160ms ease-out both;
}
.overlay-top { z-index: 30; }
.dialog {
  position: relative;
  border: 1.5px solid #deb062;
  border-radius: 14px;
  background:
    radial-gradient(ellipse 75% 50% at 50% 0%, rgba(255, 218, 152, .12), transparent 70%),
    repeating-linear-gradient(45deg, rgba(255, 230, 200, .014) 0px, rgba(255, 230, 200, .014) 1px, transparent 1px, transparent 6px),
    linear-gradient(162deg, #54283c 0%, #2d1422 58%, #180a13 100%);
  box-shadow:
    0 0 0 1px rgba(18, 6, 13, .9),
    inset 0 0 0 3px rgba(16, 6, 12, .55),
    inset 0 0 0 4px rgba(243, 212, 139, .24),
    inset 0 1px 0 rgba(255, 245, 215, .38),
    0 26px 76px rgba(0, 0, 0, .88);
  padding: 20px 24px;
  animation: dialogIn 180ms cubic-bezier(.2, .8, .3, 1) both;
}
.dialog-head {
  display: flex; flex-direction: column; gap: 5px;
  margin-bottom: 14px; padding-bottom: 11px;
  border-bottom: 1px solid rgba(243, 212, 139, .38);
  box-shadow: 0 1px 0 rgba(0, 0, 0, .45);
}
.dialog-title {
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", Georgia, serif;
  font-size: 24px; font-weight: 700; color: #ffebb8; letter-spacing: 2px;
  text-shadow: 0 2px 8px rgba(0, 0, 0, .85);
}
.dialog-sub { font-size: 12px; color: #e2be9a; }
.dialog-btns { display: flex; gap: 10px; justify-content: flex-end; align-items: center; margin-top: 16px; }
.dialog-action-note {
  flex: 1; min-width: 0;
  font-size: 11px; color: #cfa9b8; line-height: 1.4; text-align: left;
}

.detail-dialog { width: 700px; }
/* 详情弹层里的购买主按钮：这是弹层内唯一的主动作，热区抬到 42px 舞台高
   （844×390 下 scale≈0.54 约合 23px 物理像素，宽度已远超常规按钮）。
   不要改全局 .btn —— 那会连带放大所有次级按钮，把弹层撑高。 */
.detail-dialog .btn-primary {
  min-height: 42px; padding: 0 18px; font-size: 13px; letter-spacing: .5px;
}
.detail-dialog .dialog-btns { margin-top: 14px; }
.detail-dialog .dialog-action-note { font-size: 11.5px; color: #d9b3c0; }
.detail-body { display: flex; gap: 22px; align-items: flex-start; }
.card-big {
  width: 150px; height: 204px; flex-shrink: 0; transform: scale(1.02);
  border-color: #7ce2f7;
  box-shadow: 0 0 0 2px #7ce2f7, 0 0 18px rgba(124, 226, 247, .42),
    0 4px 0 #6f543a, 9px 18px 26px rgba(12, 5, 12, .78);
}
.card-big .card-art { height: 100%; }
.card-big .card-foot { left: 7px; bottom: 8px; width: 66px; max-height: 132px; gap: 4px; }
.card-big .card-name { font-size: 13px; right: 6px; bottom: 6px; padding: 2px 7px; }
.card-big .card-points { font-size: 40px; left: 8px; top: 2px; }
.card-big .card-gem { width: 32px; height: 32px; right: 8px; top: 6px; }
.card-big .cost-bubble { width: 28px; height: 28px; }
.card-big .cost-bubble text { font-size: 16px; }
.detail-info { flex: 1; display: flex; flex-direction: column; gap: 9px; }
.detail-section { font-size: 12px; color: #f6d896; font-weight: 700; letter-spacing: 1px; }
.cost-line {
  display: flex; align-items: center; gap: 8px;
  padding: 4px 8px; border-radius: 6px;
  background: rgba(20, 8, 15, .45);
  border: 1px solid rgba(243, 212, 139, .16);
}
.cost-line-dot { width: 18px; height: 18px; border-radius: 50%; border: 1px solid rgba(255, 232, 178, .65); background-color: #1e1018; }
.cost-line.is-missing .cost-line-num { color: #ffb4a8; font-weight: 600; }
.cost-line-label { font-size: 12px; font-weight: 600; color: #ffecd0; width: 58px; }
.cost-line-num { font-size: 12px; color: #e2be9a; }
.detail-summary { font-size: 14px; font-weight: 700; margin-top: 4px; }
.detail-summary.ok { color: #a4f0bc; }
.detail-summary.no { color: #ffb4a8; }
.detail-note { font-size: 11px; color: #cba8b6; line-height: 1.7; }

.reserved-dialog { width: 620px; }
.reserved-list { display: flex; gap: 14px; min-height: 168px; align-items: flex-start; flex-wrap: wrap; }
.card-small { width: 110px; height: 150px; }
.card-small .card-art { height: 100%; }
.card-small .card-foot { left: 5px; bottom: 6px; width: 50px; max-height: 98px; gap: 3px; }
.card-small .card-points { font-size: 30px; }
.card-small .card-gem { width: 25px; height: 25px; }
.card-small .cost-bubble { width: 22px; height: 22px; }
.card-small .cost-bubble text { font-size: 13px; }
.card-small .card-name { font-size: 11px; right: 5px; bottom: 5px; }
.empty-tip { font-size: 13px; color: #d6b4c0; line-height: 1.7; }

.rules-dialog { width: 720px; }
.rules-body { display: flex; flex-direction: column; gap: 9px; }
.rule-item { font-size: 13px; color: #f6e5cc; line-height: 1.62; }
.rule-note { font-size: 11px; color: #cba8b6; margin-top: 6px; line-height: 1.6; }

.result-dialog { width: 460px; display: flex; flex-direction: column; align-items: center; gap: 12px; }
.result-crown { font-size: 32px; line-height: 1; color: #ffdc85; text-shadow: 0 0 24px rgba(255, 204, 102, .82); }
.result-title {
  font-family: "Songti SC", "STSong", Georgia, serif;
  font-size: 30px; font-weight: 700; letter-spacing: 3px; color: #ffebb8; line-height: 1.15;
  text-shadow: 0 3px 12px rgba(0, 0, 0, .88);
}
.result-detail { font-size: 12px; color: #edd0a8; text-align: center; }
.result-dialog .dialog-btns { justify-content: center; margin-top: 8px; flex-shrink: 0; }
/* 结算面板加宽：排名表要放下「名次 / 玩家 / 声望 / 构成 + 逐色资源」四列 */
.result-dialog { width: 860px; max-height: 524px; padding: 16px 22px; gap: 6px; }
.rank-board {
  width: 100%; margin-top: 2px;
  display: flex; flex-direction: column; gap: 4px;
  /* 4 人局要完整放下 4 行（每行约 52px + 表头 15）。不再设 max-height：
     用 flex 让表格自然撑开、按钮区被挤到底部，避免按钮盖住最后一行。 */
  flex: 0 1 auto; min-height: 0;
}
.rank-row {
  display: flex; align-items: center; gap: 8px;
  padding: 3px 9px; border-radius: 7px;
  border: 1px solid rgba(243, 212, 139, .22);
  background: linear-gradient(180deg, rgba(70, 36, 52, .62), rgba(26, 12, 20, .72));
}
.rank-row.rank-head {
  padding: 3px 9px; border: 0; background: none;
  font-size: 10px; color: #c9a888; letter-spacing: .5px;
}
.rank-row.is-winner {
  border-color: #ffe0a0;
  background: linear-gradient(180deg, rgba(120, 74, 40, .68), rgba(48, 26, 14, .8));
  box-shadow: inset 0 1px 0 rgba(255, 240, 200, .3), 0 0 12px rgba(243, 198, 108, .22);
}
.rank-row.is-me { box-shadow: inset 2px 0 0 #7ce2f7; }
.rank-col-rank { flex: 0 0 34px; text-align: center; }
.rank-col-player { flex: 0 0 148px; min-width: 0; display: flex; align-items: center; gap: 7px; }
.rank-col-pt { flex: 0 0 52px; text-align: center; }
.rank-col-detail { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px; }
.rank-num {
  font-family: Georgia, serif; font-size: 19px; font-weight: 700; line-height: 1;
  color: #e6cba4;
}
.rank-num.is-first { color: #ffdf8e; font-size: 23px; text-shadow: 0 0 10px rgba(255, 210, 120, .6); }
.rank-avatar {
  width: 28px; height: 28px; flex-shrink: 0; border-radius: 4px;
  border: 1.5px solid #deb062; overflow: hidden;
  display: flex; align-items: center; justify-content: center;
  background: radial-gradient(circle at 34% 26%, #8a5546, #24111c 70%);
}
.rank-avatar-img { width: 100%; height: 100%; }
.rank-avatar-initial {
  font-family: Georgia, serif; font-size: 13px; font-weight: 700;
  color: #fff1d5; text-shadow: 0 1px 3px #1a0d14;
}
.rank-name-box { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px; }
.rank-name-line { display: flex; align-items: center; gap: 4px; min-width: 0; }
.rank-name {
  font-size: 12px; font-weight: 700; color: #fff3d6;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.rank-me-tag {
  flex-shrink: 0; padding: 0 3px; height: 11px; border-radius: 5px;
  display: flex; align-items: center;
  font-size: 8px; font-weight: 700; line-height: 1;
  color: #04222a; background: linear-gradient(180deg, #b6f2ff, #55c9e6);
}
.rank-me-tag.is-auto { color: #2b1504; background: linear-gradient(180deg, #ffdf8e, #b57a20); }
.rank-seat { font-size: 9px; color: #c9a888; line-height: 1; }
.rank-pt {
  font-family: Georgia, serif; font-size: 24px; font-weight: 700; line-height: 1;
  color: #ffebb8; text-shadow: 0 2px 6px rgba(0, 0, 0, .85);
}
.rank-detail-line { font-size: 10px; color: #e2c8a8; line-height: 1.25; }
.rank-detail-line.is-sub { color: #c2a68e; }
/* 逐色资源：上行方形折扣（第 6 槽留空对齐）、下行圆形筹码含黄金 */
.rank-res { display: flex; flex-direction: column; gap: 2px; margin-top: 1px; }
.rank-res-row { display: flex; align-items: center; gap: 3px; }
.rank-res-tag { width: 10px; flex-shrink: 0; font-size: 8px; color: #cbb094; text-align: center; line-height: 1; }
.rank-res-sq, .rank-res-coin {
  flex: 0 0 23px; width: 23px; height: 16px;
  display: flex; align-items: center; justify-content: center;
  background-size: 100% 100%; background-repeat: no-repeat;
}
.rank-res-sq { border-radius: 2px; box-shadow: inset 0 0 0 1px rgba(10, 4, 8, .7); padding-left: 2px; }
.rank-res-sq::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; border-radius: 2px 0 0 2px; }
.rank-res-sq.sq-white::before { background: linear-gradient(180deg, #fff, #a9bacd); }
.rank-res-sq.sq-blue::before  { background: linear-gradient(180deg, #8cc2f5, #1c4f88); }
.rank-res-sq.sq-green::before { background: linear-gradient(180deg, #89e3aa, #0f5030); }
.rank-res-sq.sq-red::before   { background: linear-gradient(180deg, #ff9aa0, #8d1f27); }
.rank-res-sq.sq-black::before { background: linear-gradient(180deg, #9d8b98, #241a22); }
.rank-res-sq { position: relative; background: linear-gradient(180deg, rgba(84, 46, 64, .95), rgba(26, 12, 21, .98)); }
.rank-res-coin { border-radius: 50%; box-shadow: inset 0 0 0 1px rgba(10, 4, 8, .75); }
.rank-res-sq text, .rank-res-coin text {
  font-family: Georgia, serif; font-size: 10.5px; font-weight: 700; line-height: 1;
  color: #fff; text-shadow: 0 1px 0 #000, 0 -1px 0 #000, 1px 0 0 #000, -1px 0 0 #000;
}
.rank-res-sq.is-light text, .rank-res-coin.is-light text {
  color: #101c28;
  text-shadow: 1px 0 0 rgba(255,255,255,.9), -1px 0 0 rgba(255,255,255,.9), 0 1px 0 rgba(255,255,255,.9), 0 -1px 0 rgba(255,255,255,.9);
}
.rank-res-sq.is-zero, .rank-res-coin.is-zero { opacity: .5; }
.rank-res-sq.is-zero text, .rank-res-coin.is-zero text { color: rgba(255, 244, 224, .7); }

/* 终局提示条：贴在牌桌上方中央，不遮挡市场与工作台 */
.end-notice {
  position: absolute; left: 50%; top: 74px; transform: translateX(-50%);
  z-index: 8;
  display: flex; align-items: center; gap: 7px;
  padding: 4px 12px 4px 6px; border-radius: 15px;
  border: 1px solid rgba(255, 214, 130, .8);
  background: linear-gradient(180deg, rgba(120, 74, 34, .95), rgba(48, 24, 12, .96));
  box-shadow: 0 4px 14px rgba(0, 0, 0, .7), 0 0 14px rgba(243, 198, 108, .3);
}
.end-notice-tag {
  padding: 1px 5px; border-radius: 7px;
  font-size: 9.5px; font-weight: 700; line-height: 1.3;
  color: #2b1504; background: linear-gradient(180deg, #ffe6a0, #d79b32);
}
.end-notice-text { font-size: 11px; color: #ffe9c0; line-height: 1.2; }
.end-notice-left {
  padding-left: 7px; border-left: 1px solid rgba(255, 214, 130, .4);
  font-size: 10px; color: #ffcf8e; font-weight: 600;
}

/* ---------- 10. 动效 & 3段式桌面动作展演（取出/翻起 → 悬停展示 1.2s → 飞入工作台） ---------- */
.action-showcase {
  position: absolute; left: 0; top: 0; width: 1080px; height: 560px;
  z-index: 16; pointer-events: none;
  display: flex; align-items: center; justify-content: center;
  animation: showcaseLifecycle 1750ms ease-out both;
}
.showcase-backdrop {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background:
    radial-gradient(ellipse 46% 48% at 50% 48%, rgba(255, 214, 128, .24) 0%, rgba(20, 6, 14, .58) 56%, transparent 82%);
  animation: showcaseBackdrop 1750ms ease-out both;
}
.showcase-banner {
  position: absolute; left: 50%; top: 76px;
  width: 440px; margin-left: -220px;
  padding: 8px 20px 10px;
  border-radius: 28px;
  border: 1.5px solid rgba(255, 230, 168, .85);
  background:
    radial-gradient(ellipse 85% 90% at 50% 10%, rgba(136, 56, 82, .92), rgba(26, 9, 18, .95) 85%);
  box-shadow:
    0 0 0 2px rgba(18, 6, 12, .85),
    0 0 24px rgba(255, 206, 112, .45),
    0 12px 28px rgba(0, 0, 0, .82);
  display: flex; flex-direction: column; align-items: center; gap: 2px;
  z-index: 4;
  animation: showcaseBanner 1750ms cubic-bezier(.2, .8, .3, 1) both;
}
.showcase-badge {
  font-size: 9px; font-weight: 700; letter-spacing: 3px; color: #ffd984;
}
.showcase-title {
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", Georgia, serif;
  font-size: 19px; font-weight: 700; letter-spacing: 2px; color: #fff5d6;
  text-shadow: 0 2px 6px #000;
}
.showcase-sub {
  font-size: 11px; color: #edd0a8; letter-spacing: .5px;
}

/* 卡牌展演主体：从卡槽/牌库坐标翻起 → 中央悬停展示 ~1.2s → 飞入工作台/对手席位 */
.showcase-actor {
  position: relative; z-index: 3;
  margin-top: 24px;
  display: flex; align-items: center; justify-content: center;
  animation: showcaseCardFlight 1750ms cubic-bezier(.22, .82, .28, 1) both;
}
.showcase-halo {
  position: absolute; left: 50%; top: 50%;
  width: 240px; height: 240px; margin-left: -120px; margin-top: -120px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 224, 148, .52) 0%, rgba(255, 196, 92, .18) 46%, transparent 72%);
  filter: blur(2px);
}
.showcase-card-row {
  position: relative; z-index: 2;
  display: flex; align-items: center; gap: 18px;
}
.card-showcase {
  width: 138px; height: 184px;
  border-radius: 9px;
  border: 2px solid #fff0be;
  box-shadow:
    0 0 0 2px #7ce2f7,
    0 0 28px rgba(255, 214, 122, .75),
    0 4px 0 #b8925a,
    0 8px 0 #6e502a,
    0 22px 42px rgba(0, 0, 0, .88);
}
.card-showcase .card-art { height: 100%; }
.card-showcase .card-points { font-size: 38px; left: 8px; top: 2px; }
.card-showcase .card-gem { width: 32px; height: 32px; right: 7px; top: 6px; }
.card-showcase .card-foot { left: 6px; bottom: 7px; width: 62px; max-height: 120px; gap: 4px; }
.card-showcase .cost-bubble { width: 26px; height: 26px; }
.card-showcase .cost-bubble text { font-size: 15px; }
.card-showcase .card-name { font-size: 12px; right: 6px; bottom: 5px; padding: 2px 6px; }

.showcase-deck {
  position: relative; left: 0; top: 0;
  width: 118px; height: 172px;
  transform: none;
  box-shadow:
    0 0 26px rgba(255, 214, 122, .65),
    0 6px 0 #917148,
    0 20px 38px rgba(0, 0, 0, .85);
}
.showcase-deck .deck-edges { height: 164px; }
.showcase-deck .deck-crest { width: 52px; height: 52px; margin-left: -26px; margin-top: -26px; }
.showcase-deck .deck-label { font-size: 24px; }

.showcase-gold-bonus {
  display: flex; flex-direction: column; align-items: center; gap: 6px;
}
.showcase-gold-tag {
  padding: 2px 9px; border-radius: 12px;
  font-size: 11px; font-weight: 700; color: #2b1504;
  border: 1px solid #fff2c6;
  background: linear-gradient(180deg, #ffeaad, #d49b3c);
  box-shadow: 0 3px 8px rgba(0, 0, 0, .65);
}

/* 拿取筹码展演主体：每枚筹码从右侧各自筹码堆升起 → 中央并排悬停展示 ~1.2s → 飞入工作台筹码槽 */
.showcase-coins {
  position: relative; z-index: 3;
  margin-top: 28px;
  display: flex; align-items: center; justify-content: center; gap: 22px;
}
.showcase-coin-item {
  display: flex; flex-direction: column; align-items: center; gap: 8px;
  animation: showcaseCoinFlight 1750ms cubic-bezier(.22, .82, .28, 1) both;
}
.showcase-coin {
  position: relative; width: 68px; height: 68px; border-radius: 50%;
  box-shadow:
    0 0 0 2px #fff0be,
    0 0 24px rgba(255, 214, 122, .68),
    0 4px 0 #b8843e,
    0 8px 0 #5e3d16,
    0 16px 28px rgba(0, 0, 0, .85);
}
.showcase-coin-gem {
  position: absolute; left: 50%; top: 50%;
  width: 36px; height: 36px; margin-left: -18px; margin-top: -18px;
}
.showcase-coin-label {
  padding: 3px 10px; border-radius: 12px;
  font-size: 11px; font-weight: 700; color: #fff4d6;
  border: 1px solid rgba(243, 212, 139, .78);
  background: rgba(22, 9, 16, .88);
  box-shadow: 0 3px 8px rgba(0, 0, 0, .72);
}

/* ---------- 换手全屏提醒：进/出回合的一次性大提示 ----------
   1.7s 自隐，不拦点击（pointer-events: none），不参与常态布局。 */
.turn-flash {
  position: absolute; left: 0; top: 0; width: 1080px; height: 560px;
  z-index: 15; pointer-events: none;
  display: flex; align-items: center; justify-content: center;
  animation: turnFlashLife 1700ms ease-out both;
}
.turn-flash-veil {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background: radial-gradient(ellipse 66% 58% at 50% 50%, rgba(10, 3, 8, 0) 0%, rgba(10, 3, 8, .74) 82%);
  animation: turnFlashVeil 1700ms ease-out both;
}
.turn-flash-band {
  position: relative;
  min-width: 470px; padding: 16px 56px 18px;
  display: flex; flex-direction: column; align-items: center; gap: 5px;
  border-top: 2px solid rgba(243, 212, 139, .88);
  border-bottom: 2px solid rgba(243, 212, 139, .88);
  background: linear-gradient(90deg,
    rgba(34, 10, 22, 0) 0%, rgba(40, 13, 27, .9) 16%,
    rgba(40, 13, 27, .92) 84%, rgba(34, 10, 22, 0) 100%);
  box-shadow: 0 0 46px rgba(0, 0, 0, .55);
  animation: turnFlashBand 1700ms cubic-bezier(.2, .9, .25, 1) both;
}
.turn-flash-seat {
  font-size: 11px; letter-spacing: 5px; color: #e9c384;
  text-shadow: 0 1px 4px rgba(0, 0, 0, .9);
}
.turn-flash-title {
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", Georgia, serif;
  font-size: 38px; font-weight: 700; letter-spacing: 7px; line-height: 1.1;
  color: #ffeec2;
  text-shadow: 0 3px 14px rgba(0, 0, 0, .95), 0 0 26px rgba(243, 198, 108, .45);
}
.turn-flash-sub {
  font-size: 11px; letter-spacing: 1.2px; color: #e8cbab;
  text-shadow: 0 1px 4px rgba(0, 0, 0, .9);
}
/* 轮到自己：青蓝调，与席位条的「当前回合」同色系，形成一致语义 */
.turn-flash.is-mine .turn-flash-band {
  border-color: rgba(140, 232, 250, .92);
  background: linear-gradient(90deg,
    rgba(8, 32, 40, 0) 0%, rgba(8, 40, 50, .9) 16%,
    rgba(8, 40, 50, .92) 84%, rgba(8, 32, 40, 0) 100%);
  box-shadow: 0 0 54px rgba(60, 190, 220, .28);
}
.turn-flash.is-mine .turn-flash-title { color: #d9fbff; text-shadow: 0 3px 14px rgba(0, 0, 0, .95), 0 0 28px rgba(120, 224, 250, .55); }
.turn-flash.is-mine .turn-flash-seat { color: #9fe6f6; }
/* 机器人托管：低调一点，避免每一步都像在喊人 */
.turn-flash.is-bot .turn-flash-band { opacity: .92; }
.turn-flash.is-bot .turn-flash-title { font-size: 32px; }

@keyframes turnFlashLife {
  0%, 96% { opacity: 1; visibility: visible; }
  100% { opacity: 0; visibility: hidden; }
}
@keyframes turnFlashVeil {
  0% { opacity: 0; }
  10%, 74% { opacity: 1; }
  100% { opacity: 0; }
}
@keyframes turnFlashBand {
  0% { opacity: 0; transform: scaleX(.72) translateY(10px); }
  12% { opacity: 1; transform: scaleX(1) translateY(0); }
  78% { opacity: 1; transform: scaleX(1) translateY(0); }
  100% { opacity: 0; transform: scaleX(1.04) translateY(-7px); }
}

@keyframes showcaseLifecycle {
  0%, 96% { opacity: 1; visibility: visible; }
  100% { opacity: 0; visibility: hidden; }
}
@keyframes showcaseBackdrop {
  0% { opacity: 0; }
  14%, 76% { opacity: 1; }
  94%, 100% { opacity: 0; }
}
@keyframes showcaseBanner {
  0% { opacity: 0; transform: translateY(-16px) scale(.92); }
  14%, 78% { opacity: 1; transform: translateY(0) scale(1); }
  95%, 100% { opacity: 0; transform: translateY(-10px) scale(.95); }
}
@keyframes showcaseCardFlight {
  0% {
    opacity: .85;
    transform: translate3d(var(--from-x, 0px), var(--from-y, 0px), 0) perspective(520px) rotateX(24deg) rotateY(var(--flip-from, 0deg)) scale(.54);
  }
  18% {
    opacity: 1;
    transform: translate3d(0, -4px, 0) perspective(520px) rotateX(4deg) rotateY(0deg) scale(1.06);
  }
  26%, 76% {
    opacity: 1;
    transform: translate3d(0, 0, 0) perspective(520px) rotateX(2deg) rotateY(0deg) scale(1);
  }
  96% {
    opacity: .22;
    transform: translate3d(var(--to-x, 0px), var(--to-y, 210px), 0) perspective(520px) rotateX(18deg) rotateY(0deg) scale(.26);
  }
  100% {
    opacity: 0;
    transform: translate3d(var(--to-x, 0px), var(--to-y, 210px), 0) scale(.2);
  }
}
@keyframes showcaseCoinFlight {
  0% {
    opacity: .85;
    transform: translate3d(var(--coin-from-x, 280px), var(--coin-from-y, 0px), 0) perspective(460px) rotateX(24deg) scale(.56);
  }
  18% {
    opacity: 1;
    transform: translate3d(0, -6px, 0) perspective(460px) rotateX(4deg) scale(1.08);
  }
  26%, 76% {
    opacity: 1;
    transform: translate3d(0, 0, 0) perspective(460px) rotateX(2deg) scale(1);
  }
  96% {
    opacity: .22;
    transform: translate3d(var(--coin-to-x, 0px), var(--coin-to-y, 220px), 0) perspective(460px) rotateX(18deg) scale(.32);
  }
  100% {
    opacity: 0;
    transform: translate3d(var(--coin-to-x, 0px), var(--coin-to-y, 220px), 0) scale(.22);
  }
}

@keyframes cardDeal {
  0% { opacity: .35; }
  100% { opacity: 1; }
}
@keyframes coinLift {
  0% { transform: translateY(0); }
  100% { transform: translateY(-4px); }
}
@keyframes nobleIn {
  0% { opacity: 0; }
  100% { opacity: 1; }
}
@keyframes showcaseGlow {
  0%, 100% { box-shadow: 0 0 10px rgba(255, 224, 150, .35); }
  50% { box-shadow: 0 0 22px rgba(255, 224, 150, .75); }
}
@keyframes fadeIn { 0% { opacity: 0; } 100% { opacity: 1; } }
@keyframes dialogIn {
  0% { opacity: 0; transform: translateY(10px) scale(.98); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes turnBreath { 0%, 100% { opacity: .9; } 50% { opacity: 1; } }
@keyframes vaultPulse {
  0% { box-shadow: 0 0 0 0 rgba(255, 154, 106, .7); }
  70% { box-shadow: 0 0 0 8px rgba(255, 154, 106, 0); }
  100% { box-shadow: 0 0 0 0 rgba(255, 154, 106, 0); }
}

/* ---------- 11. 多人房间版：顶部对手席位铭牌 / 大厅 / 玩家详情 / 资料 ---------- */
/* 顶部对手席位条：按对手数决定卡宽，2 人局不把单卡拉满整条（否则数字被拉得很空） */
.seat-strip {
  position: absolute; left: 16px; top: 6px;
  display: flex; gap: 8px;
}
/* 三行结构：头像+昵称+号位+声望 / 五色永久折扣 / 五色筹码+黄金+预购
   高度 60px 是顶栏硬上限（下方 6px 即市场卡） */
.seat-badge {
  position: relative; flex: 0 0 200px; width: 200px; height: 64px;
  display: flex; flex-direction: column; justify-content: center; gap: 1px;
  padding: 3px 6px 3px 7px;
  border-radius: 8px; overflow: hidden;
  border: 1px solid rgba(226, 180, 102, .68);
  background: linear-gradient(155deg, #64364a 0%, #311726 60%, #1c0c16 100%);
  box-shadow:
    inset 0 1px 0 rgba(255, 242, 205, .34),
    inset 0 -3px 6px rgba(0, 0, 0, .58),
    0 6px 14px rgba(0, 0, 0, .65);
  transition: transform 140ms ease, box-shadow 140ms ease, border-color 140ms ease;
}
/* 当前行动者：边框转青 + 外发光，另有「行动中」文字，两种信号同时表达 */
.seat-badge.is-current {
  border-color: #7ce2f7;
  box-shadow:
    inset 0 1px 0 rgba(255, 242, 205, .36),
    0 0 0 1.5px rgba(124, 226, 247, .65),
    0 0 14px rgba(124, 226, 247, .3),
    0 6px 14px rgba(0, 0, 0, .68);
}
.seat-badge.is-bot { opacity: .97; }
.seat-badge.is-empty { opacity: .62; }
.seat-hover { transform: translateY(1px); }

/* 第一行：小头像 22×22 + 弱化号位 + 短昵称 + 醒目声望 */
.seat-top { display: flex; align-items: center; gap: 4px; height: 20px; flex-shrink: 0; }
.seat-avatar {
  width: 20px; height: 20px; flex-shrink: 0; border-radius: 3px;
  border: 1.5px solid #deb062; overflow: hidden;
  display: flex; align-items: center; justify-content: center;
  box-shadow: inset 0 0 0 1px rgba(255, 240, 200, .35), 0 2px 6px rgba(0, 0, 0, .65);
}
.seat-avatar-img { width: 100%; height: 100%; }
.seat-avatar-initial {
  font-family: Georgia, serif; font-size: 11px; font-weight: 700;
  color: #fff1d5; text-shadow: 0 1px 3px #1a0d14;
}
.seat-avatar-wrap { position: relative; width: 20px; height: 20px; flex-shrink: 0; }
/* 号位：改成名字前的弱化小号数字，不再压头像，避免和头像花纹抢视线 */
.seat-no {
  flex-shrink: 0;
  font-family: Georgia, serif; font-size: 9px; font-weight: 700; line-height: 1;
  color: rgba(255, 226, 186, .62);
  text-shadow: 0 1px 2px rgba(0, 0, 0, .9);
}
.seat-no.is-current { color: #9fe9f8; }
.seat-name {
  flex: 1; min-width: 0;
  font-size: 12.5px; font-weight: 700; color: #fff3d6; letter-spacing: .2px;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  text-shadow: 0 1px 3px rgba(0, 0, 0, .85);
}
/* 声望：右上角独立数字，字号最大、金底深墨，与工作台声望同一套样式 */
.seat-score {
  flex-shrink: 0; margin-left: 2px;
  min-width: 24px; height: 19px; padding: 0 5px;
  border-radius: 9px;
  border: 1px solid rgba(255, 242, 198, .92);
  background: linear-gradient(180deg, #ffdf8e, #a86c1c 72%, #7d4d0d 100%);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 2px 5px rgba(0, 0, 0, .7), inset 0 1px 0 rgba(255, 255, 255, .55);
}
.seat-score-num {
  font-family: Georgia, serif; font-size: 14px; font-weight: 700; line-height: 1;
  color: #2b1504;
}
.seat-score.is-reached {
  border-color: #fffbe8;
  box-shadow: 0 0 9px rgba(255, 220, 130, .6), 0 2px 5px rgba(0, 0, 0, .7);
}

/* 第二 / 三行：6 个 46px 等分槽位（5 色 + 黄金），五色严格同列 */
.seat-row { display: flex; align-items: center; gap: 2px; height: 18px; flex-shrink: 0; }
.seat-row-tag {
  width: 12px; flex-shrink: 0;
  font-size: 9px; line-height: 1; color: #dcc0a0; text-align: center;
  text-shadow: 0 1px 2px rgba(0, 0, 0, .9);
}
.seat-sq, .seat-coin {
  flex: 1 1 0; min-width: 0; height: 18px;
  display: flex; align-items: center; justify-content: center;
  background-size: 100% 100%; background-repeat: no-repeat;
  /* 净高 18 - 描边 3 = 15px，容得下 12px 数字，不会把「2」压扁 */
  box-sizing: border-box;
  /* 行高 18 里若被 flex 压缩，格子会矮到 15.7 装不下数字，所以锁定不缩 */
  flex-shrink: 0;
}
/* 折扣行第 6 槽：黄金没有永久折扣，但槽位必须占住，
   否则这一行只有 5 格、筹码行 6 格，等分后两行格子宽度不同（实测 28.5 vs 20.1），
   逐列偏移会从第 2 列开始累积到 33px。 */
.seat-sq.is-empty-slot {
  background: none; border: 0; box-shadow: none;
}
/* 永久折扣＝方形卡（左侧竖色条）；持有筹码＝圆形宝石 */
.seat-sq {
  position: relative; border-radius: 3px;
  background: linear-gradient(180deg, rgba(84, 46, 64, .95), rgba(26, 12, 21, .98));
  box-shadow: inset 0 0 0 1px rgba(10, 4, 8, .7), 0 1px 2px rgba(0, 0, 0, .6);
  padding-left: 3px;
}
.seat-sq::before {
  content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
  border-radius: 3px 0 0 3px;
}
.seat-sq.sq-white::before { background: linear-gradient(180deg, #fff, #a9bacd); }
.seat-sq.sq-blue::before  { background: linear-gradient(180deg, #8cc2f5, #1c4f88); }
.seat-sq.sq-green::before { background: linear-gradient(180deg, #89e3aa, #0f5030); }
.seat-sq.sq-red::before   { background: linear-gradient(180deg, #ff9aa0, #8d1f27); }
.seat-sq.sq-black::before { background: linear-gradient(180deg, #9d8b98, #241a22); }
.seat-coin {
  border-radius: 50%;
  box-shadow: inset 0 1px 2px rgba(255, 255, 255, .2), inset 0 0 0 1px rgba(10, 4, 8, .8), 0 1px 2px rgba(0, 0, 0, .6);
}
/* 筹码行底色：16px 高的圆格铺 64px 宝石图会糊成一团（而且白宝石底是浅的，
   深墨字压上去反而更糟），所以统一用「深底 + 本色描边」表达颜色，数字恒用白字。
   底色必须够深：实测浅色底（蓝 2.53 / 绿 1.92 / 红 2.91 / 金 1.29）全部不达 4.5:1，
   深底版各色都在 7:1 以上。 */
.seat-coin.gem-white,
.seat-coin.gem-blue,
.seat-coin.gem-green,
.seat-coin.gem-red,
.seat-coin.gem-black,
.seat-coin.gem-gold {
  background: linear-gradient(180deg, rgba(58, 30, 44, .97) 0%, rgba(20, 9, 16, .99) 100%);
}
/* 本色描边落在圆环上，颜色靠这圈边框识别，不靠底色明度。
   —— 圆格净高只有 14px（stage），2px 描边上下吃掉 4px 后只剩 10px，
      装不下 12px 数字会把「2」压变形；改用 1.5px。 */
.seat-coin.gem-white { border: 1.5px solid #eef4fb; }
.seat-coin.gem-blue  { border: 1.5px solid #5f9fd8; }
.seat-coin.gem-green { border: 1.5px solid #5cc487; }
.seat-coin.gem-red   { border: 1.5px solid #e0737c; }
.seat-coin.gem-black { border: 1.5px solid #8d7a86; }
.seat-coin.gem-gold  { border: 1.5px solid #ffd77e; }
.seat-sq text, .seat-coin text {
  font-family: Georgia, serif; font-size: 12px; font-weight: 700; line-height: 1;
  color: #fff;
  text-shadow: 0 1px 0 #000, 0 -1px 0 #000, 1px 0 0 #000, -1px 0 0 #000, 0 0 4px rgba(0, 0, 0, .95);
}
.seat-sq.is-wide text, .seat-coin.is-wide text { font-size: 10.5px; }
/* 筹码格统一深底 + 本色描边，数字恒为白字，因此不再需要 is-light 深墨分支。
   （历史教训：is-light 是给「浅色宝石底」准备的，但折扣方卡与筹码圆格都不是浅底，
     套上去会让深墨字压在深底上，对比度掉到 1~2，等于数字消失。已彻底移除该分支。） */
/* 零值：保留 0 并留在原位，只降底色与描边——别做得像整项坏掉 */
.seat-sq.is-zero, .seat-coin.is-zero {
  box-shadow: inset 0 0 0 1px rgba(255, 236, 200, .14);
  opacity: .58;
}
.seat-sq.is-zero text, .seat-coin.is-zero text {
  color: rgba(255, 244, 224, .72);
  text-shadow: 0 1px 2px #000;
  font-weight: 600;
}
.seat-coin.is-gold { box-shadow: inset 0 1px 2px rgba(255, 255, 255, .4), inset 0 0 0 1px rgba(90, 54, 6, .9), 0 1px 3px rgba(0, 0, 0, .6); }
/* 预购数：作为第一行的正常 flex 项（不绝对定位）。
   —— 绝对定位无论贴右下（压在筹码行第 6 格黄金上）还是贴右上（压住昵称），
      卡片内宽仅 ~186px，两行 6 格已铺满，四周没有真正的空位。
      放进流里则由昵称的 ellipsis 主动让位，不会再与任何数字重叠。
   顺序排在昵称之后、声望之前：次级信息不抢声望的视觉优先级。 */
.seat-res {
  flex-shrink: 0;
  display: flex; align-items: center; gap: 1px;
  height: 13px; padding: 0 3px; margin-left: 2px;
  border: 1px dashed rgba(255, 205, 130, .55); border-radius: 3px;
  background: rgba(255, 190, 110, .14);
}
.seat-res-tag { font-size: 8px; line-height: 1; color: #ffd9a0; }
.seat-res-num {
  font-family: Georgia, serif; font-size: 10px; font-weight: 700; line-height: 1;
  color: #ffe0ac; text-shadow: 0 1px 2px #000;
}
/* 「行动中」文字贴在卡片右上，与青色边框共同表达；不参与布局流 */
/* 「行动中」横排徽标压在卡片上沿（负 top），既不占第一行宽度、也不压任何数字；
   与青色边框共同构成「边框 + 文字」双重表达 */
.seat-turn {
  position: absolute; left: 50%; top: -6px; transform: translateX(-50%);
  height: 12px; padding: 0 4px; border-radius: 6px; white-space: nowrap;
  display: flex; align-items: center;
  font-size: 9px; font-weight: 700; line-height: 1; letter-spacing: .2px;
  color: #04222a;
  background: linear-gradient(180deg, #b6f2ff, #55c9e6);
  box-shadow: 0 1px 4px rgba(0, 0, 0, .75);
  z-index: 3;
}
/* 有徽标时给卡片顶上留出 2px 空间，避免和第一行头像贴住 */
.seat-badge.is-current { padding-top: 4px; }
/* 起始玩家：与「行动中」并排但让出位置，只有非当前行动者才显示 */
.seat-first {
  position: absolute; right: 3px; bottom: 1px;
  font-size: 7px; line-height: 1; color: rgba(168, 220, 255, .78);
  text-shadow: 0 1px 2px rgba(0, 0, 0, .9);
}

.room-btn { font-size: 15px; }
.portrait-hover { transform: translateY(2px); }

/* 房间大厅弹层 */
.lobby-dialog { width: 760px; }
.lobby-body { display: flex; flex-direction: column; gap: 12px; }
.lobby-section { display: flex; flex-direction: column; gap: 7px; }
.lobby-label { font-size: 12px; font-weight: 700; color: #f6d896; letter-spacing: 1px; }
.count-row { display: flex; gap: 8px; }
.count-btn {
  min-width: 82px; padding: 6px 14px; border-radius: 6px; text-align: center;
  font-size: 13px; color: #edd4b4; border: 1px solid rgba(214, 166, 86, .55);
  background: linear-gradient(160deg, #4f2c3d, #24121e);
  box-shadow: inset 0 1px 0 rgba(255, 240, 200, .2);
}
