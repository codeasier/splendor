/* ---------- 12. 入口界面 / 房间界面：文艺复兴皇家珠宝行会大厅 ---------- */
.board-layer {
  position: absolute; left: 0; top: 0; width: 1080px; height: 560px;
}
.screen-layer {
  position: absolute; left: 0; top: 0; width: 1080px; height: 560px;
  box-sizing: border-box; z-index: 12;
}

/* 对局大厅：深绿珠宝沙龙 + 大幅模式场景卡 + 右侧开局控制台。 */
.home-screen {
  overflow: hidden;
  color: #f2efe2;
  background: #07130f;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
}
.guild-scenery {
  position: absolute; left: 0; top: 0; width: 1080px; height: 560px;
  background-size: 100% 100%; background-repeat: no-repeat;
  filter: saturate(.58) contrast(1.05) blur(1.2px);
  transform: scale(1.02);
}
.guild-scene-shade {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0; pointer-events: none;
  background:
    linear-gradient(180deg, rgba(4, 15, 11, .24) 0%, rgba(4, 15, 11, .48) 24%, rgba(5, 17, 12, .92) 100%),
    linear-gradient(90deg, rgba(5, 15, 12, .45), transparent 38%, rgba(5, 15, 12, .62));
