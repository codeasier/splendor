/* ---------- 12. 入口界面 / 房间界面：文艺复兴皇家珠宝行会大厅 ---------- */
.board-layer {
  position: absolute; left: 0; top: 0; width: 1080px; height: 560px;
}
.screen-layer {
  position: absolute; left: 0; top: 0; width: 1080px; height: 560px;
  box-sizing: border-box; z-index: 12;
}

/* 场景式大厅：真实陈列美术 / 独立可动金框板 / 原生交互，绝不烘焙操作文字。 */
.home-screen { background: #260d16; }
.guild-scenery {
  position: absolute; left: 0; top: 0; width: 1080px; height: 560px;
  background-size: 100% 100%; background-repeat: no-repeat;
}
.guild-scene-shade {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0; pointer-events: none;
  background: linear-gradient(180deg, rgba(26, 6, 12, .08), transparent 30%, transparent 78%, rgba(16, 6, 8, .28));
  box-shadow: inset 0 0 22px rgba(24, 8, 10, .35);
}
.guild-profile {
  position: absolute; left: 13px; top: 9px; width: 260px; height: 82px;
  display: flex; align-items: center; gap: 10px; box-sizing: border-box; padding-right: 18px;
  background: linear-gradient(90deg, #28171a 0%, rgba(41, 23, 23, .98) 84%, rgba(41, 23, 23, .78) 100%);
  border-radius: 44px 7px 7px 44px; border: 1px solid rgba(246, 215, 151, .7);
  box-shadow: 0 3px 10px rgba(28, 11, 8, .5), inset 0 0 0 2px rgba(208, 159, 75, .18);
}
.guild-avatar-frame {
  width: 80px; height: 80px; flex-shrink: 0; border-radius: 50%; padding: 4px; box-sizing: border-box;
  background: linear-gradient(135deg, #fff0c2 0%, #c3903c 32%, #674013 50%, #edcf88 77%, #a87829 100%);
  box-shadow: 0 0 0 1px #fff0be, inset 0 0 0 2px #5b3414, 0 3px 8px rgba(0, 0, 0, .65);
}
.guild-avatar { width: 100%; height: 100%; border-radius: 50%; overflow: hidden; background-size: cover; background-position: center; }
.guild-avatar-img { width: 100%; height: 100%; }
.guild-player-text { display: flex; flex-direction: column; gap: 5px; min-width: 0; flex: 1; }
.guild-player-name {
  font-family: "Songti SC", "STSong", Georgia, serif; font-size: 22px; font-weight: 700;
  color: #ffe3a2; text-shadow: 0 2px 3px #20100a;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.guild-player-rank { font-size: 11px; letter-spacing: 2px; color: #d7b97f; }
.guild-brand {
  position: absolute; left: 414px; top: 3px; width: 262px; height: 117px;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  background: radial-gradient(ellipse at center, rgba(52, 8, 22, .8), rgba(52, 8, 22, .2) 60%, transparent 75%);
}
.guild-brand-gem { width: 30px; height: 25px; filter: drop-shadow(0 2px 2px #0a1d16); }
.guild-brand-title {
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", Georgia, serif;
  font-size: 46px; font-weight: 700; letter-spacing: 5px; line-height: 1.2;
  color: #ffe3a0; text-shadow: 0 2px 0 #7e4c18, 0 4px 5px #1c0809;
}
.guild-brand-sub { display: flex; align-items: center; justify-content: center; gap: 13px; margin-top: 3px; }
.guild-brand-sub text { font-family: "Songti SC", Georgia, serif; font-size: 18px; letter-spacing: 5px; color: #f6d18a; }
.guild-title-line { width: 38px; height: 1px; background: linear-gradient(90deg, transparent, #dcba71, transparent); }
/* 实时在线人数：标题正下方那一条空白带（y≈124 起，左侧身份卡底边 91、
   右侧操作面板从 x682 开始，所以这条只能落在 x≈300~660 之间）。
   与标题同一套古金色系，但刻意压低字号与亮度 —— 它是氛围信息，不该抢「快速开始」的视线。 */
.guild-online {
  position: absolute; left: 414px; top: 122px; width: 262px; height: 22px;
  display: flex; align-items: center; justify-content: center; gap: 6px;
  box-sizing: border-box;
  border-radius: 11px;
  /* 底板要压过大厅场景图：原来 .55 透明度叠在深色帷幔上几乎看不出边界，
     看起来像一行裸字浮在场景里。加深到 .78 并补一圈内描边。 */
  background: linear-gradient(180deg, rgba(46, 18, 26, .92), rgba(22, 8, 14, .88));
  border: 1px solid rgba(220, 186, 113, .45);
  box-shadow:
    inset 0 1px 0 rgba(255, 240, 200, .16),
    0 2px 6px rgba(0, 0, 0, .5);
}
/* 呼吸绿点：只有拿到真实数字才跳，未就绪时是静态暗点，避免「还在转圈」的错觉 */
.guild-online-dot {
  width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0;
  background: #4fd08a;
  box-shadow: 0 0 6px rgba(79, 208, 138, .8);
  animation: onlinePulse 2s ease-in-out infinite;
}
.guild-online.is-pending .guild-online-dot {
  background: #8a7562; box-shadow: none; animation: none;
}
@keyframes onlinePulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: .5; transform: scale(.82); }
}
.guild-online-num {
  font-family: Georgia, "Songti SC", serif;
  font-size: 15px; font-weight: 700; line-height: 1;
  color: #ffe3a0; text-shadow: 0 1px 3px rgba(0, 0, 0, .85);
  min-width: 12px; text-align: right;
}
.guild-online.is-pending .guild-online-num { color: #c9ae88; }
.guild-online-label {
  font-size: 10.5px; line-height: 1; color: #dcc39a; letter-spacing: 1px;
  text-shadow: 0 1px 2px rgba(0, 0, 0, .8);
}
.guild-panel {
  position: absolute; left: 682px; width: 384px; height: 386px; box-sizing: border-box;
  padding: 27px 24px 25px; display: flex; flex-direction: column; align-items: stretch;
  background-size: 100% 100%; background-repeat: no-repeat;
  filter: drop-shadow(0 8px 12px rgba(0, 0, 0, .42));
}
.guild-panel-title {
  font-family: "Songti SC", "STSong", Georgia, serif; font-size: 36px; font-weight: 700;
  line-height: 1.25; letter-spacing: 7px; text-align: center;
  color: #ffe6a6; text-shadow: 0 2px 1px #765323, 0 4px 5px #021d1b;
}
.guild-rule { display: flex; align-items: center; justify-content: center; height: 14px; gap: 8px; margin-top: 8px; }
.guild-rule::before, .guild-rule::after {
  content: ''; display: block; height: 1px; flex: 1;
  background: linear-gradient(90deg, transparent, #d9b66c, transparent);
}
.guild-rule text { font-size: 17px; line-height: 14px; color: #e5c67e; }
.guild-quick {
  display: flex; align-items: center; justify-content: center; gap: 15px;
  min-height: 94px; flex-shrink: 0; margin-top: 12px; padding: 10px; box-sizing: border-box;
  background-color: transparent; background-size: 100% 100%; background-repeat: no-repeat;
  filter: drop-shadow(0 4px 4px rgba(0, 0, 0, .35));
}
.guild-quick-gem { width: 42px; height: 42px; filter: drop-shadow(0 3px 2px rgba(81, 47, 8, .7)); }
.guild-quick-copy { display: flex; flex-direction: column; align-items: center; gap: 3px; }
.guild-quick-title {
  font-family: "Songti SC", "STSong", Georgia, serif; font-size: 36px; font-weight: 700;
  line-height: 1.1; letter-spacing: 3px; color: #3a1b06; text-shadow: 0 1px 0 #ffe6a5;
}
.guild-quick-sub { font-size: 11px; line-height: 14px; letter-spacing: 2px; color: #69400f; }
.guild-room-actions { display: flex; gap: 13px; margin-top: 20px; }
.guild-action {
  flex: 1; min-width: 0; height: 84px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px;
  background-color: transparent; background-size: 100% 100%; background-repeat: no-repeat;
  filter: drop-shadow(0 3px 3px rgba(0, 0, 0, .4));
}
.guild-action .guild-icon { width: 26px; height: 26px; }
.guild-action text { font-family: "Songti SC", Georgia, serif; font-size: 20px; font-weight: 700; line-height: 1.2; color: #ffe1a0; text-shadow: 0 2px 2px #270b0e; }
.guild-icon { width: 31px; height: 31px; flex-shrink: 0; background-size: 100% 100%; background-repeat: no-repeat; }
.guild-panel-foot { margin-top: auto; text-align: center; }
.guild-panel-foot > text { font-family: "Songti SC", Georgia, serif; display: block; font-size: 17px; font-weight: 600; letter-spacing: 2px; margin-top: 5px; color: #f2d899; }
.guild-panel-foot .guild-rule { margin-top: 8px; }
.guild-pressed { opacity: .85; }
.guild-nav {
  position: absolute; left: 0; right: 0; bottom: 8px; height: 49px;
  display: flex; align-items: center; border-top: 1px solid rgba(222, 184, 111, .5); border-bottom: 1px solid rgba(222, 184, 111, .35);
  background: linear-gradient(180deg, rgba(35, 22, 17, .95), rgba(13, 9, 9, .94));
  box-shadow: 0 -1px 12px rgba(19, 8, 7, .3);
}
.guild-nav-item { position: relative; flex: 1; height: 100%; display: flex; align-items: center; justify-content: center; gap: 13px; }
.guild-nav-item + .guild-nav-item::before { content: ''; position: absolute; left: 0; top: 13px; bottom: 13px; width: 1px; background: linear-gradient(180deg, transparent, #bb914e, transparent); }
.guild-nav-item text { font-family: "Songti SC", Georgia, serif; font-size: 21px; color: #f3d598; text-shadow: 0 2px 3px #000; }
.guild-nav-hover { background: rgba(240, 195, 113, .1); }
.guild-notice {
  position: absolute; left: 425px; right: 25px; bottom: 66px; padding: 5px 10px; border-radius: 5px;
  background: rgba(25, 12, 12, .88); color: #ffe4b8; font-size: 11px; line-height: 16px; text-align: center;
}

/* 战绩弹层 */
.records-dialog { width: 720px; }
.records-body { display: flex; flex-direction: column; gap: 10px; }
.records-summary { display: flex; gap: 8px; }
.records-cell {
  flex: 1; display: flex; flex-direction: column; align-items: center; gap: 1px;
  padding: 8px 4px; border-radius: 8px;
  border: 1px solid rgba(214, 166, 86, .34);
  background: rgba(20, 9, 16, .6);
}
.records-cell-value {
  font-family: Georgia, serif; font-size: 18px; font-weight: 700; line-height: 1.2;
  color: #ffebb8; text-shadow: 0 1px 4px rgba(0, 0, 0, .75);
}
.records-cell-label { font-size: 9px; color: #cfa98f; letter-spacing: 1px; }
.records-list { display: flex; flex-direction: column; gap: 5px; }
.records-row {
  display: flex; align-items: center; gap: 9px; padding: 6px 10px; border-radius: 6px;
  border: 1px solid rgba(214, 166, 86, .2);
  background: rgba(18, 8, 14, .55);
}
.records-result {
  width: 24px; height: 24px; flex-shrink: 0; border-radius: 5px;
  display: flex; align-items: center; justify-content: center;
  font-size: 11px; font-weight: 700; color: #2b1504;
  background: linear-gradient(180deg, #ffdf8e, #b47b1f);
}
.records-result.is-lose { background: linear-gradient(180deg, #8e7a6c, #4a3a30); color: #f6e6d2; }
.records-result.is-tie { background: linear-gradient(180deg, #cfd6df, #7c8794); color: #1d2126; }
.records-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.records-title { font-size: 12px; color: #f7e7d0; }
.records-sub { font-size: 9.5px; color: #b9977f; }

/* 资料弹层：账号信息 */
.profile-identity {
  display: flex; flex-direction: column; gap: 4px;
  padding: 8px 12px; border-radius: 8px;
  border: 1px dashed rgba(243, 212, 139, .34);
  background: rgba(16, 7, 12, .5);
}
.profile-id-line { display: flex; align-items: center; gap: 8px; }
.profile-id-label { font-size: 9px; color: #cfa98f; letter-spacing: 1.5px; }
.profile-id-value { font-family: Georgia, serif; font-size: 12px; letter-spacing: 1px; color: #ffe9be; }
.profile-id-tag {
  font-size: 9px; color: #261204; padding: 1px 7px; border-radius: 9px;
  background: linear-gradient(180deg, #ffeaad, #d49b3c);
}
.profile-id-since { margin-left: auto; font-size: 9px; color: #b9977f; }
.profile-id-detail { font-size: 9.5px; line-height: 1.55; color: #c9a894; }
.profile-login { display: flex; align-items: center; gap: 10px; }
.wechat-login-btn { flex-shrink: 0; margin: 0; padding: 4px 14px; line-height: 1.5; font-size: 11px; color: #fff8e9; background: #24764e; }
.wechat-login-btn[disabled] { opacity: .55; color: #d8c8b9; }
.profile-login-hint { font-size: 9px; line-height: 1.5; color: #c9a894; }
.profile-rank { font-size: 11px; font-weight: 700; color: #ffd88e; }
.profile-stats { margin-left: auto; font-size: 9.5px; color: #c9a894; }

/* 人数按钮供建房 / 人机设置弹层与房间界面共用。 */
.count-chip {
  flex: 1; min-width: 58px; padding: 7px 10px; border-radius: 6px; text-align: center;
  font-size: 12px; font-weight: 600; color: #edd4b4; white-space: nowrap;
  border: 1px solid rgba(214, 166, 86, .52);
  background: linear-gradient(180deg, #4f2b3c, #23111c);
  box-shadow: inset 0 1px 0 rgba(255, 240, 200, .2), 0 2px 5px rgba(0, 0, 0, .48);
}
.room-counts .count-chip { min-width: 50px; padding: 7px 7px; }
.count-chip.is-active {
  color: #261204; font-weight: 700; border-color: #fff0be;
  background: linear-gradient(180deg, #ffeaad 0%, #e4ae4e 55%, #b87b1e 100%);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .75), 0 0 10px rgba(243, 198, 108, .35), 0 3px 6px rgba(0, 0, 0, .55);
}
.guild-overlay { background: rgba(13, 7, 10, .72); }
.guild-dialog { width: 490px; padding: 24px 28px; border-color: #cda760; }
.guild-dialog-head { display: flex; align-items: center; justify-content: space-between; gap: 14px; }
.guild-dialog-close { width: 32px; height: 32px; line-height: 30px; text-align: center; font-size: 27px; color: #dfc292; }
.guild-config { display: flex; flex-direction: column; gap: 18px; padding: 26px 0 22px; }
.guild-config-row { display: flex; align-items: center; gap: 16px; }
.guild-config-label { flex: 0 0 64px; font-size: 13px; color: #e0c69e; }
.guild-config-options { flex: 1; min-width: 0; display: flex; gap: 8px; }
.guild-config .count-chip { min-width: 0; padding: 10px 0; }
/* 快速开始的人数选择：三张大卡，直接点即开局。
   与「对局设置」里的 count-chip 区分开——那是配置项，这是动作入口。 */
.guild-seat-pick { flex: 1; min-width: 0; display: flex; gap: 10px; }
.seat-pick {
  flex: 1 1 0; min-width: 0;
  padding: 12px 6px 10px;
  display: flex; flex-direction: column; align-items: center; gap: 2px;
  border-radius: 8px;
  border: 1px solid rgba(214, 166, 86, .55);
  background: linear-gradient(180deg, #4f2b3c, #23111c);
  box-shadow: inset 0 1px 0 rgba(255, 240, 200, .2), 0 3px 7px rgba(0, 0, 0, .5);
  transition: transform 110ms ease, box-shadow 110ms ease;
}
.seat-pick.is-active {
  border-color: #fff0be;
  background: linear-gradient(180deg, #5c3446, #2a1520);
  box-shadow: inset 0 1px 0 rgba(255, 240, 200, .3), 0 0 10px rgba(243, 198, 108, .28), 0 3px 8px rgba(0, 0, 0, .55);
}
.seat-pick:active { transform: translateY(2px); }
.seat-pick-num {
  font-family: Georgia, serif; font-size: 30px; font-weight: 700; line-height: 1;
  color: #ffe9b8; text-shadow: 0 2px 6px rgba(0, 0, 0, .9);
}
.seat-pick-label { font-size: 11px; color: #e8c8a2; line-height: 1; }
.seat-pick-desc { margin-top: 2px; font-size: 10px; color: #c9a888; line-height: 1; }
.timer-chip {
  flex: 1; min-width: 0; padding: 10px 0; border-radius: 6px; text-align: center;
  font-size: 11px; white-space: nowrap; color: #ddc7a4;
  border: 1px solid rgba(226, 190, 126, .35); background: rgba(9, 9, 13, .3);
}
.timer-chip.is-active { color: #2a1807; border-color: #f4d48d; background: linear-gradient(180deg, #ffe4a1, #c89238); }
.guild-config-note { font-size: 12px; line-height: 1.6; color: #c5a97e; }
.guild-config .guild-join-input { flex: 1; min-width: 0; width: 0; height: 43px; box-sizing: border-box; font-size: 16px; letter-spacing: 4px; }
.home-notice { font-size: 12px; line-height: 1.7; color: #ffcc99; }

/* 房间界面：皇家议事厅席位大堂 */
.room-screen {
  display: flex; flex-direction: column; gap: 12px;
  padding: 22px 38px 20px;
  background:
    radial-gradient(ellipse 70% 55% at 50% 22%, rgba(255, 218, 152, .1), transparent 70%),
    linear-gradient(170deg, rgba(26, 10, 19, .54), rgba(12, 4, 10, .82));
}
.room-top {
  display: flex; align-items: center; gap: 22px;
  padding: 10px 18px; border-radius: 12px;
  border: 1px solid rgba(226, 180, 102, .48);
  background: linear-gradient(160deg, rgba(62, 28, 43, .86), rgba(24, 10, 18, .92));
  box-shadow: inset 0 1px 0 rgba(255, 242, 205, .26), 0 8px 22px rgba(0, 0, 0, .58);
}
.room-code-block {
  display: flex; flex-direction: column; gap: 2px; flex: 0 0 auto;
  padding: 4px 16px 4px 8px;
  border-right: 1px solid rgba(243, 212, 139, .26);
}
.room-code-label { font-size: 9px; font-weight: 600; letter-spacing: 3px; color: #f0ce8e; }
.room-code-big {
  font-family: Georgia, serif; font-size: 32px; font-weight: 700; letter-spacing: 6px; line-height: 1.1;
  color: #ffedc2;
  text-shadow: 0 2px 0 #6e4514, 0 4px 14px rgba(0, 0, 0, .85);
}
.room-backend { font-size: 9px; font-weight: 600; color: #a4f0bc; letter-spacing: 1px; }
.room-status-block { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
.room-status-main { font-size: 19px; font-weight: 700; letter-spacing: 1px; color: #ffebb8; text-shadow: 0 2px 6px rgba(0, 0, 0, .8); }
.room-status-sub { font-size: 11px; line-height: 1.55; color: #dcc0ae; }
.room-leave { flex: 0 0 auto; font-size: 12px; padding: 8px 16px; }

.room-seat-row { display: flex; gap: 14px; flex: 0 0 auto; height: 248px; }
.room-seat {
  position: relative;
  flex: 1; min-width: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 7px;
  padding: 16px 12px 14px; border-radius: 12px;
  border: 1.5px solid rgba(226, 180, 102, .52);
  background:
    radial-gradient(ellipse 80% 55% at 50% 12%, rgba(255, 220, 158, .12), transparent 68%),
    linear-gradient(162deg, #582b3e 0%, #2d1421 62%, #190b13 100%);
  box-shadow:
    inset 0 0 0 1px rgba(14, 5, 11, .7),
    inset 0 0 0 3px rgba(243, 212, 139, .14),
    inset 0 1px 0 rgba(255, 242, 205, .28),
    0 12px 28px rgba(0, 0, 0, .62);
}
.room-seat.is-self {
  background:
    radial-gradient(ellipse 80% 55% at 50% 12%, rgba(255, 224, 164, .18), transparent 68%),
    linear-gradient(162deg, #68344a 0%, #341827 62%, #1d0c16 100%);
}
.room-seat.is-ready {
  border-color: rgba(132, 232, 170, .78);
  box-shadow:
    inset 0 0 0 1px rgba(14, 5, 11, .65),
    inset 0 0 0 3px rgba(132, 232, 170, .18),
    inset 0 1px 0 rgba(255, 242, 205, .3),
    0 0 20px rgba(90, 204, 140, .24),
    0 12px 28px rgba(0, 0, 0, .62);
}
.room-seat.is-empty {
  border-style: dashed;
  border-color: rgba(226, 180, 102, .45);
  background: linear-gradient(162deg, rgba(56, 26, 40, .72), rgba(22, 10, 17, .82));
  opacity: .88;
}
.room-seat.is-tappable { cursor: pointer; }
.room-seat.is-tappable:active { transform: translateY(1px); }
.room-avatar {
  width: 66px; height: 66px; flex-shrink: 0; border-radius: 50%; overflow: hidden;
  display: flex; align-items: center; justify-content: center;
  border: 2.5px solid #e6b868;
  box-shadow:
    0 0 0 2px rgba(20, 8, 15, .8),
    0 0 0 3px rgba(243, 212, 139, .35),
    inset 0 0 0 1px rgba(255, 245, 215, .4),
    0 6px 16px rgba(0, 0, 0, .7);
}
.room-avatar-img { width: 100%; height: 100%; }
.room-avatar-no { font-family: Georgia, serif; font-size: 24px; font-weight: 700; color: #fff3d6; text-shadow: 0 2px 5px #1a0d14; }
.room-avatar.is-empty {
  border-style: dashed; border-color: rgba(232, 188, 106, .68);
  background: radial-gradient(circle, rgba(64, 30, 44, .65), rgba(20, 9, 16, .78)) !important;
}
.room-avatar.is-empty .room-avatar-no { font-size: 28px; color: #f0ce8e; text-shadow: 0 0 10px rgba(243, 212, 139, .35); }
.room-seat-label { font-size: 10px; font-weight: 600; letter-spacing: 2px; color: #f0ce8e; margin-top: 2px; }
.room-seat-name {
  max-width: 100%; font-size: 15px; font-weight: 700; color: #fff3d6;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  text-shadow: 0 1px 4px rgba(0, 0, 0, .85);
}
.room-seat-state {
  margin-top: 4px; padding: 4px 13px; border-radius: 20px;
  font-size: 10px; font-weight: 600; color: #e2be9a;
  border: 1px solid rgba(214, 166, 86, .48);
  background: rgba(20, 8, 15, .55);
}
.room-seat-state.is-ok { color: #a4f0bc; border-color: rgba(132, 232, 170, .68); background: rgba(36, 96, 62, .32); }
.room-seat-state.is-pending { color: #ffd494; border-color: rgba(243, 180, 90, .65); background: rgba(110, 72, 26, .3); }
.room-seat-state.is-wait { color: #cba8b6; }
.room-seat-action {
  font-size: 10px; font-weight: 600; color: #ffebb8; padding: 4px 12px; border-radius: 20px;
  border: 1px solid rgba(243, 212, 139, .68);
  background: linear-gradient(180deg, rgba(124, 82, 30, .48), rgba(68, 42, 14, .58));
  box-shadow: inset 0 1px 0 rgba(255, 240, 200, .25), 0 2px 6px rgba(0, 0, 0, .45);
}

.room-bottom {
  display: flex; align-items: center; justify-content: space-between; gap: 18px; flex-wrap: wrap;
  padding: 8px 16px; border-radius: 10px;
  border: 1px solid rgba(226, 180, 102, .34);
  background: rgba(22, 9, 16, .62);
}
.room-invite { display: flex; align-items: center; gap: 10px; }
.room-counts { display: flex; align-items: center; gap: 8px; }
.room-counts-label { font-size: 11px; font-weight: 600; letter-spacing: 2px; color: #f0ce8e; }
.room-tip { font-size: 11px; font-weight: 600; letter-spacing: .5px; color: #e2be9a; }
.room-tip.is-ok { color: #a4f0bc; }
.room-actions { display: flex; align-items: center; justify-content: space-between; margin-top: auto; }
.room-action-note { font-size: 11px; letter-spacing: .5px; color: #d8b596; }
.room-start {
  min-width: 260px; text-align: center; box-sizing: border-box;
  font-size: 15px; font-weight: 700; letter-spacing: 3px;
  padding: 11px 24px; border-radius: 8px;
}
.setup-state { margin-top: 3px; font-size: 9px; color: #cba8b6; }
.setup-state.is-ok { color: #a4f0bc; }

/* ---------- 好友体系：大厅入口徽标 / 好友弹层 / 邀请提醒 ---------- */

/* 好友图标用字符，字号与图形图标对齐（图形图标是 22×22 的 SVG） */
.guild-icon-text {
  width: 24px; height: 24px; display: flex; align-items: center; justify-content: center;
  font-size: 22px; line-height: 1; color: #eac876;
  text-shadow: 0 2px 3px rgba(0, 0, 0, .85);
}
/* 在线好友数：压在「好友」文字右上，不占布局宽度 */
.guild-nav-badge {
  position: absolute; right: 22%; top: 6px;
  min-width: 17px; height: 17px; padding: 0 4px;
  border-radius: 9px;
  display: flex; align-items: center; justify-content: center;
  font-family: Georgia, serif; font-size: 11px; font-weight: 700; line-height: 1;
  color: #2b1504;
  background: linear-gradient(180deg, #ffe39a, #c78f2a);
  border: 1px solid rgba(255, 248, 220, .9);
  box-shadow: 0 2px 5px rgba(0, 0, 0, .6);
}

.friends-dialog { width: 620px; max-height: 470px; display: flex; flex-direction: column; }
.friends-add { display: flex; gap: 8px; margin-top: 12px; flex-shrink: 0; }
.friends-input {
  flex: 1; min-width: 0; height: 38px; padding: 0 12px;
  box-sizing: border-box;
  border-radius: 7px;
  border: 1px solid rgba(243, 212, 139, .45);
  background: rgba(18, 8, 14, .8);
  color: #ffeecd; font-size: 14px;
}
.friends-input-ph { color: rgba(220, 186, 145, .55); }
.friends-search { flex-shrink: 0; min-height: 38px; padding: 0 18px; font-size: 13px; }

/* 查找结果：头像 + 昵称 + 加为好友 */
.friends-found {
  display: flex; align-items: center; gap: 10px;
  margin-top: 8px; padding: 8px 10px; flex-shrink: 0;
  border-radius: 7px;
  border: 1px solid rgba(124, 226, 247, .45);
  background: rgba(30, 48, 56, .5);
}
.friends-found-name { flex: 1; min-width: 0; font-size: 14px; font-weight: 700; color: #fff3d6;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.friends-add-btn { flex-shrink: 0; min-height: 32px; padding: 0 14px; font-size: 12.5px; }
.friends-notice {
  display: block; margin-top: 8px; flex-shrink: 0;
  font-size: 12px; color: #ffc9a2; line-height: 1.3;
}

.friends-avatar {
  width: 34px; height: 34px; flex-shrink: 0; border-radius: 4px;
  border: 1.5px solid #8a6a3c; overflow: hidden;
  background-size: cover; background-position: center;
  display: flex; align-items: center; justify-content: center;
}
/* 在线好友头像描青边，与牌桌「行动中」同一套颜色语言 */
.friends-avatar.is-online { border-color: #7ce2f7; box-shadow: 0 0 7px rgba(124, 226, 247, .35); }
.friends-avatar-initial {
  font-family: Georgia, serif; font-size: 15px; font-weight: 700;
  color: #fff1d5; text-shadow: 0 1px 3px #1a0d14;
}

.friends-list {
  margin-top: 10px; flex: 1; min-height: 0; overflow-y: auto;
  display: flex; flex-direction: column; gap: 6px;
}
.friends-row {
  display: flex; align-items: center; gap: 10px;
  padding: 7px 9px; border-radius: 7px;
  border: 1px solid rgba(243, 212, 139, .18);
  background: linear-gradient(180deg, rgba(60, 32, 46, .55), rgba(24, 11, 18, .7));
}
.friends-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.friends-name {
  font-size: 14px; font-weight: 700; color: #fff3d6;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.friends-meta { display: flex; align-items: center; gap: 4px; }
.friends-dot { width: 6px; height: 6px; border-radius: 50%; background: #7a6754; flex-shrink: 0; }
.friends-dot.is-online { background: #4fd08a; box-shadow: 0 0 6px rgba(79, 208, 138, .8); }
.friends-status { font-size: 11px; color: #c9ae8c; line-height: 1; }
.friends-id { font-size: 11px; color: #a08c76; line-height: 1; }
.friends-invite { flex-shrink: 0; min-height: 32px; padding: 0 16px; font-size: 12.5px; }
.friends-invite-hint {
  flex-shrink: 0; font-size: 11px; color: #9d8a74; line-height: 1.2;
  max-width: 68px; text-align: right;
}
.friends-remove {
  flex-shrink: 0; min-height: 32px; padding: 0 10px; font-size: 12px;
  color: #e0a894; border-color: rgba(200, 120, 100, .45);
}
.friends-empty { padding: 22px 10px; text-align: center; font-size: 12.5px; color: #c2a68e; line-height: 1.6; }

/* 我的账号 ID：好友靠它互加，必须完整可复制 */
.friends-myid {
  display: flex; align-items: center; gap: 9px;
  margin-top: 10px; padding: 8px 10px; flex-shrink: 0;
  border-radius: 7px;
  border: 1px dashed rgba(243, 212, 139, .45);
  background: rgba(20, 8, 14, .6);
}
.friends-myid-label { font-size: 11.5px; color: #c9ae8c; flex-shrink: 0; }
.friends-myid-value {
  flex: 1; min-width: 0; font-family: Georgia, monospace; font-size: 13px;
  color: #ffe9b8; letter-spacing: .3px;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.friends-copy { flex-shrink: 0; min-height: 30px; padding: 0 12px; font-size: 12px; }

/* 邀请提醒：浮在大厅 / 房间上方，不挡主要操作 */
.invite-toast {
  /* 落在左侧「卡牌/筹码陈列区」上方：右侧操作面板从 x=682 起、底部导航从 y=503 起，
     所以提示卡只能占 x≈150~670、y≈150~330 这块真正的空白。
     放居中会压住操作面板（实测 ovPanel=true），放底部会压住导航。 */
  position: absolute; left: 150px; top: 150px;
  z-index: 26; width: 320px;
  box-sizing: border-box; padding: 10px 14px;
  border-radius: 11px;
  border: 1px solid rgba(255, 214, 130, .72);
  background: linear-gradient(180deg, rgba(92, 52, 40, .97), rgba(36, 16, 12, .97));
  box-shadow: 0 8px 22px rgba(0, 0, 0, .75), 0 0 16px rgba(243, 198, 108, .28);
  display: flex; flex-direction: column; gap: 5px;
  animation: dialogIn 180ms ease-out both;
}
/* 邀请提醒是舞台级浮层（三屏共用一份），不再区分大厅/房间偏移 */
.invite-toast-head { display: flex; align-items: center; gap: 6px; }
.invite-toast-dot {
  width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0;
  background: #ffd77e; box-shadow: 0 0 8px rgba(255, 215, 126, .9);
  animation: onlinePulse 1.6s ease-in-out infinite;
}
.invite-toast-title {
  flex: 1; min-width: 0; font-size: 14px; font-weight: 700; color: #ffe9c0;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.invite-toast-sub { font-size: 11.5px; color: #e0c4a2; line-height: 1.3; }
.invite-toast-btns { display: flex; gap: 8px; margin-top: 2px; }
.invite-toast-go { flex: 1; min-height: 34px; justify-content: center; font-size: 13.5px; }
.invite-toast-no { flex-shrink: 0; min-height: 34px; padding: 0 14px; font-size: 12.5px; }
