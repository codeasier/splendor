<!-- 璀璨宝石 · 横屏 2.5D 实体牌桌
     逻辑舞台 1080×560，按窗口等比缩放；所有数字、状态由 buildViewModel 实时驱动。
     绘制层级：桌布 → 接触投影 → 纸叠/筹码侧壁 → 卡面/筹码顶面 → 数字图标 → 选中轮廓 → 弹层。 -->
<view class="viewport theme-{{themeId}}">
  <view class="stage" style="transform:rotate({{stageRotate}}deg) scale({{stageScale}});">

    <!-- ========== 场景层：酒红绒布、柔和光斑、边缘暗化、实体木框 ========== -->
    <view class="felt"></view>
    <view class="felt-grain"></view>
    <view class="felt-light"></view>
    <view class="felt-vignette"></view>
    <view class="table-emblem"></view>
    <view class="wood-edge wood-top"></view>
    <view class="wood-edge wood-bottom"></view>
    <view class="wood-edge wood-left"></view>
    <view class="wood-edge wood-right"></view>
    <view class="corner corner-tl"></view>
    <view class="corner corner-tr"></view>
    <view class="corner corner-bl"></view>
    <view class="corner corner-br"></view>
    <view wx:if="{{themeFallback}}" class="theme-fallback"><text>当前客户端暂不支持房间主题，已使用皇家商会显示</text></view>

    <!-- ========== 牌桌图层：仅在 screen === 'game' 时渲染 ========== -->
    <view wx:if="{{screen === 'game'}}" class="board-layer">

    <!-- ========== 组件：多席位状态条 / 紧凑回合提示 / 右上入口 ==========
         顶栏高度全部让给对手卡：回合标题从 23px 大标题收成 15px 紧凑提示，
         中央只保留「行动中是谁 + 轮次 + 计时 + 上一手」四件必要信息。 -->
    <view class="top-bar">
      <view class="seat-strip" style="width:{{rivalStripWidth}}px;">
        <view wx:for="{{rivals}}" wx:key="index"
              class="seat-badge {{item.isCurrent ? 'is-current' : ''}} {{item.isBot ? 'is-bot' : ''}} {{item.empty ? 'is-empty' : ''}}"
              bindtap="onTapPlayer" data-index="{{item.index}}" hover-class="seat-hover">
          <!-- 第一行：小头像 + 短昵称 + 弱号位 + 醒目声望 -->
          <view class="seat-top">
            <view class="seat-avatar-wrap">
              <view wx:if="{{item.avatarUrl}}" class="seat-avatar {{item.autoPlay ? 'is-auto' : ''}}">
                <image class="seat-avatar-img" src="{{item.avatarUrl}}" mode="aspectFill"></image>
              </view>
              <view wx:else class="seat-avatar {{item.autoPlay ? 'is-auto' : ''}}"
                    style="background:radial-gradient(circle at 32% 24%, rgba(255,240,210,.55), {{item.avatarHue}} 52%, rgba(20,10,16,.92) 100%);">
                <text class="seat-avatar-initial">{{item.initial}}</text>
              </view>
              <!-- 托管角标：压在头像右下，一眼看出这个席位现在由 AI 代打 -->
              <view wx:if="{{item.autoPlay}}" class="auto-badge"><text>托管</text></view>
            </view>
            <text class="seat-no {{item.isCurrent ? 'is-current' : ''}}">{{item.seatNo}}</text>
            <text class="seat-name">{{item.name}}</text>
            <!-- 预购数：第一行内的正常 flex 项（不做绝对定位）。
                 绝对定位无论贴右下还是贴右上，都会压到筹码行第 6 格或昵称；
                 放进流里则自动把昵称挤窄，由昵称的 ellipsis 让位，永不重叠。 -->
            <view class="seat-res" catchtap="onTapPlayer" data-index="{{item.index}}">
              <text class="seat-res-tag">预</text>
              <text class="seat-res-num">{{item.reservedCount}}</text>
            </view>
            <view class="seat-score {{item.isCurrent ? 'is-current' : ''}} {{item.pointsReached ? 'is-reached' : ''}}">
              <text class="seat-score-num">{{item.pointsText}}</text>
            </view>
          </view>
          <!-- 第二行：五色永久折扣。第 6 槽是空占位——黄金没有永久折扣，
               但槽位必须留着，否则这一行只有 5 格、下一行 6 格，
               flex 等分会让两行的格子宽度不同，逐列就对不上了。 -->
          <view class="seat-row">
            <text class="seat-row-tag">折</text>
            <view wx:for="{{item.rows.discRow}}" wx:for-item="cell" wx:key="key"
                  class="seat-sq {{cell.sqClass}} {{cell.zero ? 'is-zero' : ''}} {{cell.wide ? 'is-wide' : ''}} {{cell.light ? 'is-light' : ''}}">
              <text>{{cell.numText}}</text>
            </view>
            <view class="seat-sq is-empty-slot"></view>
          </view>
          <!-- 第三行：五色持有筹码 + 黄金（第 6 槽），与上行严格同列 -->
          <view class="seat-row">
            <text class="seat-row-tag">筹</text>
            <view wx:for="{{item.rows.tokenRow}}" wx:for-item="cell" wx:key="key"
                  class="seat-coin {{cell.gemClass}} {{cell.zero ? 'is-zero' : ''}} {{cell.wide ? 'is-wide' : ''}} {{cell.light ? 'is-light' : ''}} {{cell.isGold ? 'is-gold' : ''}}">
              <text>{{cell.numText}}</text>
            </view>
          </view>
          <!-- 行动中：贴在卡片左外沿的竖排小旗，不占任何数字的位置 -->
          <text wx:if="{{item.turnTag}}" class="seat-turn">{{item.turnTag}}</text>
          <text wx:if="{{item.isFirst}}" class="seat-first">先</text>
        </view>
      </view>

      <view class="turn-banner {{isMyTurn ? 'is-mine' : ''}}">
        <view class="turn-line">
          <text class="turn-main {{statusLong ? 'is-long' : ''}}">{{statusText}}</text>
          <view wx:if="{{turnClock.on}}" class="turn-clock {{turnClock.urgent ? 'is-urgent' : ''}} {{isMyTurn ? 'is-mine' : ''}}">
            <text class="turn-clock-num">{{turnClock.text}}</text>
          </view>
        </view>
        <view class="turn-sub-row">
          <text class="turn-round">{{turnText}}</text>
          <text wx:if="{{netNotice}}" class="turn-sub is-net">{{netNotice}}</text>
          <text wx:elif="{{lastMove && !lastMove.sys}}" class="turn-sub is-last"><text class="turn-sub-tag">上一手</text>{{lastMove.text}}</text>
          <text wx:else class="turn-sub">{{logText}}</text>
        </view>
        <!-- 计时进度条贴在整条底边：不额外占横向空间，也不和标题抢行 -->
        <view wx:if="{{turnClock.on}}" class="turn-clock-track">
          <view class="turn-clock-fill {{turnClock.urgent ? 'is-urgent' : ''}}" style="width:{{turnClock.pct}}%;"></view>
        </view>
      </view>

      <!-- top 由胶囊避让计算（topRightOffset），真机横屏时下移到胶囊下方。
           金数量不再放这里：桌面筹码区已经展示黄金存量，顶栏重复一遍既占位
           又会把整条工具栏撑宽，遮住右侧贵族 / 牌列。
           收起态只留一个圆形手柄，默认展开；点手柄收起后只占 40px，
           不再压住牌桌内容。 -->
      <view class="top-right {{topRightCollapsed ? 'is-collapsed' : ''}}" style="top:{{topRightTop}}px;">
        <view class="round-btn top-right-toggle" bindtap="onToggleTopRight" hover-class="round-btn-hover">
          <text>{{topRightToggleLabel}}</text>
        </view>
        <!-- 这里必须用 view：WXML 的 block 标签在 H5 侧会被编译成行内元素 span，
             与外层 flex 混排会把整条工具条挤成竖排并撑高、压住右侧贵族。
             （注释里不要写出真实标签名，静态校验器按正则扫标签，会被当成未闭合标签。） -->
        <view wx:if="{{!topRightCollapsed}}" class="top-right-group">
          <!-- 退出：人机局＝放弃本局，联机局＝投降并转机器人托管。
               放在最左侧（远离胶囊），常驻可见，不再只在房间模式出现。 -->
          <view class="round-btn quit-btn" bindtap="onQuitGame" hover-class="round-btn-hover"><text>⏻</text></view>
          <view wx:if="{{roomMode}}" class="round-btn room-btn" bindtap="onOpenLobby"><text>⚑</text></view>
          <view class="round-btn" bindtap="onOpenProfile"><text>☻</text></view>
          <view class="round-btn" bindtap="onShowRules"><text>?</text></view>
          <view class="round-btn" bindtap="onRestart"><text>↺</text></view>
          <!-- 局内快捷聊天入口：面板从顶栏下方展开，不占牌桌常驻空间 -->
          <view class="round-btn chat-trigger {{chat.open ? 'is-open' : ''}}" bindtap="onToggleChatPanel" hover-class="round-btn-hover"><text>💬</text></view>
        </view>
      </view>
    </view>

    <!-- ========== 换手全屏提醒：进入 / 离开自己的回合各一次 ==========
         只在换手瞬间出现 1.7s，不占常态版面；人机局只在轮到自己时弹。 -->
    <view wx:if="{{turnFlash}}" class="turn-flash is-{{turnFlash.tone}}">
      <view class="turn-flash-veil"></view>
      <view class="turn-flash-band">
        <text class="turn-flash-seat">{{turnFlash.seatLabel}}</text>
        <text class="turn-flash-title">{{turnFlash.title}}</text>
        <text class="turn-flash-sub">{{turnFlash.sub}}</text>
      </view>
    </view>

    <!-- ========== 多贵族挑选：同时满足多张时，由该席位择一 ========== -->
    <view wx:if="{{nobleChoice && nobleChoice.mine}}" class="overlay" catchtap="noop">
      <view class="dialog noble-dialog" catchtap="noop">
        <view class="dialog-head">
          <text class="dialog-title">贵族到访 · 挑选 1 张</text>
          <text class="dialog-sub">{{nobleChoice.seatLabel}} · 你的红利同时满足 {{nobleChoice.options.length}} 张贵族，点击 1 张收入（+3 声望）</text>
        </view>
        <view class="noble-pick-row">
          <view wx:for="{{nobleChoice.options}}" wx:key="id" class="noble noble-pick"
                bindtap="onChooseNoble" data-id="{{item.id}}" hover-class="noble-pick-hover">
            <view class="noble-face"><view class="noble-photo {{item.photoClass}} {{item.artClass}}"></view></view>
            <text class="noble-points">{{item.points}}</text>
            <text class="noble-title">{{item.title}}</text>
            <view class="noble-reqs">
              <view wx:for="{{item.reqs}}" wx:for-item="req" wx:key="key"
                    class="noble-req gem-icon {{req.gemClass}}">
                <text>{{req.num}}</text>
              </view>
            </view>
          </view>
        </view>
        <text class="noble-pick-tip">限时局倒计时继续，超时将自动挑选第一张</text>
      </view>
    </view>
    <view wx:if="{{nobleChoice && nobleChoice.waiting}}" class="noble-waiting">
      <text class="noble-waiting-text">◈ {{nobleChoice.seatLabel}} · {{nobleChoice.name}} 正在挑选贵族…</text>
    </view>

    <!-- ========== 组件：本机预留区（左侧空档） ==========
         预留卡直接就位铺在桌沿，卡面与待购区完全同款；
         空位保留虚线卡槽，让 3 个预留额度始终可见。 -->
    <view class="reserved-rail">
      <view class="reserved-tag">
        <text class="reserved-tag-ch">预</text>
        <text class="reserved-tag-ch">留</text>
        <text class="reserved-tag-num">{{reservedCards.length}}/3</text>
      </view>
      <view wx:for="{{reservedCards}}" wx:key="id" class="reserved-slot"
            bindtap="onTapReservedCard" data-index="{{item.index}}" hover-class="reserved-hover">
        <view class="card {{item.buyClass}}" style="{{item.tiltStyle}}">
          <view class="card-art">
            <view class="card-photo {{item.photoClass}} {{item.artClass}}"></view>
            <view class="art-glaze"></view>
            <text class="card-name">{{item.name}}</text>
          </view>
          <text wx:if="{{item.pointsText}}" class="card-points">{{item.pointsText}}</text>
          <view class="card-gem gem-icon {{item.gemClass}}"></view>
          <view class="card-foot {{item.costDense ? 'is-dense' : ''}}">
            <view wx:for="{{item.costs}}" wx:for-item="cost" wx:key="key"
                  class="cost-bubble gem-icon {{cost.gemClass}}">
              <text style="color:{{cost.ink}}">{{cost.display}}</text>
            </view>
          </view>
        </view>
      </view>
      <view wx:for="{{emptyReservedSlots}}" wx:key="*this" class="reserved-slot"
            bindtap="onTapReservedSlot" hover-class="reserved-hover">
        <view class="reserved-empty"></view>
      </view>
    </view>

    <!-- ========== 组件：三组牌库（上 III 深蓝 / 中 II 赭金 / 下 I 深绿） ==========
         侧转 + 可见纸叠侧边 + 整叠落地投影；与市场三行严格水平对齐。 -->
    <view class="left-rail">
      <view class="rail-shadow"></view>
      <view wx:for="{{decks}}" wx:key="lv" class="deck-slot deck-lv-{{item.lv}}"
            bindtap="onTapDeck" data-lv="{{item.lv}}" hover-class="deck-hover">
        <view class="deck-stack {{item.artClass}} {{item.empty ? 'is-empty' : ''}}" style="{{item.style}}">
          <view class="deck-edges"></view>
          <view class="deck-face"></view>
          <view class="deck-sheen"></view>
          <view class="deck-crest"><text class="deck-label">{{item.label}}</text></view>
        </view>
        <view class="deck-count"><text>{{item.count}}</text></view>
      </view>
      <text class="rail-hint">点击牌库 · 盲抽预留</text>
    </view>

    <!-- ========== 组件：中央市场 3 行 × 4 列（上高级 / 下初级） ========== -->
    <view class="board">
      <view wx:for="{{rows}}" wx:for-item="row" wx:for-index="ri" wx:key="lv"
            class="card-row {{row.rowClass}}">
        <text class="row-label">{{row.label}}</text>
        <view wx:for="{{row.cards}}" wx:for-item="card" wx:for-index="ci" wx:key="id"
              class="card-slot {{card.selected ? 'is-selected' : ''}}"
              bindtap="onTapCard" data-lv="{{row.lv}}" data-index="{{ci}}" hover-class="slot-hover">
          <view wx:if="{{!card.empty}}" class="card {{card.buyClass}}" style="{{card.tiltStyle}}">
            <view class="card-art">
              <view class="card-photo {{card.photoClass}} {{card.artClass}}"></view>
              <view class="art-glaze"></view>
              <text class="card-name">{{card.name}}</text>
            </view>
            <text wx:if="{{card.pointsText}}" class="card-points">{{card.pointsText}}</text>
            <view class="card-gem gem-icon {{card.gemClass}}"></view>
            <view class="card-foot {{card.costDense ? 'is-dense' : ''}}">
              <view wx:for="{{card.costs}}" wx:for-item="cost" wx:key="key"
                    class="cost-bubble gem-icon {{cost.gemClass}}">
                <text style="color:{{cost.ink}}">{{cost.display}}</text>
              </view>
            </view>
          </view>
          <view wx:else class="card-empty" style="{{card.tiltStyle}}"></view>
        </view>
      </view>
    </view>

    <!-- ========== 组件：公共筹码堆 / 贵族肖像 ========== -->
    <view class="right-rail">
      <view class="pile-area">
        <text class="rail-title">宝石筹码 · 点击选取</text>
        <view class="pile-list">
          <view wx:for="{{bankPiles}}" wx:key="key"
                class="pile-item {{item.slotClass}} {{item.isGold ? 'is-gold' : ''}} {{item.selected ? 'is-selected' : ''}} {{item.disabled ? 'is-disabled' : ''}}"
                bindtap="onTapPile" data-key="{{item.key}}" hover-class="pile-hover">
            <view class="pile-stack">
              <view wx:for="{{item.stack}}" wx:for-item="req" wx:key="idx"
                    class="pile-disc coin-face {{item.coinClass}}" style="{{req.style}}"></view>
              <view class="pile-coin coin-face {{item.coinClass}}" style="{{item.topStyle}}">
                <view class="pile-gem gem-icon {{item.gemClass}}"></view>
              </view>
            </view>
            <view class="pile-count"><text>{{item.count}}</text></view>
            <view wx:if="{{item.showMinus}}" class="pile-minus-hit" catchtap="onRemovePile"
                  data-key="{{item.key}}" hover-class="pile-minus-hover">
              <view class="pile-minus"><text>−</text></view>
              <view wx:if="{{item.pickedMany}}" class="pile-picked"><text>×{{item.picked}}</text></view>
            </view>
            <text class="pile-name">{{item.label}}</text>
          </view>
        </view>
        <text class="pile-tip">黄金仅可通过预留获得</text>
      </view>

      <view class="noble-area {{noblesCompact ? 'is-compact' : ''}}">
        <text class="rail-title">贵族牌 · 各 3 声望</text>
        <view class="noble-row">
          <view wx:for="{{nobles}}" wx:key="id" class="noble" style="{{item.style}}">
            <view class="noble-face"><view class="noble-photo {{item.photoClass}} {{item.artClass}}"></view></view>
            <text class="noble-points">{{item.points}}</text>
            <text class="noble-title">{{item.title}}</text>
            <view class="noble-reqs">
              <view wx:for="{{item.reqs}}" wx:for-item="req" wx:key="key"
                    class="noble-req gem-icon {{req.gemClass}}">
                <text>{{req.num}}</text>
              </view>
            </view>
          </view>
          <text wx:if="{{nobles.length === 0}}" class="noble-none">贵族牌已全部获得</text>
        </view>
      </view>
    </view>

    <!-- ========== 组件：当前玩家工作台（深色皮革 + 三层金属倒角 + 柔和弧缘） ==========
         三功能区：左＝身份与声望 / 中＝资源（永久折扣 + 持有筹码）/ 右＝本次选择与确认 -->
    <view class="tray {{isMyTurn ? 'is-my-turn' : ''}}">
      <view class="tray-rim"></view>

      <!-- ① 身份区：头像 + 号位 + 声望 + 预留（预留只在这里做主要展示） -->
      <view class="tray-left">
        <view class="portrait-frame" bindtap="onTapMyPortrait" hover-class="portrait-hover">
          <view class="portrait"></view>
          <view class="portrait-seat"><text>{{meSeatLabel}}</text></view>
        </view>
        <view class="id-block">
          <text class="id-name">{{me.nameText}}</text>
          <view class="id-stats">
            <view class="id-stat id-score {{me.pointsReached ? 'is-reached' : ''}}">
              <text class="id-stat-num">{{me.pointsText}}</text>
              <text class="id-stat-label">声望</text>
            </view>
            <view class="id-stat id-reserved" bindtap="onShowReserved" hover-class="id-stat-hover">
              <text class="id-stat-num">{{me.reservedText}}</text>
              <text class="id-stat-label">预留</text>
            </view>
          </view>
        </view>
      </view>

      <!-- ② 资源区：上行永久折扣（方形卡）/ 下行持有筹码（圆形），同色逐列对齐 -->
      <view class="tray-vault">
        <view class="vault-head">
          <text class="vault-total-text">我的筹码 <text class="vault-total-num {{me.totalTokens > 10 ? 'is-over' : ''}}">{{me.tokenText}}</text></text>
        </view>
        <view class="vault-group">
          <text class="vault-label">永久折扣</text>
          <view class="vault-row vault-row-disc">
            <view wx:for="{{me.res.discount}}" wx:key="key"
                  class="vault-sq {{item.sqClass}} {{item.zero ? 'is-zero' : ''}} {{item.wide ? 'is-wide' : ''}} {{item.light ? 'is-light' : ''}}">
              <text>{{item.numText}}</text>
            </view>
            <view class="vault-gold-gap"></view>
          </view>
        </view>
        <view class="vault-group">
          <text class="vault-label">持有筹码</text>
          <view class="vault-row vault-row-token">
            <view wx:for="{{me.res.tokens}}" wx:key="key"
                  class="vault-coin gem-icon {{item.gemClass}} {{item.zero ? 'is-zero' : ''}} {{item.wide ? 'is-wide' : ''}} {{item.light ? 'is-light' : ''}} {{item.isGold ? 'is-gold' : ''}} {{needDiscard ? 'can-discard' : ''}} {{(needDiscard && item.pickedCount > 0) ? 'is-picked' : ''}}"
                  bindtap="onTapMyToken" data-key="{{item.key}}" hover-class="vault-hover">
              <text class="vault-coin-num">{{item.numText}}</text>
              <!-- 官方规则允许同色退多枚：角标显示已选枚数，「−」按钮逐枚撤回。
                   两者与「点筹码加一枚」分开，避免再点同色被误当成撤回。 -->
              <text wx:if="{{needDiscard && item.pickedCount > 0}}" class="vault-picked-badge">−{{item.pickedCount}}</text>
              <view wx:if="{{needDiscard && item.pickedCount > 0}}" class="vault-picked-minus"
                    catchtap="onRemoveDiscardPlan" data-key="{{item.key}}"><text>−</text></view>
            </view>
          </view>
        </view>
      </view>

      <!-- ③ 操作区：固定的待确认摘要 + 唯一主按钮 + 次级清除
           摘要只用「本次…」+「确认后 n/10 → m/10」两行：逐色明细已并入第一行，
           省下的高度全部给主按钮（命中外框统一 ≥46 舞台 px）。 -->
      <view class="tray-right {{isMyTurn ? '' : 'is-idle'}}">
        <view class="pick-head">
          <text class="pick-kind">{{pick.kind}}</text>
          <text wx:if="{{pick.delta > 0}}" class="pick-delta is-plus">+{{pick.delta}}</text>
          <text wx:elif="{{pick.delta < 0}}" class="pick-delta is-minus">{{pick.delta}}</text>
          <text wx:elif="{{pick.mode === 'take'}}" class="pick-delta is-idle">0</text>
        </view>
        <text class="pick-title">{{pick.title}}</text>
        <view class="pick-total">
          <text class="pick-total-label">确认后</text>
          <text class="pick-total-num">{{pick.fromText}}/10</text>
          <text class="pick-total-arrow">→</text>
          <text class="pick-total-num is-next">{{pick.toText}}/10</text>
        </view>
        <view class="pick-actions">
          <view class="btn btn-primary pick-main {{canConfirm ? '' : 'btn-off'}}" bindtap="onConfirmTake">{{isMyTurn ? pick.label : '等待其他玩家'}}</view>
          <view class="btn pick-clear {{(selectionCount > 0 || discardPlanCount > 0 || detail) ? '' : 'btn-off'}}"
                bindtap="onCancelSelection">清除</view>
          <view wx:if="{{canPass}}" class="btn pick-pass" bindtap="onPass">跳过</view>
          <!-- 托管：联机局专用。开启后不退出牌局，本席位由 AI 代打，可随时收回。 -->
          <view wx:if="{{canAutoPlay}}" class="btn auto-btn {{meAutoPlay ? 'is-on' : ''}}" bindtap="onToggleAutoPlay">
            {{meAutoPlay ? '收回' : '托管'}}
          </view>
        </view>
        <text class="pick-reason">{{isMyTurn ? (pick.reason || pick.goldLine || pickHint) : pickHint}}</text>
      </view>
    </view>

    <!-- ========== 组件：3段式桌面动作展演（取出/翻起 → 全员悬停展示 1.2s → 收入工作台/席位） ========== -->
    <view wx:for="{{showcaseList}}" wx:key="seq" class="action-showcase" style="{{item.motionStyle}}">
      <view class="showcase-backdrop"></view>
      <view class="showcase-banner">
        <text class="showcase-badge">{{item.badgeText}}</text>
        <text class="showcase-title">{{item.title}}</text>
        <text class="showcase-sub">{{item.subtitle}}</text>
      </view>

      <view wx:if="{{item.kind === 'card'}}" class="showcase-actor">
        <view class="showcase-halo"></view>
        <view class="showcase-card-row">
          <view wx:if="{{item.blindBack}}" class="deck-stack showcase-deck {{item.deckArtClass}}">
            <view class="deck-edges"></view>
            <view class="deck-face"></view>
            <view class="deck-sheen"></view>
            <view class="deck-crest"><text class="deck-label">{{item.deckLabel}}</text></view>
          </view>
          <view wx:else class="card card-showcase">
            <view class="card-art">
              <view class="card-photo {{item.card.photoClass}} {{item.card.artClass}}"></view>
              <view class="art-glaze"></view>
              <text class="card-name">{{item.card.name}}</text>
            </view>
            <text wx:if="{{item.card.pointsText}}" class="card-points">{{item.card.pointsText}}</text>
            <view class="card-gem gem-icon {{item.card.gemClass}}"></view>
            <view class="card-foot">
              <view wx:for="{{item.card.costs}}" wx:for-item="cost" wx:key="key"
                    class="cost-bubble gem-icon {{cost.gemClass}}">
                <text style="color:{{cost.ink}}">{{cost.display}}</text>
              </view>
            </view>
          </view>
          <view wx:if="{{item.gotGold}}" class="showcase-gold-bonus">
            <view class="showcase-coin coin-face coin-gold">
              <view class="showcase-coin-gem gem-icon gem-gold"></view>
            </view>
            <text class="showcase-gold-tag">+1 黄金</text>
          </view>
        </view>
      </view>

      <view wx:if="{{item.kind === 'noble'}}" class="showcase-actor">
        <view class="showcase-halo"></view>
        <view class="showcase-noble">
          <view class="noble noble-showcase">
            <view class="noble-face"><view class="noble-photo {{item.nobleVM.photoClass}} {{item.nobleVM.artClass}}"></view></view>
            <text class="noble-points">{{item.nobleVM.points}}</text>
            <text class="noble-title">{{item.nobleVM.title}}</text>
            <view class="noble-reqs">
              <view wx:for="{{item.nobleVM.reqs}}" wx:for-item="req" wx:key="key"
                    class="noble-req gem-icon {{req.gemClass}}">
                <text>{{req.num}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{item.kind === 'take'}}" class="showcase-coins">
        <view wx:for="{{item.coins}}" wx:for-item="cost" wx:key="idx"
              class="showcase-coin-item" style="{{cost.itemStyle}}">
          <view class="showcase-coin coin-face {{cost.coinClass}}">
            <view class="showcase-coin-gem gem-icon {{cost.gemClass}}"></view>
          </view>
          <text class="showcase-coin-label">{{cost.label}}</text>
        </view>
      </view>
    </view>

    <!-- ========== 局内快捷聊天：气泡 / 面板 / 大表情 ==========
         整层 pointer-events:none，只有面板本体接管点击；
         气泡与大表情永远不会拦截卡牌、筹码、确认按钮。 -->
    <view class="chat-layer" style="top:{{chatPanelTop}}px;">
      <view wx:if="{{chat.open}}" class="chat-panel" catchtap="noop">
        <view class="chat-panel-head">
          <view class="chat-tabs">
            <view class="chat-tab {{chat.isText ? 'is-active' : ''}}" bindtap="onSwitchChatTab" data-tab="text"><text>快捷语</text></view>
            <view class="chat-tab {{chat.isEmoji ? 'is-active' : ''}}" bindtap="onSwitchChatTab" data-tab="emoji"><text>表情</text></view>
          </view>
          <view class="chat-close" bindtap="onCloseChatPanel"><text>×</text></view>
        </view>
        <!-- 两个 tab 用互斥 wx:if，不用 wx:elif：H5 预览编译器不支持 elif -->
        <view wx:if="{{chat.isText}}" class="chat-grid is-text">
          <view wx:for="{{chat.texts}}" wx:key="id" class="chat-item is-text"
                bindtap="onSendQuickChat" data-kind="text" data-id="{{item.id}}"><text>{{item.text}}</text></view>
        </view>
        <!-- 表情分两步：先挑表情（isPick），再挑目标玩家（isTarget）。
             两个 wx:if 互斥，不用 wx:elif（H5 预览编译器不支持）。 -->
        <view wx:if="{{chat.isEmoji && chat.isPick}}" class="chat-grid is-emoji">
          <view wx:for="{{chat.emojis}}" wx:key="id" class="chat-item is-emoji"
                bindtap="onSendQuickChat" data-kind="emoji" data-id="{{item.id}}">
            <text class="chat-item-icon">{{item.icon}}</text>
            <text class="chat-item-label">{{item.label}}</text>
          </view>
        </view>
        <view wx:if="{{chat.isEmoji && chat.isTarget}}" class="chat-target">
          <view class="chat-pending">
            <text class="chat-pending-icon">{{chat.pending.icon}}</text>
            <text class="chat-pending-text">已选「{{chat.pending.label}}」· 选择要投给的玩家</text>
          </view>
          <view class="chat-target-grid">
            <view wx:for="{{chat.targets}}" wx:key="seat" class="chat-target-item {{item.isSelf ? 'is-self' : ''}}"
                  bindtap="onPickChatTarget" data-seat="{{item.seat}}">
              <view wx:if="{{item.avatarUrl}}" class="chat-target-avatar"><image src="{{item.avatarUrl}}" mode="aspectFill"></image></view>
              <view wx:else class="chat-target-avatar is-preset"
                    style="background:radial-gradient(circle at 32% 24%, rgba(255,240,210,.55), {{item.avatarHue}} 52%, rgba(20,10,16,.92) 100%);"><text>{{item.initial}}</text></view>
              <text class="chat-target-name">{{item.name}}</text>
              <text class="chat-target-seat">{{item.seatSub}}</text>
            </view>
          </view>
          <view class="btn chat-target-back" bindtap="onCancelChatTarget">返回选表情</view>
        </view>
        <text wx:if="{{chat.isText}}" class="chat-panel-note">仅可发送预设短语与表情，点选后立即发出</text>
        <text wx:if="{{chat.isEmoji && chat.isPick}}" class="chat-panel-note">选表情后需再选一名玩家，动画会飞到他的头像上</text>
        <text wx:if="{{chat.isEmoji && chat.isTarget}}" class="chat-panel-note">点目标头像即发送，投掷类会命中并溅开</text>
      </view>

      <view wx:if="{{!chat.open}}" class="chat-feed">
        <view wx:for="{{chat.bubbles}}" wx:key="id"
              class="chat-bubble {{item.mine ? 'is-mine' : ''}} {{item.isEmoji ? 'is-emoji' : ''}}">
          <text class="chat-bubble-seat">{{item.seatLabel}}</text>
          <text wx:if="{{item.icon}}" class="chat-bubble-icon">{{item.icon}}</text>
          <text class="chat-bubble-text">{{item.name}}：{{item.text}}</text>
          <text wx:if="{{item.targetLabel}}" class="chat-bubble-target">{{item.targetLabel}}</text>
        </view>
      </view>
    </view>

    <!-- 定向表情：从发送者头像飞到目标头像上，投掷类命中溅开、递送类亮光环。
         整层 pointer-events:none，动画期间绝不拦牌桌操作。 -->
    <view wx:for="{{chat.projectiles}}" wx:key="id" class="chat-projectile-layer">
      <view class="chat-projectile {{item.isThrow ? 'is-throw' : 'is-gift'}}" style="{{item.motionStyle}}"><text>{{item.icon}}</text></view>
      <view wx:if="{{item.isThrow}}" class="chat-splat" style="{{item.targetStyle}}"><text>啪！</text></view>
      <view wx:if="{{item.isGift}}" class="chat-gift-halo" style="{{item.targetStyle}}"><text>✨</text></view>
      <text class="chat-projectile-label" style="{{item.targetStyle}}">{{item.fromLabel}} → {{item.toLabel}} · {{item.label}}</text>
    </view>

    <!-- 旧版全屏大表情：节点保留（兼容机器人回应与旧快照），玩家主动发送已改走定向动画 -->
    <view wx:for="{{chat.flyList}}" wx:key="id" class="chat-fly">
      <view class="chat-fly-emoji"><text>{{item.icon}}</text></view>
      <text class="chat-fly-label">{{item.label}}</text>
    </view>
    </view>
    <!-- ========== /牌桌图层 ========== -->

    <!-- ========== 商会大厅：装饰场景无烘焙 UI，所有文字与操作均为原生组件 ========== -->
    <view wx:if="{{screen === 'home'}}" class="screen-layer home-screen">
      <view class="guild-scenery"></view>
      <view class="guild-scene-shade"></view>

      <view class="guild-profile" bindtap="onOpenProfile" hover-class="guild-pressed">
        <view class="guild-avatar-frame">
          <view wx:if="{{home.avatarUrl}}" class="guild-avatar">
            <image class="guild-avatar-img" src="{{home.avatarUrl}}" mode="aspectFill"></image>
          </view>
          <view wx:else class="guild-avatar guild-avatar-preset"></view>
        </view>
        <view class="guild-player-text">
          <text class="guild-player-name">{{home.nickname}}</text>
          <text class="guild-player-rank">{{home.rankTitle}}</text>
        </view>
      </view>

      <view class="guild-brand">
        <view class="guild-brand-gem gem-icon gem-green"></view>
        <text class="guild-brand-title">璀璨宝石</text>
        <view class="guild-brand-sub"><view class="guild-title-line"></view><text>商会大厅</text><view class="guild-title-line"></view></view>
      </view>

      <!-- 实时在线人数：挂在标题正下方（标题区 y3~120，此处 y≈124 起是空白带）。
           数据来自 splendor_presence 心跳表，统计近 2 分钟内有心跳的客户端。
           onlineReady=false 时显示「—」而不是 0：还没查到时不能谎报「没人在线」。 -->
      <view class="guild-online {{home.onlineReady ? 'is-ready' : 'is-pending'}}">
        <view class="guild-online-dot"></view>
        <text class="guild-online-num">{{home.onlineText}}</text>
        <text class="guild-online-label">人在线</text>
      </view>

      <view class="guild-panel" style="top:{{topRightTop > 82 ? topRightTop : 82}}px;">
        <text class="guild-panel-title">经典对局</text>
        <view class="guild-rule"><text>◇</text></view>
        <view class="guild-quick" bindtap="onQuickStart" hover-class="guild-pressed">
          <view class="guild-quick-gem gem-icon gem-white"></view>
          <view class="guild-quick-copy">
            <text class="guild-quick-title">快速开始</text>
            <text class="guild-quick-sub">人机对战 · 可选 2–4 人</text>
          </view>
        </view>
        <view class="guild-room-actions">
          <view class="guild-action" bindtap="onOpenHomeDialog" data-kind="create" hover-class="guild-pressed">
            <view class="guild-icon guild-icon-table"></view>
            <text>创建房间</text>
          </view>
          <view class="guild-action" bindtap="onOpenHomeDialog" data-kind="join" hover-class="guild-pressed">
            <view class="guild-icon guild-icon-door"></view>
            <text>加入房间</text>
          </view>
        </view>
        <view class="guild-panel-foot"><view class="guild-rule"><text>◇</text></view><text>2–4 人 · 策略对弈</text></view>
      </view>

      <text wx:if="{{home.notice && !home.dialog}}" class="guild-notice">{{home.notice}}</text>
      <view class="guild-nav">
        <view class="guild-nav-item" bindtap="onOpenFriends" hover-class="guild-nav-hover">
          <!-- 好友图标用字符而不是新烘焙一张 SVG：图标集中在 art.wxss 由构建生成，
               临时加一个图标会让「图标源」和「样式文件」两处不同步。 -->
          <view class="guild-icon guild-icon-text">⚭</view>
          <text>好友</text>
          <view wx:if="{{friendsPanel.onlineCount > 0}}" class="guild-nav-badge">{{friendsPanel.onlineCount}}</view>
        </view>
        <view class="guild-nav-item" bindtap="onOpenLeaderboard" hover-class="guild-nav-hover"><view class="guild-icon guild-icon-text">♛</view><text>天梯榜</text></view>
        <view class="guild-nav-item" bindtap="onOpenRecords" hover-class="guild-nav-hover"><view class="guild-icon guild-icon-records"></view><text>对局战绩</text></view>
        <view class="guild-nav-item" bindtap="onShowRules" hover-class="guild-nav-hover"><view class="guild-icon guild-icon-book"></view><text>游戏规则</text></view>
        <view class="guild-nav-item" bindtap="onOpenHomeDialog" data-kind="solo" hover-class="guild-nav-hover"><view class="guild-icon guild-icon-settings"></view><text>对局设置</text></view>
      </view>

      <!-- 人数、回合计时与房间号不常驻首页，只在执行相关操作时展开。 -->
      <view wx:if="{{home.dialog}}" class="overlay guild-overlay" bindtap="onCloseHomeDialog">
        <view class="dialog guild-dialog {{home.dialog === 'create' ? 'is-create' : ''}}" catchtap="noop">
          <view class="guild-dialog-head">
            <text class="dialog-title">{{home.dialog === 'solo' ? '人机对战设置' : (home.dialog === 'quick' ? '选择对局人数' : (home.dialog === 'create' ? '创建房间' : '加入房间'))}}</text>
            <view class="guild-dialog-close" bindtap="onCloseHomeDialog">×</view>
          </view>
          <view class="guild-config">
            <view wx:if="{{home.dialog === 'create'}}" class="theme-picker">
              <view class="theme-picker-head"><text class="theme-picker-label">房间主题</text><text class="theme-picker-note">房主选择 · 全桌共享</text></view>
              <view class="theme-choices">
                <view wx:for="{{home.themes}}" wx:key="id"
                      class="theme-choice {{item.active ? 'is-active' : ''}}"
                      bindtap="onSelectRoomTheme" data-id="{{item.id}}" hover-class="theme-choice-hover">
                  <view class="theme-choice-thumb theme-thumb-{{item.id}}"></view>
                  <view class="theme-choice-copy"><text class="theme-choice-tag">{{item.tag}}</text><text class="theme-choice-name">{{item.name}}</text><text class="theme-choice-desc">{{item.description}}</text></view>
                  <text wx:if="{{item.active}}" class="theme-choice-check">已选</text>
                </view>
              </view>
            </view>
            <!-- 快速开始：人数是唯一需要选的东西，点一下直接开局，不再多一次「保存」 -->
            <view wx:if="{{home.dialog === 'quick'}}" class="guild-config-row">
              <text class="guild-config-label">对局人数</text>
              <view class="guild-seat-pick">
                <view wx:for="{{home.soloCounts}}" wx:key="n"
                      class="seat-pick {{item.active ? 'is-active' : ''}}" bindtap="onPickSoloSeats" data-n="{{item.n}}">
                  <text class="seat-pick-num">{{item.n}}</text>
                  <text class="seat-pick-label">人</text>
                  <text class="seat-pick-desc">{{item.n === 2 ? '1 名对手' : (item.n === 3 ? '2 名对手' : '3 名对手')}}</text>
                </view>
              </view>
            </view>
            <view wx:if="{{home.dialog === 'solo'}}" class="guild-config-row">
              <text class="guild-config-label">对局人数</text>
              <view class="guild-config-options">
                <view wx:for="{{home.soloCounts}}" wx:key="n" class="count-chip {{item.active ? 'is-active' : ''}}"
                      bindtap="onSelectSoloCount" data-n="{{item.n}}">{{item.label}}</view>
              </view>
            </view>
            <view wx:if="{{home.dialog === 'create'}}" class="guild-config-row">
              <text class="guild-config-label">对局人数</text>
              <view class="guild-config-options">
                <view wx:for="{{home.roomCounts}}" wx:key="n" class="count-chip {{item.active ? 'is-active' : ''}}"
                      bindtap="onSelectRoomCount" data-n="{{item.n}}">{{item.label}}</view>
              </view>
            </view>
            <view wx:if="{{home.dialog === 'create'}}" class="guild-config-row">
              <text class="guild-config-label">回合计时</text>
              <view class="guild-config-options">
                <view wx:for="{{home.turnLimits}}" wx:key="value" class="timer-chip {{item.active ? 'is-active' : ''}}"
                      bindtap="onSelectTurnLimit" data-value="{{item.value}}">{{item.label}}</view>
              </view>
            </view>
            <view wx:if="{{home.dialog === 'join'}}" class="guild-config-row">
              <text class="guild-config-label">房间号</text>
              <input class="room-input guild-join-input" type="text" maxlength="6" value="{{home.joinCode}}"
                     placeholder="6 位房间号" bindinput="onJoinCodeInput"></input>
            </view>
            <text wx:if="{{home.dialog !== 'solo' && home.dialog !== 'quick' && home.cloudHint}}" class="guild-config-note">{{home.cloudHint}}</text>
            <text wx:if="{{home.notice}}" class="home-notice">{{home.notice}}</text>
          </view>
          <view class="dialog-btns">
            <view class="btn" bindtap="onCloseHomeDialog">取消</view>
            <view wx:if="{{home.dialog === 'solo'}}" class="btn btn-primary" bindtap="onSaveHomeSettings">保存设置</view>
            <view wx:if="{{home.dialog === 'create'}}" class="btn btn-primary" bindtap="onCreateRoom">创建房间</view>
            <view wx:if="{{home.dialog === 'join'}}" class="btn btn-primary" bindtap="onJoinFromHome">加入房间</view>
          </view>
        </view>
      </view>
    </view>

    <!-- ========== 房间界面：加入人数 / 准备 / 房主开始 ========== -->
    <view wx:if="{{screen === 'room'}}" class="screen-layer room-screen">
      <view class="room-top">
        <view class="room-code-block">
          <text class="room-code-label">房间号</text>
          <text class="room-code-big">{{roomScreen.code}}</text>
          <text class="room-backend">{{roomScreen.backend}}</text>
        </view>
        <view class="room-status-block">
          <text class="room-status-main">{{roomScreen.statusText}}</text>
          <text class="room-theme">主题 · {{roomScreen.themeName}} · 本房间固定</text>
          <text class="room-status-sub">回合计时 {{roomScreen.turnLimitText}} · {{roomScreen.backendHint}}</text>
        </view>
        <view class="btn room-leave" bindtap="onLeaveRoom">离开房间</view>
      </view>

      <view class="room-seat-row">
        <view wx:for="{{roomScreen.seats}}" wx:key="index"
              class="room-seat {{item.ready ? 'is-ready' : ''}} {{item.empty ? 'is-empty' : ''}} {{item.isSelf ? 'is-self' : ''}} {{item.tappable ? 'is-tappable' : ''}}"
              bindtap="onRoomSeatTap" data-index="{{item.index}}">
          <view wx:if="{{item.avatarUrl}}" class="room-avatar">
            <image class="room-avatar-img" src="{{item.avatarUrl}}" mode="aspectFill"></image>
          </view>
          <view wx:else class="room-avatar {{item.empty ? 'is-empty' : ''}}"
                style="background:radial-gradient(circle at 32% 24%, rgba(255,240,210,.55), {{item.avatarHue}} 52%, rgba(20,10,16,.92) 100%);">
            <text class="room-avatar-no">{{item.empty ? '+' : item.initial}}</text>
          </view>
          <text class="room-seat-label">{{item.label}}</text>
          <text class="room-seat-name">{{item.name}}</text>
          <view class="room-seat-state {{item.ready ? 'is-ok' : (item.empty ? 'is-wait' : 'is-pending')}}">
            <text>{{item.stateText}}</text>
          </view>
          <view wx:if="{{item.canToggleBot}}" class="room-seat-action"
                catchtap="onRoomToggleBot" data-index="{{item.index}}">{{item.seatAction}}</view>
        </view>
      </view>

      <view class="room-tip {{roomScreen.canStart ? 'is-ok' : ''}}">{{roomScreen.tip}}</view>

      <view class="room-bottom">
        <view class="room-invite">
          <button class="btn share-btn" open-type="share">分享到群</button>
          <view class="btn" bindtap="onOpenFriends">邀请好友</view>
          <view class="btn" bindtap="onCopyRoomCode">复制房间号</view>
          <text class="invite-tip">好友点分享卡片即自动入席</text>
        </view>
        <view wx:if="{{roomScreen.isHost}}" class="room-counts">
          <text class="room-counts-label">人数</text>
          <view wx:for="{{roomScreen.counts}}" wx:key="n"
                class="count-chip {{item.active ? 'is-active' : ''}}"
                bindtap="onRoomCount" data-n="{{item.n}}">{{item.label}}</view>
        </view>
        <view wx:if="{{roomScreen.isHost}}" class="room-counts">
          <text class="room-counts-label">回合计时</text>
          <view wx:for="{{roomScreen.turnLimits}}" wx:key="value"
                class="count-chip {{item.active ? 'is-active' : ''}}"
                bindtap="onRoomTurnLimit" data-value="{{item.value}}">{{item.label}}</view>
        </view>
        <text wx:if="{{roomScreen.notice}}" class="room-notice">{{roomScreen.notice}}</text>
        <text wx:if="{{roomScreen.creating}}" class="room-notice">正在保存房间与主题…</text>
        <view wx:if="{{roomScreen.createFailed}}" class="btn btn-primary" bindtap="onRetryCreateRoom">重试创建</view>
      </view>

      <view class="room-actions">
        <text class="room-action-note">{{roomScreen.isHost ? '你是房主 · 全员准备后即可开始' : '准备好后等房主开始'}}</text>
        <view wx:if="{{roomScreen.isHost}}"
              class="btn btn-primary room-start {{roomScreen.canStart ? '' : 'btn-off'}}"
              bindtap="onRoomStart">{{roomScreen.startLabel}}</view>
        <view wx:else class="btn btn-primary room-start {{roomScreen.myReady ? 'btn-off' : ''}}"
              bindtap="onRoomToggleReady">{{roomScreen.startLabel}}</view>
      </view>
    </view>

    <!-- ========== 组件：卡牌详情（选中卡放大，费用与缺口可辨） ========== -->
    <view wx:if="{{detail}}" class="overlay" bindtap="onCloseDetail">
      <view class="dialog detail-dialog" catchtap="noop">
        <view class="dialog-head">
          <text class="dialog-title">{{detail.card.name}}</text>
          <text class="dialog-sub">第 {{detail.card.level}} 级发展卡 · {{detail.card.pointsLabel}} · 产出{{detail.card.gemLabel}}红利</text>
        </view>
        <view class="detail-body">
          <view class="card card-big {{detail.card.buyClass}}">
            <view class="card-art">
              <view class="card-photo {{detail.card.photoClass}} {{detail.card.artClass}}"></view>
              <view class="art-glaze"></view>
              <text class="card-name">{{detail.card.name}}</text>
            </view>
            <text wx:if="{{detail.card.pointsText}}" class="card-points">{{detail.card.pointsText}}</text>
            <view class="card-gem gem-icon {{detail.card.gemClass}}"></view>
            <view class="card-foot">
              <view wx:for="{{detail.card.costs}}" wx:for-item="cost" wx:key="key"
                    class="cost-bubble gem-icon {{cost.gemClass}}">
                <text style="color:{{cost.ink}}">{{cost.display}}</text>
              </view>
            </view>
          </view>
          <view class="detail-info">
            <text class="detail-section">卡面成本 · 逐色实付</text>
            <view wx:for="{{detail.costLines}}" wx:key="key" class="cost-line {{item.missing ? 'is-missing' : ''}}">
              <view class="cost-line-dot gem-icon {{item.gemClass}}"></view>
              <text class="cost-line-label">{{item.label}}</text>
              <text class="cost-line-num">印刷 {{item.raw}} − 红利 {{item.discount}} = 实付 {{item.need}}</text>
            </view>
            <text class="detail-summary {{detail.canBuy ? 'ok' : 'no'}}">{{detail.summary}}</text>
            <text class="detail-note">卡面气泡恒为印刷成本；桌面上绿框＝现有筹码直接可买，金框＝缺口需用黄金补齐。买不起时仍可先预留，并获 1 枚黄金万能筹码。</text>
          </view>
        </view>
        <!-- 弹层是全屏遮罩（z-index 20），会盖住工作台右下的主按钮。
             所以「买得起」时必须把购买入口放在弹层里，否则玩家看不到任何可点的动作。
             买不起时改为次级「预留此卡」（仅桌面卡），并给出缺口原因。
             两个入口用互斥的 wx:if（不用 wx:elif：H5 预览编译器不支持，会两个都渲染）。 -->
        <view class="dialog-btns">
          <text class="dialog-action-note">{{detail.actionNote}}</text>
          <view wx:if="{{detail.canBuy && detail.canAct}}" class="btn btn-primary" bindtap="onBuyFromDetail">{{detail.buyLabel}}</view>
          <view wx:if="{{!detail.canBuy && detail.canReserve && detail.canAct}}" class="btn" bindtap="onReserveFromDetail">预留此卡</view>
          <view class="btn" bindtap="onCloseDetail">返回牌桌</view>
        </view>
      </view>
    </view>

    <!-- ========== 组件：预留卡列表 ========== -->
    <view wx:if="{{showReserved}}" class="overlay" bindtap="onCloseReserved">
      <view class="dialog reserved-dialog" catchtap="noop">
        <view class="dialog-head">
          <text class="dialog-title">我的预留卡（{{reservedCards.length}}/3）</text>
          <text class="dialog-sub">点击卡片可查看成本并购买</text>
        </view>
        <view class="reserved-list">
          <view wx:for="{{reservedCards}}" wx:key="id" class="reserved-item" bindtap="onTapReservedCard" data-index="{{item.index}}">
            <view class="card card-small {{item.buyClass}}">
              <view class="card-art">
                <view class="card-photo {{item.photoClass}} {{item.artClass}}"></view>
                <view class="art-glaze"></view>
                <text class="card-name">{{item.name}}</text>
              </view>
              <text wx:if="{{item.pointsText}}" class="card-points">{{item.pointsText}}</text>
              <view class="card-gem gem-icon {{item.gemClass}}"></view>
              <view class="card-foot">
                <view wx:for="{{item.costs}}" wx:for-item="cost" wx:key="key"
                      class="cost-bubble gem-icon {{cost.gemClass}}">
                  <text style="color:{{cost.ink}}">{{cost.display}}</text>
                </view>
              </view>
            </view>
          </view>
          <text wx:if="{{reservedCards.length === 0}}" class="empty-tip">还没有预留卡。点击桌面卡牌选择「预留此卡」，或点击左侧牌库盲抽。</text>
        </view>
        <view class="dialog-btns">
          <view class="btn" bindtap="onCloseReserved">关闭</view>
        </view>
      </view>
    </view>

    <!-- ========== 战绩：总览 + 最近对局 ========== -->
    <view wx:if="{{showRecords && records}}" class="overlay" bindtap="onCloseRecords">
      <view class="dialog records-dialog" catchtap="noop">
        <view class="dialog-head">
          <text class="dialog-title">战绩 · {{records.rankTitle}}</text>
          <text class="dialog-sub">{{records.stats.total}} 场对局 · 胜 {{records.stats.wins}} · 胜率 {{records.stats.winRate}}% · 最高 {{records.stats.best}} 声望</text>
        </view>
        <view class="records-body">
          <view class="records-summary">
            <view class="records-cell">
              <text class="records-cell-value">{{records.stats.total}}</text>
              <text class="records-cell-label">总对局</text>
            </view>
            <view class="records-cell">
              <text class="records-cell-value">{{records.stats.winRate}}%</text>
              <text class="records-cell-label">胜率</text>
            </view>
            <view class="records-cell">
              <text class="records-cell-value">{{records.stats.best}}</text>
              <text class="records-cell-label">最高声望</text>
            </view>
            <view class="records-cell">
              <text class="records-cell-value">{{records.stats.avgScore}}</text>
              <text class="records-cell-label">场均声望</text>
            </view>
            <view class="records-cell">
              <text class="records-cell-value">{{records.stats.streak}}</text>
              <text class="records-cell-label">当前连胜</text>
            </view>
          </view>
          <view class="records-list">
            <view wx:for="{{records.items}}" wx:key="id" class="records-row">
              <view class="records-result {{item.resultClass}}"><text>{{item.resultText}}</text></view>
              <view class="records-main">
                <text class="records-title">{{item.modeText}} · {{item.rankText}}</text>
                <text class="records-sub">{{item.dateText}} · {{item.scoreText}}{{item.turnsText ? ' · ' + item.turnsText : ''}}</text>
              </view>
            </view>
            <text wx:if="{{records.empty}}" class="empty-tip">还没有对局记录。开一局人机对战或房间牌局，结算后就会自动记一条。</text>
          </view>
          <text wx:if="{{records.notice}}" class="room-notice">{{records.notice}}</text>
        </view>
        <view class="dialog-btns">
          <view wx:if="{{!records.empty}}" class="btn" bindtap="onClearRecords">清空本机战绩</view>
          <view class="btn btn-primary" bindtap="onCloseRecords">关闭</view>
        </view>
      </view>
    </view>

    <!-- ========== 规则说明 ========== -->
    <view wx:if="{{showRules}}" class="overlay overlay-top" bindtap="onCloseRules">
      <view class="dialog rules-dialog" catchtap="noop">
        <view class="dialog-head">
          <text class="dialog-title">璀璨宝石 · 玩法速览</text>
          <text class="dialog-sub">{{playerCount}} 人对局 · 先达到 15 声望者胜 · 点击任意头像可查看详情</text>
        </view>
        <view class="rules-body">
          <text class="rule-item">1. 支持 2 / 3 / 4 人：首页可开「人机对战」或「邀请好友」；房间内所有真人点「准备」、房主才可开始。房间默认全是真人席位，房主点空席即可安排机器人，再点一次撤回。</text>
          <text class="rule-item">2. 每回合四选一：拿 3 枚不同色筹码（或同色 2 枚，该色需剩 ≥4）、预留 1 张卡并拿 1 枚黄金、购买 1 张桌面卡或预留卡。</text>
          <text class="rule-item">3. 卡牌左下角气泡是卡面印刷成本（原作数值，不随你的筹码变化）；每持有 1 张同色发展卡，该色实付就减 1。桌面上绿框＝现有筹码直接可买，金框＝缺口需用黄金补齐。</text>
          <text class="rule-item">4. 发展卡提供声望与永久红利；贵族牌在回合末自动判定，满足红利要求即 +3 声望。每人筹码上限 10 枚，预留卡上限 3 张。已预留的卡就铺在桌面左侧，随时可点开购买。</text>
          <text class="rule-item">5. 有人达到 15 声望后打完本轮即结算（剩余席位各行动一次）；达标者若已是最后一号位则立即结算；同分时发展卡少者胜。</text>
          <text class="rule-item">6. 断线、切后台或重进小程序会自动回到原来的房间与座位；房主结束后房间失效，自动退回首页。</text>
          <text class="rule-item">7. 房间可按 10 / 30 / 60 / 90 / 120 秒或不限时对局；超时回合由机器人强制打完并结束（含退还筹码）——自己超时本机接管，别人超时由房主在宽限 12 秒后接管。</text>
          <text class="rule-item">8. 回合末筹码超过 10 枚时，按官方规则可退还任意颜色的筹码（含黄金），同色可退多枚，只需退到 10 枚：重复点同一枚筹码即可累加，点筹码上的「−」逐枚撤回。</text>
          <text class="rule-note">牌组为官方 90 张逐张对应（一级 40 / 二级 30 / 三级 20），贵族 10 张；卡面插画取自 Cleveland Museum of Art 开放获取（CC0）绘画，牌序每局随机。</text>
        </view>
        <view class="dialog-btns">
          <view class="btn btn-primary" bindtap="onCloseRules">开始游戏</view>
        </view>
      </view>
    </view>

    <!-- ========== 终局提示：有人达到 15 声望，但本轮还没走完 ==========
         这一条必须显眼——否则玩家会在「已经结束了？」和「怎么还在打」之间困惑。 -->
    <view wx:if="{{endNotice}}" class="end-notice">
      <text class="end-notice-tag">终局</text>
      <text class="end-notice-text">{{endNotice.leaderSeat}} 号位 · {{endNotice.leaderName}} 已达 15 声望</text>
      <text class="end-notice-left">{{endNotice.leftText}}</text>
    </view>

    <!-- ========== 结算 ========== -->
    <view wx:if="{{gameOver}}" class="overlay">
      <view class="dialog result-dialog" catchtap="noop">
        <text class="result-crown">✦</text>
        <text class="result-title">{{resultTitle}}</text>
        <text class="result-detail">{{resultDetail}}</text>

        <!-- 排名表：名次 / 玩家 / 声望构成 / 发展卡与贵族 / 五色折扣 + 五色筹码 -->
        <view wx:if="{{resultBoard}}" class="rank-board">
          <view class="rank-row rank-head">
            <text class="rank-col-rank">名次</text>
            <text class="rank-col-player">玩家</text>
            <text class="rank-col-pt">声望</text>
            <text class="rank-col-detail">构成</text>
          </view>
          <view wx:for="{{resultBoard.rows}}" wx:key="seat"
                class="rank-row {{item.isWinner ? 'is-winner' : ''}} {{item.isMe ? 'is-me' : ''}}">
            <view class="rank-col-rank">
              <text class="rank-num {{item.rank === 1 ? 'is-first' : ''}}">{{item.rank}}</text>
            </view>
            <view class="rank-col-player">
              <view class="rank-avatar">
                <image wx:if="{{item.avatarUrl}}" class="rank-avatar-img" src="{{item.avatarUrl}}" mode="aspectFill"></image>
                <text wx:else class="rank-avatar-initial">{{item.initial}}</text>
              </view>
              <view class="rank-name-box">
                <view class="rank-name-line">
                  <text class="rank-name">{{item.name}}</text>
                  <text wx:if="{{item.isMe}}" class="rank-me-tag">你</text>
                  <text wx:if="{{item.autoPlay}}" class="rank-me-tag is-auto">托管</text>
                </view>
                <text class="rank-seat">{{item.seat + 1}} 号位</text>
              </view>
            </view>
            <view class="rank-col-pt">
              <text class="rank-pt">{{item.points}}</text>
            </view>
            <view class="rank-col-detail">
              <text class="rank-detail-line">发展卡 {{item.cardCount}} 张（{{item.cardPoints}} 分）· 贵族 {{item.nobleCount}} 张（{{item.noblePoints}} 分）· 筹码 {{item.totalTokens}}/10</text>
              <!-- 逐色资源：上行折扣（方）、下行筹码（圆），与牌桌同一套视觉语言 -->
              <view class="rank-res">
                <view class="rank-res-row">
                  <text class="rank-res-tag">折</text>
                  <view wx:for="{{item.disc}}" wx:for-item="cell" wx:key="key"
                        class="rank-res-sq {{cell.sqClass}} {{cell.zero ? 'is-zero' : ''}} {{cell.light ? 'is-light' : ''}}">
                    <text>{{cell.numText}}</text>
                  </view>
                </view>
                <view class="rank-res-row">
                  <text class="rank-res-tag">筹</text>
                  <view wx:for="{{item.tok}}" wx:for-item="cell" wx:key="key"
                        class="rank-res-coin gem-icon {{cell.gemClass}} {{cell.zero ? 'is-zero' : ''}} {{cell.light ? 'is-light' : ''}} {{cell.isGold ? 'is-gold' : ''}}">
                    <text>{{cell.numText}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view class="dialog-btns">
          <view class="btn btn-primary" bindtap="onRestart">再来一局</view>
          <view class="btn" bindtap="onOpenLeaderboard">查看天梯</view>
          <view wx:if="{{roomMode}}" class="btn" bindtap="onOpenLobby">房间信息</view>
          <view class="btn" bindtap="onLeaveRoom">返回首页</view>
        </view>
      </view>
    </view>

    <!-- ========== 组件：牌局中的房间信息（邀请 / 席位 / 退出） ========== -->
    <view wx:if="{{showLobby}}" class="overlay overlay-top" bindtap="onCloseLobby">
      <view class="dialog lobby-dialog" catchtap="noop">
        <view class="dialog-head">
          <text class="dialog-title">房间 · {{roomScreen.code}}</text>
          <text class="dialog-sub">{{roomScreen.statusText}} · {{roomScreen.backend}}</text>
        </view>
        <view class="lobby-body">
          <view class="lobby-section">
            <text class="lobby-label">席位</text>
            <view class="seat-setup">
              <view wx:for="{{roomScreen.seats}}" wx:key="index" class="setup-seat">
                <view class="setup-avatar"
                      style="background:radial-gradient(circle at 32% 24%, rgba(255,240,210,.55), {{item.avatarHue}} 52%, rgba(20,10,16,.92) 100%);"></view>
                <text class="setup-label">{{item.label}}</text>
                <text class="setup-name">{{item.name}}</text>
                <text class="setup-state {{item.ready ? 'is-ok' : ''}}">{{item.stateText}}</text>
              </view>
            </view>
          </view>
          <view class="lobby-section">
            <text class="lobby-label">邀请好友</text>
            <view class="invite-row">
              <text class="room-code">{{roomScreen.code}}</text>
              <button class="btn share-btn" open-type="share">分享到群</button>
              <view class="btn" bindtap="onCopyRoomCode">复制房间号</view>
              <text class="invite-tip">下一局开始前仍可邀请</text>
            </view>
            <text class="room-hint">{{roomScreen.backendHint}}</text>
          </view>
          <text wx:if="{{roomScreen.notice}}" class="room-notice">{{roomScreen.notice}}</text>
        </view>
        <view class="dialog-btns">
          <view class="btn btn-primary" bindtap="onCloseLobby">返回牌桌</view>
          <view class="btn" bindtap="onLeaveRoom">离开房间</view>
        </view>
      </view>
    </view>

    <!-- ========== 组件：玩家详情（预留 / 贵族到访 / 红利 / 筹码 / 声望） ========== -->
    <view wx:if="{{playerDetail}}" class="overlay" bindtap="onClosePlayerDetail">
      <view class="dialog player-dialog" catchtap="noop">
        <view class="dialog-head">
          <text class="dialog-title">{{playerDetail.title}}</text>
          <text class="dialog-sub">{{playerDetail.subtitle}}</text>
        </view>
        <view class="player-body">
          <view class="player-left">
            <view wx:if="{{playerDetail.avatarUrl}}" class="player-avatar">
              <image class="player-avatar-img" src="{{playerDetail.avatarUrl}}" mode="aspectFill"></image>
            </view>
            <view wx:else class="player-avatar"
                  style="background:radial-gradient(circle at 32% 24%, rgba(255,240,210,.55), {{playerDetail.avatarHue}} 52%, rgba(20,10,16,.92) 100%);"></view>
            <text class="player-score">{{playerDetail.points}} / 15 声望</text>
            <text class="player-mini">发展卡 {{playerDetail.cardCount}} · 预留 {{playerDetail.reservedCount}} · 筹码 {{playerDetail.totalTokens}}/10</text>
            <text class="detail-section">声望构成</text>
            <view wx:for="{{playerDetail.scoreLines}}" wx:key="label" class="score-line">
              <text>{{item.label}}</text><text>{{item.value}}</text>
            </view>
            <text class="detail-section">永久红利 / 持有筹码 · 逐色对齐</text>
            <view class="pd-grid">
              <view class="pd-tags"><text>红利</text><text>筹码</text></view>
              <view wx:for="{{playerDetail.columns}}" wx:for-item="cell" wx:key="key" class="pd-col">
                <view class="pd-chip gem-icon {{cell.gemClass}} {{cell.bonusShow ? '' : 'is-zero'}} {{cell.bonusWide ? 'is-wide' : ''}} {{cell.light ? 'is-light' : ''}}"><text>{{cell.bonus}}</text></view>
                <view class="pd-chip is-coin gem-icon {{cell.gemClass}} {{cell.tokenShow ? '' : 'is-zero'}} {{cell.tokenWide ? 'is-wide' : ''}} {{cell.light ? 'is-light' : ''}}"><text>{{cell.token}}</text></view>
              </view>
            </view>
          </view>
          <view class="player-right">
            <text class="detail-section">预留卡（{{playerDetail.reservedCards.length}}/3）· 气泡为卡面印刷成本</text>
            <view class="pd-cards">
              <view wx:for="{{playerDetail.reservedCards}}" wx:key="id" class="pd-card">
                <view class="card">
                  <view class="card-art">
                    <view class="card-photo {{item.photoClass}} {{item.artClass}}"></view>
                    <view class="art-glaze"></view>
                    <text class="card-name">{{item.name}}</text>
                  </view>
                  <text wx:if="{{item.pointsText}}" class="card-points">{{item.pointsText}}</text>
                  <view class="card-gem gem-icon {{item.gemClass}}"></view>
                  <view class="card-foot">
                    <view wx:for="{{item.costs}}" wx:for-item="cost" wx:key="key"
                          class="cost-bubble gem-icon {{cost.gemClass}}">
                      <text style="color:{{cost.ink}}">{{cost.display}}</text>
                    </view>
                  </view>
                </view>
                <text class="pd-card-caption">第 {{item.level}} 级 · {{item.pointsLabel}} · {{item.gemLabel}}红利</text>
              </view>
              <text wx:if="{{playerDetail.emptyReserved}}" class="empty-tip">该玩家目前没有预留卡。</text>
            </view>
            <text class="detail-section">贵族到访（{{playerDetail.nobles.length}}）</text>
            <view class="pd-list">
              <view wx:for="{{playerDetail.nobles}}" wx:key="id" class="pd-noble">
                <text class="pd-noble-title">{{item.title}}</text>
                <text class="pd-noble-points">+{{item.points}}</text>
                <view class="pd-noble-reqs">
                  <view wx:for="{{item.reqs}}" wx:for-item="req" wx:key="key" class="noble-req gem-icon {{req.gemClass}}"><text>{{req.num}}</text></view>
                </view>
              </view>
              <text wx:if="{{playerDetail.emptyNobles}}" class="empty-tip">尚无贵族到访。</text>
            </view>
          </view>
        </view>
        <view class="dialog-btns">
          <view class="btn" bindtap="onClosePlayerDetail">关闭</view>
        </view>
      </view>
    </view>

    <!-- ========== 组件：玩家资料（合规的头像昵称填写） ========== -->
    <view wx:if="{{showProfile}}" class="overlay" bindtap="onCloseProfile">
      <view class="dialog profile-dialog" catchtap="noop">
        <view class="dialog-head">
          <text class="dialog-title">玩家资料</text>
          <text class="dialog-sub">登录仅确认身份；头像与昵称由你主动选择、填写，一次保存后全局复用</text>
        </view>
        <view class="profile-body">
          <view class="profile-current">
            <view wx:if="{{profileDialog.avatarUrl}}" class="profile-avatar"><image class="profile-avatar-img" src="{{profileDialog.avatarUrl}}" mode="aspectFill"></image></view>
            <view wx:else class="profile-avatar profile-avatar-preset"></view>
            <view class="profile-current-text">
              <text class="profile-nickname">{{profileDialog.nickname}}</text>
              <text class="profile-avatar-name">当前头像：{{profileDialog.avatarName}}</text>
            </view>
          </view>
          <view class="profile-identity">
            <view class="profile-id-line">
              <text class="profile-id-label">账号</text>
              <text class="profile-id-value">{{profileDialog.playerId}}</text>
              <text class="profile-id-tag">{{profileDialog.identityLabel}}</text>
              <text class="profile-id-since">加入于 {{profileDialog.sinceText}}</text>
            </view>
            <text class="profile-id-detail">{{profileDialog.identityDetail}}</text>
            <view wx:if="{{profileDialog.showLogin}}" class="profile-login">
              <button class="btn wechat-login-btn" bindtap="onWechatLogin"
                      disabled="{{!profileDialog.canLogin}}">{{profileDialog.loginLabel}}</button>
              <text wx:if="{{profileDialog.loginHint}}" class="profile-login-hint">{{profileDialog.loginHint}}</text>
            </view>
            <view class="profile-id-line">
              <text class="profile-id-label">称号</text>
              <text class="profile-rank">{{profileDialog.rankTitle}}</text>
              <text class="profile-stats">{{profileDialog.statsLine}}</text>
            </view>
          </view>
          <text class="detail-section">昵称</text>
          <view class="profile-input-row">
            <input class="profile-input" type="nickname" maxlength="12" value="{{profileDialog.nickname}}"
                   placeholder="输入或选择微信昵称" bindinput="onNicknameInput"></input>
            <button wx:if="{{canUseNativeAvatar}}" class="native-avatar-btn" open-type="chooseAvatar"
                    bindchooseavatar="onChooseAvatar">使用微信头像</button>
          </view>
          <view class="preset-nicknames">
            <view wx:for="{{profileDialog.nicknames}}" wx:key="*this" class="preset-nick"
                  bindtap="onPickNickname" data-name="{{item}}">{{item}}</view>
          </view>
          <text class="detail-section">预设头像</text>
          <view class="preset-avatars">
            <view wx:for="{{profileDialog.avatars}}" wx:key="key"
                  class="preset-avatar {{item.active ? 'is-active' : ''}}"
                  style="background:radial-gradient(circle at 32% 24%, rgba(255,240,210,.55), {{item.hue}} 52%, rgba(20,10,16,.92) 100%);"
                  bindtap="onPickAvatar" data-key="{{item.key}}"><text>{{item.name}}</text></view>
          </view>
          <text wx:if="{{profileDialog.notice}}" class="room-notice">{{profileDialog.notice}}</text>
          <text class="profile-note">小程序无法自动读取微信头像昵称，需由你主动填写；正式发布前请在小程序后台配置《用户隐私保护指引》。</text>
        </view>
        <view class="dialog-btns">
          <view class="btn btn-primary" bindtap="onSaveProfile">保存资料</view>
          <view wx:if="{{screen !== 'game'}}" class="btn" bindtap="onOpenRecords">查看战绩</view>
          <view class="btn" bindtap="onCloseProfile">取消</view>
        </view>
      </view>
    </view>

  <!-- 好友弹层：全局层，大厅 / 房间 / 牌桌都能打开。
       不做成 screen 分支内的节点 —— 三处各放一份必然漏改其中一处（本轮已经踩到）。 -->
  <view wx:if="{{showFriends}}" class="overlay overlay-top" bindtap="onCloseFriends">
    <view class="dialog friends-dialog" catchtap="noop">
      <view class="dialog-head">
        <text class="dialog-title">好友</text>
        <text class="dialog-sub">{{friendsPanel.count}} 位好友 · {{friendsPanel.onlineCount}} 人在线</text>
      </view>

      <!-- 加好友：按账号 ID 精确查找，不做模糊搜索 -->
      <view class="friends-add">
        <input class="friends-input" value="{{friendsPanel.query}}" placeholder="输入好友的账号 ID"
               placeholder-class="friends-input-ph" bindinput="onFriendQueryInput" />
        <view class="btn friends-search" bindtap="onSearchFriend">查找</view>
      </view>

      <view wx:if="{{friendsPanel.found}}" class="friends-found">
        <view class="friends-avatar" style="{{friendsPanel.found.avatarStyle}}">
          <text wx:if="{{!friendsPanel.found.avatarUrl}}" class="friends-avatar-initial">{{friendsPanel.found.initial}}</text>
        </view>
        <text class="friends-found-name">{{friendsPanel.found.nickname}}</text>
        <view class="btn btn-primary friends-add-btn" bindtap="onAddFriend">加为好友</view>
      </view>

      <text wx:if="{{friendsPanel.notice}}" class="friends-notice">{{friendsPanel.notice}}</text>

      <view class="friends-list">
        <view wx:for="{{friendsPanel.list}}" wx:key="uid" class="friends-row">
          <view class="friends-avatar {{item.online ? 'is-online' : ''}}" style="{{item.avatarStyle}}">
            <text wx:if="{{!item.avatarUrl}}" class="friends-avatar-initial">{{item.initial}}</text>
          </view>
          <view class="friends-info">
            <text class="friends-name">{{item.nickname}}</text>
            <view class="friends-meta">
              <view class="friends-dot {{item.online ? 'is-online' : ''}}"></view>
              <text class="friends-status">{{item.statusText}}</text>
              <text class="friends-id">· ID {{item.shortId}}</text>
            </view>
          </view>
          <!-- 邀请：房间里且对方在线才给按钮；否则用文字说明原因，不摆灰按钮 -->
          <view wx:if="{{item.canInvite}}" class="btn btn-primary friends-invite" bindtap="onInviteFriend" data-uid="{{item.uid}}">邀请</view>
          <text wx:if="{{!item.canInvite && !friendsPanel.canInvite}}" class="friends-invite-hint">房间里可邀请</text>
          <text wx:if="{{!item.canInvite && friendsPanel.canInvite}}" class="friends-invite-hint">离线</text>
          <view class="btn friends-remove" bindtap="onRemoveFriend" data-uid="{{item.uid}}">删</view>
        </view>
        <view wx:if="{{friendsPanel.empty}}" class="friends-empty">
          <text wx:if="{{!friendsPanel.ready}}">正在加载好友…</text>
          <text wx:if="{{friendsPanel.ready}}">还没有好友。把下面这串 ID 发给朋友，让他输入后互加。</text>
        </view>
      </view>

      <!-- 自己的账号 ID：好友靠它互加，必须完整可复制 -->
      <view class="friends-myid">
        <text class="friends-myid-label">我的账号 ID</text>
        <text class="friends-myid-value">{{friendsPanel.myId}}</text>
        <view class="btn friends-copy" bindtap="onCopyMyId">复制</view>
      </view>

      <view class="dialog-btns">
        <view class="btn btn-primary" bindtap="onCloseFriends">关闭</view>
      </view>
    </view>
  </view>

  <!-- 邀请提醒：舞台级浮层，大厅 / 房间 / 牌桌三屏都可见。
       曾把这份写在 home-screen 里，进牌桌就收不到提醒；写成两份又必然漏改一处。
       位置固定，不随屏幕切换，占的是左侧陈列区的空白。 -->
  <view wx:if="{{invitePop}}" class="invite-toast" catchtap="noop">
    <view class="invite-toast-head">
      <view class="invite-toast-dot"></view>
      <text class="invite-toast-title">{{invitePop.fromName}} 邀请你联机</text>
    </view>
    <text class="invite-toast-sub">房间号 {{invitePop.roomCode}} · {{invitePop.moreText}}</text>
    <view class="invite-toast-btns">
      <view class="btn btn-primary invite-toast-go" bindtap="onAcceptInvite">加入</view>
      <view class="btn invite-toast-no" bindtap="onDeclineInvite">忽略</view>
    </view>
  </view>

  <!-- ========== 天梯榜：舞台级全局弹层，大厅 / 房间 / 牌桌 / 结算都能打开 ==========
       六项指标全部由 utils/leaderboard.js 预先格式化，WXML 不做算术也不拼字符串。 -->
  <view wx:if="{{showLeaderboard && leaderboard}}" class="overlay" bindtap="onCloseLeaderboard">
    <view class="dialog leaderboard-dialog" catchtap="noop">
      <view class="dialog-head">
        <text class="dialog-title">天梯榜</text>
        <text class="dialog-sub">胜场 · 最高胜场声望 · 场均声望 · 场均发展卡 · 场均贵族 · 回合平均耗时，综合评分排名</text>
      </view>
      <view class="leaderboard-body">
        <view class="leaderboard-meta">
          <text class="leaderboard-source">{{leaderboard.sourceLine}}</text>
          <!-- 未登录与云不可用是两件事：前者登录即可看到全站，后者只能排查环境。
               这里给出可操作入口，避免用户误以为是网络故障。 -->
          <view wx:if="{{leaderboard.showLoginHint}}" class="leaderboard-login-hint" bindtap="onOpenProfile" hover-class="lb-hint-hover">
            <text class="lb-hint-text">当前仅显示你本机的战绩。登录微信后可查看全站排名与他人成绩。</text>
            <text class="lb-hint-btn">去登录</text>
          </view>
          <text wx:if="{{leaderboard.hasMe}}" class="leaderboard-my">我的排名 {{leaderboard.myRankText}}</text>
          <text wx:if="{{leaderboard.provisional}}" class="leaderboard-provisional">{{leaderboard.needText}}</text>
        </view>
        <view class="leaderboard-table-wrap">
        <view class="leaderboard-table">
          <view class="leaderboard-row is-head">
            <text class="lb-c-rank">名次</text>
            <text class="lb-c-name">玩家</text>
            <text class="lb-c-num">综合分</text>
            <text class="lb-c-num">胜场</text>
            <text class="lb-c-num">最高胜场声望</text>
            <text class="lb-c-num">场均声望</text>
            <text class="lb-c-num">场均发展卡</text>
            <text class="lb-c-num">场均贵族</text>
            <text class="lb-c-num">回合平均耗时</text>
          </view>
          <view wx:for="{{leaderboard.rows}}" wx:key="uid" class="leaderboard-row {{item.isMe ? 'is-me' : ''}} {{item.isChampion ? 'is-champion' : ''}} {{item.section === 'trial' ? 'is-trial' : ''}}">
            <!-- 分组标题：正式榜 / 观察期各自独立编号，必须显式标出分界，
                 否则用户会把观察期第 1 误读成全站第 1。 -->
            <view wx:if="{{item.sectionHead}}" class="lb-section-head is-{{item.section}}">
              <text class="lb-section-title">{{item.sectionHead}}</text>
              <text class="lb-section-sub">{{item.sectionSub}}</text>
            </view>
            <view class="lb-row-inner {{item.sectionHead ? 'has-section' : ''}}">
            <view class="lb-c-rank {{item.isChampion ? 'is-champion' : ''}}">
              <view wx:if="{{item.isChampion}}" class="lb-c-rank-medal"></view>
              <text class="lb-c-rank-num {{item.isChampion ? 'is-champion' : ''}}">{{item.rankText}}</text>
            </view>
            <view class="lb-c-name">
              <!-- 冠军头像框：金冠 + 双环 + 流光。结构与普通头像框分开，
                   避免给非冠军行增加无用的嵌套节点。 -->
              <!-- 用互斥 wx:if，不用 elif/else 链：本项目已多次踩到
                   WXML 的 wx:elif / wx:else 在部分编译路径下不互斥，
                   冠军行会同时渲染出专属框和一个多余的空头像圈。 -->
              <view wx:if="{{item.isChampion}}" class="lb-avatar-crown">
                <view class="lb-crown-glow"></view>
                <view class="lb-avatar is-champion">
                  <image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill"></image>
                  <text wx:if="{{!item.avatarUrl}}">{{item.initial}}</text>
                </view>
                <view class="lb-crown"><text>♛</text><view class="lb-crown-gem"></view></view>
              </view>
              <view wx:if="{{!item.isChampion && item.avatarUrl}}" class="lb-avatar"><image src="{{item.avatarUrl}}" mode="aspectFill"></image></view>
              <view wx:if="{{!item.isChampion && !item.avatarUrl}}" class="lb-avatar is-preset"><text>{{item.initial}}</text></view>
              <text class="lb-name {{item.isChampion ? 'is-champion' : ''}}">{{item.name}}</text>
              <text wx:if="{{item.isChampion}}" class="lb-champion">榜首</text>
              <text wx:if="{{item.isMe}}" class="lb-me">你</text>
              <text wx:if="{{item.provisional}}" class="lb-provisional">观察期</text>
            </view>
            <text class="lb-c-num is-score">{{item.ratingText}}</text>
            <text class="lb-c-num">{{item.winsText}}</text>
            <text class="lb-c-num">{{item.bestWinText}}</text>
            <text class="lb-c-num">{{item.avgScoreText}}</text>
            <text class="lb-c-num">{{item.avgCardsText}}</text>
            <text class="lb-c-num">{{item.avgNoblesText}}</text>
            <text class="lb-c-num">{{item.avgTurnText}}</text>
            </view>
          </view>
          <view wx:if="{{leaderboard.empty}}" class="leaderboard-empty">
            <text>还没有榜单数据。打完一局并结算后，这里会出现你的成绩。</text>
          </view>
        </view>
        </view>
        <!-- 只在确实有滚动余量时提示。必须放在 wrap 外面：
             放里面时它参与 wrap 的高度分配，会压到公式文字上。 -->
        <view wx:if="{{leaderboard.scrollable}}" class="leaderboard-scroll-hint"><text>▼ 榜单可下滑查看更多</text></view>
        <text class="leaderboard-formula">{{leaderboard.formulaText}}</text>
        <!-- 准入规则必须写在界面上：否则打了人机局的玩家看到「还差 3 局」
             会以为成绩没记上，实际是这类对局本就不进榜。 -->
        <text class="leaderboard-rule">入榜条件：仅统计联机对局，且该局真人玩家不少于 2 人；人机对战与单人对局不计入。</text>
        <text class="leaderboard-note">仅使用你主动填写的昵称、头像与对局结果；云端未连接时只展示本机战绩。平台规则以微信官方最新审核规范为准。</text>
      </view>
      <view class="dialog-btns">
        <view class="btn btn-primary" bindtap="onCloseLeaderboard">关闭</view>
      </view>
    </view>
  </view>
  </view>
</view>
