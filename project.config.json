{
  "description": "璀璨宝石桌游小程序（原生 + 云端房间联机）",
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": ".workbuddy"
      },
      {
        "type": "folder",
        "value": "preview"
      },
      {
        "type": "folder",
        "value": "tests"
      },
      {
        "type": "folder",
        "value": "assets"
      },
      {
        "type": "prefix",
        "value": "assets/"
      },
      {
        "type": "regexp",
        "value": "^assets/.*\\.(png|jpe?g|webp|pdf)$"
      },
      {
        "type": "file",
        "value": "index.html"
      },
      {
        "type": "folder",
        "value": "node_modules"
      },
      {
        "type": "folder",
        "value": ".agents"
      },
      {
        "type": "folder",
        "value": "docs"
      },
      {
        "type": "file",
        "value": "package.json"
      },
      {
        "type": "file",
        "value": "package-lock.json"
      }
    ],
    "include": []
  },
  "setting": {
    "bundle": false,
    "es6": true,
    "minified": true,
    "postcss": true,
    "urlCheck": true
  },
  "compileType": "miniprogram",
  "appid": "touristappid",
  "projectname": "splendor",
  "miniprogramRoot": "./"
}
